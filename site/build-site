            continue
        intro.append(b)
    tagline, intro = intro[0], intro[1:]

    modelled = readme.table("What is modelled", "Block")
    prebuilt = readme.table("Prebuilt binaries", "Platform")
    needs = readme.para("Prebuilt binaries", "They need nothing installed")
