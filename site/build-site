    rows = {}
    for r in prebuilt.rows:
        for p in re.findall(r"`([^`]+)`", r[0]):
            rows[p] = r
    by = {d["platform"]: d for d in dls}

    cards = []
    for d in dls:
        r = rows[d["platform"]]
        size = " &middot; %s" % mib(d["size"]) if d["size"] else ""
        cant = ('<p class="cant"><strong>Can&rsquo;t:</strong> %s</p>' % inline(r[2])) if r[2] else ""
        cards.append("""<article class="card" aria-labelledby="dl-{p}">
