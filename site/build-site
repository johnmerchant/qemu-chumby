<p class="sha"><span class="k">SHA-256</span> <code>{sha}</code></p>
</article>""".format(p=esc(d["platform"]), label=esc(LABELS.get(d["platform"], d["platform"])),
                     what=inline(r[1]), cant=cant, url=esc(d["url"]), sha_url=esc(d["sha256_url"]),
                     sha=esc(d["sha256"]), size=size))

    linux = by.get("linux-x86_64") or dls[0]
