    ])
    running = readme.section("Running")

    quick = [
        ("qs-chumby-app", "Chumby.app", "macOS",
         md(readme.take("The Mac app: Chumby.app", "On macOS there is a native app", codes=2), 2),
         "the-mac-app-chumbyapp"),
        ("qs-chumby-desktop", "chumby-desktop", "Linux",
         md([readme.section("The Linux app: chumby-desktop")[0]]
            + readme.take("The Linux app: chumby-desktop", "It needs Qt", codes=1), 2),
         "the-linux-app-chumby-desktop"),
        ("qs-chumby-machine", "chumby-machine", "scripts and tests",
         md(readme.take("Scripts and tests: chumby-machine", "`chumby-machine` runs", codes=1), 2)
         + '\n<details><summary>All its commands</summary>\n%s\n</details>'
         % md([readme.table("Scripts and tests: chumby-machine", "Command")], 2),
         "scripts-and-tests-chumby-machine"),
    ]
    qs_html = "\n".join("""<article class="qs" aria-labelledby="{id}">
<h3 id="{id}">{name} <span class="plat">{for_}</span></h3>
{body}
<p class="more"><a href="{repo}#{anchor}">More in the README<span class="vh"> about {name}</span></a></p>
</article>""".format(id=i, name=esc(n), for_=esc(f), body=b, repo=REPO, anchor=a) for i, n, f, b, a in quick)

    nav = "\n".join('<li><a href="#%s">%s</a></li>' % (i, esc(t)) for i, t in sections)
