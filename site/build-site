class Error(Exception):
    pass


def esc(s):
    return html.escape(s, quote=True)


def slug(text):
    """GitHub's anchor for a heading."""
    text = re.sub(r"<[^>]+>", "", text).strip().lower()
    text = re.sub(r"[^\w\- ]", "", text)
    return text.replace(" ", "-")


# Markdown, as README.md writes it.

class Block:
    def __init__(self, kind, **kw):
        self.kind = kind
        self.__dict__.update(kw)


def md_blocks(text):
    lines = text.split("\n")
    blocks = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip():
            i += 1
        elif line.startswith("#"):
            m = re.match(r"(#{1,6}) (.+)$", line)
            if not m:
                raise Error("README.md:%d: a heading?" % (i + 1))
            blocks.append(Block("heading", level=len(m.group(1)), text=m.group(2)))
            i += 1
        elif line.startswith("    "):
            code = []
            while i < len(lines) and (lines[i].startswith("    ") or not lines[i].strip()):
                code.append(lines[i][4:])
                i += 1
            while code and not code[-1].strip():
                code.pop()
            blocks.append(Block("code", text="\n".join(code)))
        elif line.startswith("|"):
            rows = []
            while i < len(lines) and lines[i].startswith("|"):
                rows.append(lines[i])
                i += 1
            if len(rows) < 2 or not re.fullmatch(r"\|(\s*-+\s*\|)+", rows[1]):
                raise Error("README.md:%d: a table without a header" % (i + 1))
            cells = [md_cells(r) for r in rows]
            blocks.append(Block("table", head=cells[0], rows=cells[2:]))
        elif line.startswith("- "):
            items = []
            while i < len(lines) and lines[i].strip():
                if lines[i].startswith("- "):
                    items.append(lines[i][2:])
                elif lines[i].startswith("  "):
                    items[-1] += " " + lines[i].strip()
                else:
                    raise Error("README.md:%d: a list item?" % (i + 1))
                i += 1
            blocks.append(Block("list", items=items))
        elif re.match(r"(\d+\.|[*+>]) |```|<|\t", line):
            raise Error("README.md:%d: Markdown this script doesn't know: %r" % (i + 1, line))
        else:
            para = []
            while i < len(lines) and lines[i].strip() and not re.match(r"[#|]|- |    ", lines[i]):
                para.append(lines[i].strip())
                i += 1
            blocks.append(Block("para", text=" ".join(para)))
    return blocks


def md_cells(row):
    row = row.strip()
    assert row.startswith("|") and row.endswith("|")
    cells = re.split(r"(?<!\\)\|", row[1:-1])
    return [c.strip().replace("\\|", "|") for c in cells]


class Links:
    """Where the README's links go on the page: its own anchors that the
    page has stay there, the others go to the README on GitHub, and
    relative paths to the files at COMMIT."""

    def __init__(self, commit):
        self.commit = commit
        self.ids = set()

    def href(self, url):
        if url.startswith("#"):
            return url if url[1:] in self.ids else REPO + "#" + url[1:]
        if re.match(r"[a-z]+:", url):
            return url
        return "%s/blob/%s/%s" % (REPO, self.commit, url)


def md_inline(text, links):
    codes = []

    def code(m):
        codes.append("<code>%s</code>" % esc(m.group(1)))
        return "\0%d\0" % (len(codes) - 1)

    text = re.sub(r"`([^`]+)`", code, text)
    if "`" in text or "![" in text:
        raise Error("README.md: inline Markdown this script doesn't know: %r" % text)
    text = esc(text)
    text = re.sub(r"\[([^\]]+)\]\(([^)\s]+)\)",
                  lambda m: '<a href="%s">%s</a>' % (esc(links.href(html.unescape(m.group(2)))), m.group(1)), text)
    text = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", text)
    if re.search(r"\*\S|\S\*|\[[^\]]*\]\(", text):
        raise Error("README.md: inline Markdown this script doesn't know: %r" % text)
    return re.sub(r"\0(\d+)\0", lambda m: codes[int(m.group(1))], text)


def table_html(head, rows, inline, caption=None):
    out = ['<div class="table" role="region" tabindex="0"%s>' % (' aria-label="%s"' % esc(caption) if caption else "")]
    out.append("<table>")
    if caption:
        out.append('<caption class="vh">%s</caption>' % esc(caption))
    out.append("<thead><tr>%s</tr></thead>" % "".join('<th scope="col">%s</th>' % inline(c) for c in head))
    out.append("<tbody>")
    for r in rows:
        out.append("<tr><th scope=\"row\">%s</th>%s</tr>" % (inline(r[0]), "".join("<td>%s</td>" % inline(c) for c in r[1:])))
    out.append("</tbody></table></div>")
    return "\n".join(out)


def code_html(text, label="Commands"):
    return '<pre tabindex="0" aria-label="%s"><code>%s</code></pre>' % (esc(label), esc(text))


def md_html(blocks, links, shift=0):
    inline = lambda t: md_inline(t, links)  # noqa: E731
    out = []
    for b in blocks:
        if b.kind == "heading":
            n = min(b.level + shift, 6)
            out.append('<h%d id="%s">%s</h%d>' % (n, slug(b.text), inline(b.text), n))
        elif b.kind == "para":
            out.append("<p>%s</p>" % inline(b.text))
        elif b.kind == "list":
            out.append("<ul>%s</ul>" % "".join("<li>%s</li>" % inline(i) for i in b.items))
        elif b.kind == "code":
            out.append(code_html(b.text))
        elif b.kind == "table":
            out.append(table_html(b.head, b.rows, inline))
    return "\n".join(out)


class Readme:
    def __init__(self, text):
        self.blocks = md_blocks(text)

    def section(self, title):
        """The blocks under a heading, to the next heading."""
        for i, b in enumerate(self.blocks):
            if b.kind == "heading" and b.text == title:
                j = i + 1
                while j < len(self.blocks) and self.blocks[j].kind != "heading":
                    j += 1
                return self.blocks[i + 1:j]
        raise Error("README.md has no section %r" % title)

    def take(self, title, start, codes=1):
        """From the block of a section that begins with START through the
        CODES-th code block after it."""
        blocks = self.section(title)
        for i, b in enumerate(blocks):
            if getattr(b, "text", "").startswith(start):
                for j in range(i, len(blocks)):
                    if blocks[j].kind == "code":
                        codes -= 1
                        if not codes:
                            return blocks[i:j + 1]
                raise Error("README.md, %r: too few code blocks after %r" % (title, start))
        raise Error("README.md, %r: nothing begins %r" % (title, start))

    def para(self, title, start):
        for b in self.section(title):
            if b.kind == "para" and b.text.startswith(start):
                return b
        raise Error("README.md, %r: no paragraph begins %r" % (title, start))

    def table(self, title, first_col):
        for b in self.section(title):
            if b.kind == "table" and b.head[0] == first_col:
                return b
        raise Error("README.md, %r: no table headed %r" % (title, first_col))


# reStructuredText, as the docs page writes it.

def rst_inline(text, ids):
    codes = []

    def code(m):
        codes.append("<code>%s</code>" % esc(m.group(1)))
        return "\0%d\0" % (len(codes) - 1)

    text = re.sub(r"``(.+?)``", code, text)

    def ref(m):
        target = "doc-" + slug(m.group(1))
        if target not in ids:
            raise Error("%s: no section %r" % (DOCS_RST, m.group(1)))
        codes.append('<a href="#%s">%s</a>' % (target, esc(m.group(1))))
        return "\0%d\0" % (len(codes) - 1)

    text = re.sub(r"`([^`]+)`_", ref, text)
    if re.search(r"[`|]|:\w+:`|\*\S|\[\d+\]_", text):
        raise Error("%s: inline markup this script doesn't know: %r" % (DOCS_RST, text))
    return re.sub(r"\0(\d+)\0", lambda m: codes[int(m.group(1))], esc(text))


def rst_html(text, top):
    """The page, its title at heading level TOP; ids prefixed doc-."""
    lines = text.split("\n")
    levels = {}
    blocks = []
    i = 0

    def indented(i):
        """The indented block from line i, dedented, and the line after it."""
        body = []
        while i < len(lines) and (lines[i].startswith(" ") or not lines[i].strip()):
            body.append(lines[i])
            i += 1
        while body and not body[-1].strip():
            body.pop()
        while body and not body[0].strip():
            body.pop(0)
        n = min(len(l) - len(l.lstrip()) for l in body if l.strip())
        return "\n".join(l[n:] for l in body), i

    while i < len(lines):
        line = lines[i]
        nxt = lines[i + 1] if i + 1 < len(lines) else ""
        if not line.strip():
            i += 1
        elif nxt and re.fullmatch(r"([=\-~^\"'])\1+", nxt) and len(nxt) >= len(line):
            level = levels.setdefault(nxt[0], len(levels))
            blocks.append(("heading", top + level, line))
            i += 2
        elif line.startswith(".. code-block::"):
            body, i = indented(i + 1)
            blocks.append(("code", body))
        elif line.startswith(".."):
            raise Error("%s:%d: a directive this script doesn't know: %r" % (DOCS_RST, i + 1, line))
        elif line.startswith("- "):
            items = []
            while i < len(lines) and lines[i].strip():
                if lines[i].startswith("- "):
                    items.append(lines[i][2:])
                elif lines[i].startswith("  "):
                    items[-1] += " " + lines[i].strip()
                else:
                    raise Error("%s:%d: a list item?" % (DOCS_RST, i + 1))
                i += 1
            blocks.append(("list", items))
        elif line.startswith(" "):
            raise Error("%s:%d: an indented block this script doesn't know" % (DOCS_RST, i + 1))
        else:
            para = []
            while i < len(lines) and lines[i].strip():
                para.append(lines[i].strip())
                i += 1
            p = " ".join(para)
            if p.endswith("::"):
                blocks.append(("para", p[:-2].rstrip() + (":" if not p.endswith(" ::") else "")))
                body, i = indented(i)
                blocks.append(("code", body))
            else:
                blocks.append(("para", p))

    ids = {"doc-" + slug(b[2]) for b in blocks if b[0] == "heading"}
    out = []
    for b in blocks:
        if b[0] == "heading":
            n = min(b[1], 6)
            out.append('<h%d id="doc-%s">%s</h%d>' % (n, slug(b[2]), rst_inline(b[2], ids), n))
        elif b[0] == "para":
            out.append("<p>%s</p>" % rst_inline(b[1], ids))
        elif b[0] == "list":
            out.append("<ul>%s</ul>" % "".join("<li>%s</li>" % rst_inline(t, ids) for t in b[1]))
        elif b[0] == "code":
            out.append(code_html(b[1], "Example"))
    return "\n".join(out)


def docs_rst(patches):
    """The docs page as the patches leave it: each patch's hunks for it,
    applied in order, checking their context."""
    header = "diff " + "--git a/%s b/%s\n" % (DOCS_RST, DOCS_RST)
    lines = []
    found = False
    for patch in sorted(glob.glob(os.path.join(patches, "*.patch"))):
        with open(patch, encoding="utf-8") as f:
            text = f.read()
        k = text.find(header)
        if k < 0:
            continue
        found = True
        rest = text[k + len(header):]
        end = re.search(r"^(diff |-- \n)", rest, re.M)
        body = (rest[:end.start()] if end else rest).split("\n")
        offset = 0
        i = 0
        while i < len(body):
            h = re.match(r"@@ -(\d+)(?:,(\d+))? \+\d+(?:,\d+)? @@", body[i])
            i += 1
            if not h:
                continue
            start, count = int(h.group(1)), int(h.group(2) or 1)
            old, new = [], []
            while i < len(body) and not body[i].startswith("@@"):
                line = body[i]
                if line.startswith(" ") or not line:
                    old.append(line[1:])
                    new.append(line[1:])
                elif line.startswith("-"):
                    old.append(line[1:])
                elif line.startswith("+"):
                    new.append(line[1:])
                i += 1
            # The blank line that ends the file's diff isn't context.
            while len(old) > count and old[-1] == "" and new and new[-1] == "":
                old.pop()
                new.pop()
            at = (start - 1 if count else start) + offset
            if lines[at:at + len(old)] != old:
                raise Error("%s: its hunk at line %d doesn't apply" % (os.path.basename(patch), start))
            lines[at:at + len(old)] = new
            offset += len(new) - len(old)
    if not found:
        raise Error("no patch in %s adds %s" % (patches, DOCS_RST))
    return "\n".join(lines)


# The page.

def downloads(commit, sha_dir, platforms):
    out = []
    for p in platforms:
        name = "qemu-chumby-%s-%s.tar.xz" % (commit, p)
        path = os.path.join(sha_dir, name + ".sha256")
        try:
            with open(path, encoding="ascii") as f:
                fields = f.read().split()
        except OSError:
            raise Error("no %s in %s" % (name + ".sha256", sha_dir))
        if len(fields) != 2 or not re.fullmatch(r"[0-9a-f]{64}", fields[0]) or fields[1].lstrip("*") != name:
            raise Error("%s: not a SHA-256 of %s" % (path, name))
        tarball = os.path.join(sha_dir, name)
        out.append({
            "platform": p,
            "name": name,
            "url": "%s/%s" % (RELEASE, name),
            "sha256": fields[0],
            "sha256_url": "%s/%s.sha256" % (RELEASE, name),
            "size": os.path.getsize(tarball) if os.path.exists(tarball) else None,
        })
    return out


def mib(n):
    return "%.1f MiB" % (n / 1048576)


