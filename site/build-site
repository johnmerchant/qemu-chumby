"""site/build-site --commit COMMIT --sha256 DIR [--out DIR]: the project's
web page, one short static page for developers, and its stylesheet.

It says only what a newcomer needs to get running, and links the README
for the rest. What it takes from README.md and qemu-release (the command,
the QEMU release and the README's sections it links)
and what it says in its own words (the summary, the legal sentence, the
licence) are looked up or checked there. The README is read with a small
parser for the Markdown it uses, which refuses anything else, and each
piece is looked up by its heading or its words, so that a README that no
longer has what the page shows fails the build rather than leaving the
page to drift.

Its downloads are COMMIT's builds on the `prebuilt` release, one for each
platform CI's build job builds (.github/workflows/ci.yml), with the SHA-256s in
DIR's qemu-chumby-COMMIT-PLATFORM.tar.xz.sha256 (CI's build artifacts; the
tarballs beside them, if there, give their sizes); and, for the Linux
desktop, the Flatpaks (qemu-chumby-COMMIT-ARCH.flatpak) and distro
packages (qemu-chumby-COMMIT-DISTRO-VERSION-ARCH.deb or .rpm) whose
.sha256 files are in DIR. It writes OUT (default _site): index.html,
style.css and downloads.json, the downloads as
[{platform, name, url, sha256, sha256_url, size}].

Python 3's standard library only.
"""
import argparse
import html
import json
import os
import re
import shutil
import sys

REPO = "https://github.com/johnmerchant/qemu-chumby"
RELEASE = REPO + "/releases/download/prebuilt"
# Each platform's name, and what it can do in a few words, as the README's
# table of prebuilt binaries says it.
PLATFORMS = {
    "linux-x86_64": ("Linux x86_64", "Static; headless, no audio."),
    "linux-aarch64": ("Linux aarch64", "Static; headless, no audio."),
    "macos-arm64": ("macOS, Apple silicon", "macOS 15+; window and audio."),
}
DISTROS = {"debian": "Debian", "ubuntu": "Ubuntu", "fedora": "Fedora"}


class Error(Exception):
    pass


def esc(s):
    return html.escape(s, quote=True)


def slug(text):
    """GitHub's anchor for a heading."""
    text = re.sub(r"[`*]", "", text).strip().lower()
    text = re.sub(r"[^\w\- ]", "", text)
    return text.replace(" ", "-")


# Markdown, as README.md writes it.

class Block:
    def __init__(self, kind, **kw):
        self.kind = kind
        self.__dict__.update(kw)


def md_blocks(text):
    lines = text.split("\n")
    blocks = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip():
            i += 1
        elif line.startswith("#"):
            m = re.match(r"(#{1,6}) (.+)$", line)
            if not m:
                raise Error("README.md:%d: a heading?" % (i + 1))
            blocks.append(Block("heading", level=len(m.group(1)), text=m.group(2)))
            i += 1
        elif line.startswith("    "):
            code = []
            while i < len(lines) and (lines[i].startswith("    ") or not lines[i].strip()):
                code.append(lines[i][4:])
                i += 1
            while code and not code[-1].strip():
                code.pop()
            blocks.append(Block("code", text="\n".join(code)))
        elif line.startswith("|"):
            rows = []
            while i < len(lines) and lines[i].startswith("|"):
                rows.append(lines[i])
                i += 1
            if len(rows) < 2 or not re.fullmatch(r"\|(\s*-+\s*\|)+", rows[1]):
                raise Error("README.md:%d: a table without a header" % (i + 1))
            cells = [md_cells(r) for r in rows]
            blocks.append(Block("table", head=cells[0], rows=cells[2:]))
        elif line.startswith("- "):
            items = []
            while i < len(lines) and lines[i].strip():
                if lines[i].startswith("- "):
                    items.append(lines[i][2:])
                elif lines[i].startswith("  "):
                    items[-1] += " " + lines[i].strip()
                else:
                    raise Error("README.md:%d: a list item?" % (i + 1))
                i += 1
            blocks.append(Block("list", items=items))
        elif re.match(r"(\d+\.|[*+>]) |```|<|\t", line):
            raise Error("README.md:%d: Markdown this script doesn't know: %r" % (i + 1, line))
        else:
            para = []
            while i < len(lines) and lines[i].strip() and not re.match(r"[#|]|- |    ", lines[i]):
                para.append(lines[i].strip())
                i += 1
            blocks.append(Block("para", text=" ".join(para)))
    return blocks


def md_cells(row):
    row = row.strip()
    cells = re.split(r"(?<!\\)\|", row[1:-1])
    return [c.strip().replace("\\|", "|") for c in cells]


class Readme:
    def __init__(self, text):
        self.blocks = md_blocks(text)

    def section(self, title):
        """The blocks under a heading, to the next heading."""
        for i, b in enumerate(self.blocks):
            if b.kind == "heading" and b.text == title:
                j = i + 1
                while j < len(self.blocks) and self.blocks[j].kind != "heading":
                    j += 1
                return self.blocks[i + 1:j]
        raise Error("README.md has no section %r" % title)

    def anchor(self, title):
        self.section(title)
        return "%s#%s" % (REPO, slug(title))

    def text(self, title):
        """A section's paragraphs and list items, as one string."""
        out = []
        for b in self.section(title):
            if b.kind == "para":
                out.append(b.text)
            elif b.kind == "list":
                out += b.items
        return " ".join(out)


def need(text, *words):
    for w in words:
        if w not in text:
            raise Error("README.md no longer says %r, which the page does" % w)


# The page.

def desktop(commit, sha_dir):
    """The Flatpaks' and distro packages' platforms (x86_64,
    debian-13-x86_64...) with a .sha256 in SHA_DIR, and their suffixes."""
    found = []
    for f in sorted(os.listdir(sha_dir)):
        m = re.fullmatch(r"qemu-chumby-%s-(.+)\.(flatpak|deb|rpm)\.sha256" % commit, f)
        if m:
            found.append((m.group(1), m.group(2)))
    # The Flatpaks first, then the distros as DISTROS has them.
    order = list(DISTROS)
    return sorted(found, key=lambda pe: (pe[1] != "flatpak", order.index(pe[0].split("-")[0])
                                         if pe[1] != "flatpak" else 0, pe[0]))


def downloads(commit, sha_dir, platforms):
    out = []
    for p in platforms:
        ext = "tar.xz"
        if isinstance(p, tuple):
            p, ext = p
        name = "qemu-chumby-%s-%s.%s" % (commit, p, ext)
        path = os.path.join(sha_dir, name + ".sha256")
        try:
            with open(path, encoding="ascii") as f:
                fields = f.read().split()
        except OSError:
            raise Error("no %s in %s" % (name + ".sha256", sha_dir))
        if len(fields) != 2 or not re.fullmatch(r"[0-9a-f]{64}", fields[0]) or fields[1].lstrip("*") != name:
            raise Error("%s: not a SHA-256 of %s" % (path, name))
        tarball = os.path.join(sha_dir, name)
        out.append({
            "platform": p,
            "name": name,
            "url": "%s/%s" % (RELEASE, name),
            "sha256": fields[0],
            "sha256_url": "%s/%s.sha256" % (RELEASE, name),
            "size": os.path.getsize(tarball) if os.path.exists(tarball) else None,
        })
    return out


def code_html(text, label):
    return '<pre tabindex="0" aria-label="%s"><code>%s</code></pre>' % (esc(label), esc(text))


def page(readme, commit, qemu_version, dls):
    title = readme.blocks[0].text

    # The README's opening: the command.
    opening = []
    for b in readme.blocks[1:]:
        if b.kind == "heading":
            break
        opening.append(b)
    summary = next((b.text for b in opening if b.text.startswith("A QEMU machine for the Chumby Classic")), "")
    m = re.search(r"`(qemu-system-arm -M chumby-classic)`", summary)
    if not m:
        raise Error("README.md: no summary naming qemu-system-arm -M chumby-classic")
    command = m.group(1)
    need(summary, "i.MX21", "ARM926EJ-S")
    # The page's legal sentence and licence line shorten these.
    need(readme.text("Legal"), "not affiliated with or endorsed by Chumby Industries",
         "anyone holding rights in Chumby", "No Chumby software", "never go in this repository")
    need(readme.text("Licence"), "GPL-2.0-or-later")

    static = [d for d in dls if d["name"].endswith(".tar.xz")]
    for d in static:
        if d["platform"] not in PLATFORMS:
            raise Error("ci.yml builds a platform this page doesn't describe: %s" % d["platform"])

    # The Linux desktop's: the Flatpaks, then one line per distro package.
    linux = []
    for d in dls:
        if d["name"].endswith(".tar.xz"):
            continue
        ext = d["name"].rsplit(".", 1)[1]
        size = " (%.1f MiB)" % (d["size"] / 1048576) if d["size"] else ""
        if ext == "flatpak":
            what = "Flatpak (desktop app with sound), %s" % d["platform"]
        else:
            distro, version, arch = d["platform"].rsplit("-", 2)
            what = "%s %s, %s" % (DISTROS.get(distro, distro), version, arch)
        linux.append('<li><a href="{url}">{what} .{ext}</a>{size} &middot; <a href="{sha_url}">SHA-256'
                     '<span class="vh"> file for {what}</span></a></li>'.format(
                         url=esc(d["url"]), what=esc(what), ext=esc(ext), size=esc(size),
                         sha_url=esc(d["sha256_url"])))
    linux_html = ""
    if linux:
        linux_html = """<h3 id="linux-desktop">Linux desktop</h3>
<p>The Flatpak is chumby-desktop, the app, with its QEMU and sound. The distro packages
install <code>qemu-chumby-system-arm</code> (GTK or SDL window, sound) beside the
distro&rsquo;s own QEMU, with <code>chumby-machine</code> and <code>chumby-ctl</code>.</p>
<ul class="pkgs">
%s
</ul>
%s""" % ("\n".join(linux), code_html("\n".join([
            "flatpak install --user ./qemu-chumby-*-x86_64.flatpak",
            "sudo apt install ./qemu-chumby-*-debian-13-x86_64.deb",
            "sudo dnf install ./qemu-chumby-*-fedora-44-x86_64.rpm",
        ]), "Install"))

    cards = []
    for d in static:
        label, note = PLATFORMS[d["platform"]]
        size = "%.1f MiB" % (d["size"] / 1048576) if d["size"] else ""
        cards.append("""<li class="card">
<h3>{label}</h3>
<p class="note">{note}</p>
<p class="get"><a class="button" href="{url}">Download<span class="vh"> for {label}</span> .tar.xz</a> <span class="size">{size}</span></p>
<p class="sha"><a href="{sha_url}">SHA-256<span class="vh"> file for {label}</span></a> <code>{sha}</code></p>
</li>""".format(label=esc(label), note=esc(note), url=esc(d["url"]), sha_url=esc(d["sha256_url"]),
                sha=esc(d["sha256"]), size=esc(size)))

    d0 = next((d for d in static if d["platform"] == "linux-x86_64"), static[0])
    run = "\n".join([
        "tar xJf qemu-chumby-*-%s.tar.xz" % d0["platform"],
        "cd qemu-chumby-*-%s" % d0["platform"],
        "./qemu-system-arm -M chumby-classic -kernel zImage \\",
        "    -nic none -display none -serial stdio \\",
        "    -qmp unix:qmp.sock,server=on,wait=off",
    ])

    more = [
        (readme.anchor("Quick start"), "Build from source"),
        (readme.anchor("What it emulates"), "What&rsquo;s emulated"),
        (readme.anchor("Tools"), "The apps, and driving it from code"),
        (readme.anchor("Images"), "Images from your own Chumby"),
    ]
    short = commit[:12]

    return """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{title}</title>
<meta name="description" content="A QEMU machine for the Chumby Classic: {command}">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect x='1' y='3' width='14' height='10' rx='2' fill='%23127a6a'/%3E%3Crect x='3' y='5' width='10' height='6' rx='.5' fill='%23e9f6f3'/%3E%3C/svg%3E">
<link rel="stylesheet" href="style.css">
</head>
<body>
<a class="skip" href="#main">Skip to the content</a>
<main id="main" class="wrap">

<header class="intro">
<h1>{title}</h1>
<p class="lead">The Chumby Classic&rsquo;s i.MX21 (ARM926EJ-S) and board devices in QEMU {qemu}:
<code class="nw">{command}</code>.</p>
<p class="links"><a href="{repo}">Source on GitHub</a></p>
</header>

<section aria-labelledby="download">
<h2 id="download">Download</h2>
<p>Main&rsquo;s newest build (<a href="{repo}/commit/{commit}"><code>{short}</code></a>). Needs nothing
installed.</p>
<ul class="cards">
{cards}
</ul>
{linux}
</section>

<section aria-labelledby="run">
<h2 id="run">Run</h2>
{run}
<p>A zImage of your own Chumby&rsquo;s kernel, or any for the MX21ADS. The console is on your
terminal, QMP on <code>qmp.sock</code>.</p>
</section>

<section aria-labelledby="more">
<h2 id="more">More in the README</h2>
<ul class="more">
{more}
</ul>
</section>

<section aria-labelledby="legal">
<h2 id="legal">Legal</h2>
<p>An independent project, not affiliated with or endorsed by Chumby Industries or anyone holding rights
in Chumby; it contains none of the Chumby&rsquo;s software, so bring your own firmware.
<a href="{legal_href}">The full Legal section</a>.</p>
<p>Licence: GPL-2.0-or-later.</p>
</section>
</main>
<footer class="wrap">
<p><a href="{repo}/releases/tag/prebuilt">Older builds</a> &middot;
<a href="downloads.json">downloads.json</a></p>
</footer>
</body>
</html>
""".format(
        title=esc(title), command=esc(command), qemu=esc(qemu_version), repo=REPO,
        commit=esc(commit), short=esc(short), cards="\n".join(cards),
        linux=linux_html,
        run=code_html(run, "Unpack and boot"),
        more="\n".join('<li><a href="%s">%s</a></li>' % (esc(h), t) for h, t in more),
        legal_href=readme.anchor("Legal"))


def main():
    ap = argparse.ArgumentParser(description="Makes the project's web page.")
    ap.add_argument("--commit", required=True, help="the full commit ID whose builds to link")
    ap.add_argument("--sha256", required=True, metavar="DIR", help="where its .sha256 files are")
    ap.add_argument("--out", default="_site")
    ap.add_argument("--root", default=os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."),
                    help="the checkout (default: this script's)")
    a = ap.parse_args()
    if not re.fullmatch(r"[0-9a-f]{40}", a.commit):
        raise Error("--commit: a full commit ID, please")
    with open(os.path.join(a.root, "README.md"), encoding="utf-8") as f:
        readme = Readme(f.read())
    with open(os.path.join(a.root, "qemu-release"), encoding="utf-8") as f:
        m = re.search(r"^version=([\w.]+)$", f.read(), re.M)
    if not m:
        raise Error("qemu-release: no version")
    # The platforms: the build job's matrix.
    with open(os.path.join(a.root, ".github", "workflows", "ci.yml"), encoding="utf-8") as f:
        m2 = re.search(r"^  build:\n(.*?)^  \w", f.read(), re.M | re.S)
    platforms = re.findall(r"^\s+- platform: (\S+)$", m2.group(1), re.M) if m2 else []
    if not platforms:
        raise Error("ci.yml: no platforms in the build job's matrix")
    dls = downloads(a.commit, a.sha256, platforms + desktop(a.commit, a.sha256))
    text = page(readme, a.commit, m.group(1), dls)
    os.makedirs(a.out, exist_ok=True)
    with open(os.path.join(a.out, "index.html"), "w", encoding="utf-8") as f:
        f.write(text)
    with open(os.path.join(a.out, "downloads.json"), "w", encoding="utf-8") as f:
        json.dump(dls, f, indent=2)
        f.write("\n")
    shutil.copyfile(os.path.join(os.path.dirname(os.path.abspath(__file__)), "style.css"),
                    os.path.join(a.out, "style.css"))
    print("%s: %d downloads, %d bytes" % (os.path.join(a.out, "index.html"), len(dls), len(text)))


if __name__ == "__main__":
    try:
        main()
    except Error as e:
        sys.exit("build-site: %s" % e)
