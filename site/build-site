""".format(
        title=title, desc=esc(re.sub(r"`", "", tagline.text)), nav=nav, repo=REPO,
        tagline=inline(tagline.text), intro=md(intro),
        modelled=table_html(modelled.head, modelled.rows, inline, "What is modelled"),
        commit=esc(commit), short=esc(short), needs=inline(needs.text),
        cards="\n".join(cards), both=inline(both.text), quarantine=inline(quarantine.text),
        get=code_html(get), running=md([b for b in running if b.kind == "code"][:1]),
        images=md(images), quick=qs_html, rst_path=esc(DOCS_RST), rst=rst_html(rst, 3),
        legal=md(readme.section("Legal")), licence=md(readme.section("Licence")))


def main():
    ap = argparse.ArgumentParser(description="Makes the project's web page.")
    ap.add_argument("--commit", required=True, help="the full commit ID whose builds to link")
    ap.add_argument("--sha256", required=True, metavar="DIR", help="where its .sha256 files are")
    ap.add_argument("--out", default="_site")
    ap.add_argument("--root", default=os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."),
                    help="the checkout (default: this script's)")
    a = ap.parse_args()
    if not re.fullmatch(r"[0-9a-f]{40}", a.commit):
        raise Error("--commit: a full commit ID, please")
    with open(os.path.join(a.root, "README.md"), encoding="utf-8") as f:
        readme = Readme(f.read())
    rst = docs_rst(os.path.join(a.root, "patches"))
    platforms = []
    for r in readme.table("Prebuilt binaries", "Platform").rows:
        platforms += re.findall(r"`([^`]+)`", r[0])
    if not platforms:
        raise Error("README.md: no platforms in the prebuilt binaries' table")
    dls = downloads(a.commit, a.sha256, platforms)
    text = page(readme, rst, a.commit, dls)
    os.makedirs(a.out, exist_ok=True)
    with open(os.path.join(a.out, "index.html"), "w", encoding="utf-8") as f:
        f.write(text)
    with open(os.path.join(a.out, "downloads.json"), "w", encoding="utf-8") as f:
        json.dump(dls, f, indent=2)
        f.write("\n")
    shutil.copyfile(os.path.join(os.path.dirname(os.path.abspath(__file__)), "style.css"),
                    os.path.join(a.out, "style.css"))
    print("%s: %d downloads, %d bytes" % (os.path.join(a.out, "index.html"), len(dls), len(text)))


if __name__ == "__main__":
    try:
        main()
    except Error as e:
        sys.exit("build-site: %s" % e)
