#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
#
# chumby-ctl SOCKET COMMAND: drives a running chumby-classic machine over
# its QMP socket (-qmp unix:SOCKET,server=on,wait=off). Needs nc with -U
# (BSD or OpenBSD netcat).
#
#   tap X Y [MS]   press the screen at pixel X,Y (0-319, 0-239), release
#                  after MS milliseconds (default 150)
#   down X Y       press and hold at X,Y
#   up             release
#   button down|up|tap [MS]
#                  press, release, or press and release the top button
#                  (/dev/switch); tap holds it MS milliseconds (default 300)
#   shot FILE      write the screen to FILE as PNG
#   qmp JSON       send one QMP command and print the replies
set -eu

usage() {
    sed -n '4,18s/^# \{0,1\}//p' "$0" >&2
    exit 2
}

[ $# -ge 2 ] || usage
sock=$1
cmd=$2
shift 2

qmp() {
    printf '%s\n' '{"execute":"qmp_capabilities"}' "$@" |
        nc -U -w 1 "$sock" | sed 1,2d
}

# Screen pixels to the input layer's absolute range, 0-32767.
pos() {
    x=$(( $1 * 32767 / 319 ))
    y=$(( $2 * 32767 / 239 ))
    printf '{"type":"abs","data":{"axis":"x","value":%d}},' "$x"
    printf '{"type":"abs","data":{"axis":"y","value":%d}},' "$y"
}

button() {
    printf '{"type":"btn","data":{"button":"left","down":%s}}' "$1"
}

events() {
    qmp "{\"execute\":\"input-send-event\",\"arguments\":{\"events\":[$1]}}"
}

# The top button is the machine's "button" property.
top_button() {
    qmp "{\"execute\":\"qom-set\",\"arguments\":{\"path\":\"/machine\",\"property\":\"button\",\"value\":$1}}"
}

sleep_ms() {
    sleep "$(( $1 / 1000 )).$(printf '%03d' $(( $1 % 1000 )))"
}

case $cmd in
tap)
    [ $# -ge 2 ] || usage
    events "$(pos "$1" "$2")$(button true)"
    sleep_ms "${3:-150}"
    events "$(button false)"
    ;;
button)
    [ $# -ge 1 ] || usage
    case $1 in
    down) top_button true ;;
    up) top_button false ;;
    tap)
        top_button true
        sleep_ms "${2:-300}"
        top_button false
        ;;
    *) usage ;;
    esac
    ;;
down)
    [ $# -eq 2 ] || usage
    events "$(pos "$1" "$2")$(button true)"
    ;;
up)
    events "$(button false)"
    ;;
shot)
    [ $# -eq 1 ] || usage
    case $1 in
    /*) file=$1 ;;
    *) file=$(pwd)/$1 ;;
    esac
    qmp "{\"execute\":\"screendump\",\"arguments\":{\"filename\":\"$file\",\"format\":\"png\"}}"
    ;;
qmp)
    [ $# -eq 1 ] || usage
    qmp "$1"
    ;;
*)
    usage
    ;;
esac
