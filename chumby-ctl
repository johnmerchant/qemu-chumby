#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""chumby-ctl SOCKET COMMAND...: drives a running chumby-classic machine
over its QMP socket (-qmp unix:SOCKET,server=on,wait=off). Python 3 only.

  tap X Y [MS]        press the screen at pixel X,Y (0-319, 0-239), release
                      after MS milliseconds (default 150)
  down X Y            press and hold at X,Y
  up                  release
  button down|up|tap [MS]
                      press, release, or press and release the top button
                      (/dev/switch); tap holds it MS milliseconds (default 300)
  headphones in|out   plug headphones in or take them out
  accel X Y Z         set the accelerometer, in milli-g along each axis
  state               the board's lines, the accelerometer and the identity
                      as JSON (query-chumby-state)
  events [SECONDS]    print QMP events as JSON lines, until SECONDS have
                      passed (default: until the machine quits). A QMP
                      socket serves one client at a time: watch events on
                      a second -qmp socket, or after other commands here
  shot FILE           write the screen to FILE as PNG
  qmp JSON            send one QMP command and print the reply

Several commands can be given at once, separated by "--":
  chumby-ctl qmp.sock headphones in -- button tap -- state
"""
import json
import os
import socket
import sys
import time

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from chumby_machine import QMP, Error  # noqa: E402


def events(q, seconds):
    """Prints QMP events as JSON lines until SECONDS have passed, or the
    machine quits."""
    for e in q.events:
        print(json.dumps(e), flush=True)
    q.events.clear()
    end = None if seconds is None else time.monotonic() + seconds
    while end is None or time.monotonic() < end:
        q.sock.settimeout(None if end is None else max(0.01, end - time.monotonic()))
        try:
            msg = q.message()
        except (socket.timeout, TimeoutError, ConnectionError):
            return
        print(json.dumps(msg), flush=True)


def usage():
    sys.stderr.write(__doc__.split("\n", 1)[1])
    sys.exit(2)


def sleep_ms(ms):
    time.sleep(int(ms) / 1000)


def pen(q, down, x=None, y=None):
    ev = []
    if x is not None:
        # Screen pixels to the input layer's absolute range, 0-32767.
        ev += [{"type": "abs", "data": {"axis": "x", "value": int(x) * 32767 // 319}},
               {"type": "abs", "data": {"axis": "y", "value": int(y) * 32767 // 239}}]
    ev.append({"type": "btn", "data": {"button": "left", "down": down}})
    q.cmd("input-send-event", events=ev)


def run(q, cmd, a):
    if cmd == "tap" and len(a) in (2, 3):
        pen(q, True, a[0], a[1])
        sleep_ms(a[2] if len(a) > 2 else 150)
        pen(q, False)
    elif cmd == "down" and len(a) == 2:
        pen(q, True, a[0], a[1])
    elif cmd == "up" and not a:
        pen(q, False)
    elif cmd == "button" and a and a[0] in ("down", "up", "tap"):
        if a[0] in ("down", "tap"):
            q.cmd("qom-set", path="/machine", property="button", value=True)
        if a[0] == "tap":
            sleep_ms(a[1] if len(a) > 1 else 300)
        if a[0] in ("up", "tap"):
            q.cmd("qom-set", path="/machine", property="button", value=False)
    elif cmd == "headphones" and a in (["in"], ["out"]):
        q.cmd("qom-set", path="/machine", property="headphones", value=a[0] == "in")
    elif cmd == "accel" and len(a) == 3:
        for prop, v in zip(("accel-x", "accel-y", "accel-z"), a):
            q.cmd("qom-set", path="/machine", property=prop, value=int(v))
    elif cmd == "state" and not a:
        print(json.dumps(q.cmd("query-chumby-state"), sort_keys=True))
    elif cmd == "events" and len(a) <= 1:
        events(q, float(a[0]) if a else None)
    elif cmd == "shot" and len(a) == 1:
        q.cmd("screendump", filename=os.path.abspath(a[0]), format="png")
    elif cmd == "qmp" and len(a) == 1:
        print(json.dumps(q.send(json.loads(a[0]))))
    else:
        usage()


def main():
    if len(sys.argv) < 3:
        usage()
    try:
        q = QMP(sys.argv[1], timeout=None)
        words = sys.argv[2:]
        while words:
            n = words.index("--") if "--" in words else len(words)
            run(q, words[0], words[1:n])
            words = words[n + 1:]
    except (Error, OSError) as e:
        sys.exit(f"chumby-ctl: {e}")


if __name__ == "__main__":
    main()
