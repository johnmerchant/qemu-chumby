"""chumby-term TTY: the Chumby's console in this terminal.

Joins the terminal it runs in, in raw mode, to TTY: the pseudo-terminal
chumby-emu's panel serves the console on (shown in its status bar), which
the panel's Terminal button opens this on. Any serial terminal program
(tio, screen, minicom, picocom) opens the same device. Ctrl-] closes it.
"""
import os
import select
import sys
import termios
import tty

ESCAPE = b"\x1d"  # Ctrl-]


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__.strip())
    try:
        dev = os.open(sys.argv[1], os.O_RDWR | os.O_NOCTTY)
    except OSError as e:
        sys.exit(f"chumby-term: {e}")
    tty.setraw(dev)
    os.write(1, b"\x1b]0;Chumby console\x07"
                b"Chumby console: Ctrl-] closes this window.\r\n")
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        while True:
            r, _, _ = select.select([fd, dev], [], [])
            if dev in r:
                try:
                    data = os.read(dev, 4096)
                except OSError:
                    data = b""
                if not data:
                    os.write(1, b"\r\n[the Chumby has quit]\r\n")
                    break
                os.write(1, data)
            if fd in r:
                data = os.read(fd, 1024)
                if not data or ESCAPE in data:
                    break
                os.write(dev, data)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)


if __name__ == "__main__":
    main()
