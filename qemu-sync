#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""qemu-sync [--dry-run | --self-test]: keeps qemu-release in step with
QEMU's releases. CI's qemu-sync job runs it daily; run by hand, it does
the same from a checkout of main.

QEMU's releases are its tags at https://gitlab.com/qemu-project/qemu,
vMAJOR.MINOR.PATCH only (never -rc). Two bumps can be due:

  point   the newest release of the pinned series (11.1.x), which the
          patches should still apply to;
  series  the newest release of the newest newer series (11.2.x,
          12.0.x...), which will likely need porting.

Each is a fixed branch, qemu-bump/point or qemu-bump/series, made from
the current commit (main). Its first commit is qemu-release (version,
url, sha256), the Flatpak manifest's QEMU source and the README's
mentions of the version. The tarball is downloaded from
download.qemu.org and checked against the .sig beside it, a detached
signature by QEMU's release key, which is pinned here (FINGERPRINT, and
qemu-release-key.asc): nothing else is trusted, and the SHA-256 written
is that of the verified file.

Then the patch series is carried over, as CI's round trip checks it:
./dev-series import applies patches/ to the verified tarball's tree and
./dev-series export writes it back. If that changes the patches (a hunk
that moved, or context that changed upstream), a second commit has
them. Only hunk headers and context lines should change; if anything
else did, the pull request says so. If a patch doesn't apply, nothing
of the series is committed: the branch keeps main's patches/, and the
pull request names the patch and gives git apply's error, for porting
by hand.

The branch is force-pushed and a pull request opened (or, for a newer
release than the open one targets, updated) with gh, then CI is run on
the branch with workflow_dispatch, since what GITHUB_TOKEN pushes or
opens starts no workflow. If an open pull request already targets the
version, nothing is done. Where the repository doesn't let workflows
open pull requests, the branch is pushed and the URL to open one by
hand is printed. Nothing is merged or approved.

--dry-run does everything but commit, push and touch pull requests: it
finds the releases, downloads and verifies what's due, carries the
series over, and prints the plan. --self-test checks the verification:
the pinned release's tarball must pass and match qemu-release's SHA-256,
and a copy with one byte changed must fail.

Needs git, gpgv, tar and xz, and for anything but --self-test, gh
(GH_TOKEN).
"""

import argparse
import base64
import difflib
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import textwrap
import urllib.parse
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
UPSTREAM = "https://gitlab.com/qemu-project/qemu"
DOWNLOAD = "https://download.qemu.org"

# QEMU's release key: Michael Roth's, which has signed QEMU's source
# tarballs since 2013 and every 11.x release. https://www.qemu.org/download/
# gives this fingerprint, and keys.openpgp.org and keyserver.ubuntu.com
# both serve the key with it; qemu-release-key.asc is keys.openpgp.org's
# copy. A release signed with any other key fails here.
FINGERPRINT = "CEACC9E15534EBABB82D3FA03353C9CEF108B584"
KEYFILE = os.path.join(HERE, "qemu-release-key.asc")
FLATPAK_MANIFEST = "flatpak/io.github.johnmerchant.QemuChumby.yml"
DEV_SERIES = os.path.join(HERE, "dev-series")
PATCHES = os.path.join(HERE, "patches")

BRANCHES = {"point": "qemu-bump/point", "series": "qemu-bump/series"}
BOT = "github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>"


def run(*cmd, check=True, capture=True, **kw):
    r = subprocess.run(cmd, check=False, text=True,
                       stdout=subprocess.PIPE if capture else None,
                       stderr=subprocess.PIPE if capture else None, **kw)
    if check and r.returncode != 0:
        sys.exit(f"{' '.join(cmd)}: exit {r.returncode}\n{r.stderr or ''}")
    return r


def parse(v):
    return tuple(int(x) for x in v.split("."))


def fmt(v):
    return ".".join(str(x) for x in v)


def releases():
    """Every final release tagged upstream, as (major, minor, patch)."""
    out = run("git", "ls-remote", "--tags", "--refs", UPSTREAM + ".git").stdout
    vs = set()
    for line in out.splitlines():
        m = re.fullmatch(r"[0-9a-f]+\trefs/tags/v(\d+)\.(\d+)\.(\d+)", line)
        if m:
            vs.add(tuple(int(x) for x in m.groups()))
    if not vs:
        sys.exit(f"no releases found at {UPSTREAM}")
    return sorted(vs)


def due(current, vs):
    """{kind: version} of the bumps due from current."""
    plan = {}
    point = max(v for v in vs if v[:2] == current[:2])
    if point > current:
        plan["point"] = point
    newer = [v for v in vs if v[:2] > current[:2]]
    if newer:
        plan["series"] = max(newer)
    return plan


def tarball_url(v):
    return f"{DOWNLOAD}/qemu-{fmt(v)}.tar.xz"


def published(url):
    req = urllib.request.Request(url, method="HEAD")
    try:
        with urllib.request.urlopen(req, timeout=60):
            return True
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return False
        raise


def download(url, path):
    print(f"fetching {url}", flush=True)
    with urllib.request.urlopen(url, timeout=300) as r, open(path, "wb") as f:
        shutil.copyfileobj(r, f, 1 << 20)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for b in iter(lambda: f.read(1 << 20), b""):
            h.update(b)
    return h.hexdigest()


def keyring(tmp):
    """KEYFILE unarmoured into tmp, for gpgv, once its primary key is
    checked to be FINGERPRINT's."""
    ring = os.path.join(tmp, "qemu-release-key.gpg")
    if os.path.exists(ring):
        return ring
    with open(KEYFILE) as f:
        text = f.read()
    m = re.search(r"-----BEGIN PGP PUBLIC KEY BLOCK-----\n(?:[^\n]+\n)*\n"
                  r"([A-Za-z0-9+/=\n]+?)\n=[A-Za-z0-9+/]{4}\n"
                  r"-----END PGP PUBLIC KEY BLOCK-----", text)
    if not m:
        sys.exit(f"{KEYFILE}: not an armoured public key")
    data = base64.b64decode(m.group(1))
    # The first packet, the primary key: a v4 key's fingerprint is the
    # SHA-1 of 0x99, its two-byte length and its body (RFC 4880 12.2).
    tag = data[0]
    if tag & 0xC0 == 0xC0:  # new format
        if (tag & 0x3F) != 6 or data[1] >= 224:
            sys.exit(f"{KEYFILE}: unexpected first packet")
        if data[1] < 192:
            n, off = data[1], 2
        else:
            n, off = ((data[1] - 192) << 8) + data[2] + 192, 3
    elif tag & 0x80 and (tag >> 2) & 0xF == 6:  # old format
        lt = tag & 3
        size = {0: 1, 1: 2, 2: 4}[lt]
        n, off = int.from_bytes(data[1:1 + size], "big"), 1 + size
    else:
        sys.exit(f"{KEYFILE}: unexpected first packet")
    key = data[off:off + n]
    fpr = hashlib.sha1(b"\x99" + n.to_bytes(2, "big") + key).hexdigest().upper()
    if key[0] != 4 or fpr != FINGERPRINT:
        sys.exit(f"{KEYFILE} is not the key {FINGERPRINT} (it's {fpr})")
    with open(ring, "wb") as f:
        f.write(data)
    return ring


def verify(path, sig, tmp):
    """True if sig is a good signature of path by FINGERPRINT's key."""
    r = run("gpgv", "--keyring", keyring(tmp), "--status-fd", "1", sig, path,
            check=False)
    status = [l.split() for l in r.stdout.splitlines()]
    good = any(l[1:2] == ["GOODSIG"] for l in status)
    # VALIDSIG's last field is the signing key's primary fingerprint.
    valid = any(l[1:2] == ["VALIDSIG"] and l[-1] == FINGERPRINT for l in status)
    return r.returncode == 0 and good and valid


def fetch_verified(v, tmp):
    """The verified tarball of v in tmp, and its SHA-256."""
    url = tarball_url(v)
    path = os.path.join(tmp, os.path.basename(url))
    download(url, path)
    download(url + ".sig", path + ".sig")
    if not verify(path, path + ".sig", tmp):
        sys.exit(f"{url}: its signature does not verify with {FINGERPRINT}")
    digest = sha256(path)
    print(f"verified {os.path.basename(url)}: signed by {FINGERPRINT}, "
          f"SHA-256 {digest}")
    os.unlink(path + ".sig")
    return path, digest


def skeleton(text):
    """A patch without its hunk headers and context lines: what carrying
    it over to another release must leave as it is (its DEP-3 header,
    the files it touches and every line it adds or removes)."""
    header, _, diff = text.partition("\n---\n")
    return header.split("\n") + ["---"] + [
        l for l in diff.split("\n") if l and not l.startswith(("@@ ", " "))]


def carry(tarball, new, tmp):
    """patches/ applied to the release in tarball (./dev-series import)
    and written back (./dev-series export), as CI's round trip does.

    A dict: failed, dev-series's error naming the first patch that git
    apply refused (and nothing else set); or else out, the directory the
    series was exported to, changed, the patches that differ from
    patches/, and other, what changed beyond hunk headers and context
    lines."""
    src = os.path.join(tmp, f"qemu-{fmt(new)}")
    out = os.path.join(tmp, f"patches-{fmt(new)}")
    for d in (src, out):
        shutil.rmtree(d, ignore_errors=True)
        os.mkdir(d)
    run("tar", "-C", src, "--strip-components=1", "-xf", tarball)
    # Who makes the tree's first commit, the release; each patch's commit
    # is its Author:'s. Dates are UTC (dev-series sets TZ).
    name, _, email = BOT.partition(" <")
    email = email.rstrip(">")
    env = dict(os.environ, TZ="UTC", GIT_AUTHOR_NAME=name,
               GIT_AUTHOR_EMAIL=email, GIT_COMMITTER_NAME=name,
               GIT_COMMITTER_EMAIL=email)
    r = run(sys.executable, "-I", DEV_SERIES, "import", src, PATCHES,
            check=False, env=env)
    if r.returncode != 0:
        shutil.rmtree(src)
        return {"failed": r.stderr.strip() or f"dev-series import: exit {r.returncode}"}
    run(sys.executable, "-I", DEV_SERIES, "export", src, out, env=env)
    shutil.rmtree(src)

    def names(d):
        return {f for f in os.listdir(d) if f.endswith(".patch")}

    changed, other = [], []
    for f in sorted(names(PATCHES) | names(out)):
        a = os.path.join(PATCHES, f)
        b = os.path.join(out, f)
        if not os.path.exists(b):
            changed.append(f)
            other.append(f"{f}: not exported")
            continue
        if not os.path.exists(a):
            changed.append(f)
            other.append(f"{f}: exported, but not in patches/")
            continue
        with open(a) as fa, open(b) as fb:
            ta, tb = fa.read(), fb.read()
        if ta == tb:
            continue
        changed.append(f)
        sa, sb = skeleton(ta), skeleton(tb)
        if sa != sb:
            # Without difflib's own @@ lines, whose numbers are of the
            # skeletons, not of the patch.
            d = [l for l in difflib.unified_diff(sa, sb, f"a/{f}", f"b/{f}",
                                                 n=1, lineterm="")
                 if not l.startswith("@@ ")]
            other.append(f"{f}: more than hunk headers and context lines:\n"
                         + "\n".join(d[:40]) + ("\n..." if len(d) > 40 else ""))
    return {"failed": None, "out": out, "changed": changed, "other": other}


def describe(c, new):
    """carry()'s result in a line, for the log."""
    n = fmt(new)
    if c["failed"]:
        lines = c["failed"].splitlines()
        s = f"the series does not apply to {n}: {lines[0].rstrip(':')}"
        return s + (f" ({lines[1]})" if len(lines) > 1 else "")
    if not c["changed"]:
        return f"the series applies to {n} and re-exports unchanged"
    s = (f"the series applies to {n}; re-exporting it changes "
         f"{', '.join(c['changed'])}")
    if c["other"]:
        s += " (more than hunk headers and context: see the pull request)"
    return s


def pinned():
    vals = {}
    with open(os.path.join(HERE, "qemu-release")) as f:
        for line in f:
            k, _, val = line.strip().partition("=")
            vals[k] = val
    return vals


def self_test():
    p = pinned()
    v = parse(p["version"])
    with tempfile.TemporaryDirectory() as tmp:
        path = os.path.join(tmp, os.path.basename(p["url"]))
        download(p["url"], path)
        download(p["url"] + ".sig", path + ".sig")
        if not verify(path, path + ".sig", tmp):
            sys.exit(f"FAIL: {fmt(v)}'s tarball does not verify")
        if sha256(path) != p["sha256"]:
            sys.exit(f"FAIL: {fmt(v)}'s tarball verifies but isn't qemu-release's")
        print(f"ok: {fmt(v)}'s tarball verifies and matches qemu-release")
        with open(path, "r+b") as f:
            f.seek(os.path.getsize(path) // 2)
            b = f.read(1)
            f.seek(-1, 1)
            f.write(bytes([b[0] ^ 1]))
        if verify(path, path + ".sig", tmp):
            sys.exit("FAIL: a tampered tarball verifies")
        print("ok: a tampered tarball fails")


def gh_json(*args):
    return json.loads(run("gh", *args).stdout or "null")


def repo():
    r = os.environ.get("GITHUB_REPOSITORY")
    if r:
        return r
    url = run("git", "-C", HERE, "remote", "get-url", "origin").stdout.strip()
    m = re.search(r"github\.com[:/](.+?)(\.git)?$", url)
    return m.group(1)


def remote_version(branch):
    """The version qemu-release pins on origin's branch, or None."""
    if not run("git", "-C", HERE, "ls-remote", "--heads", "origin", branch).stdout.strip():
        return None
    run("git", "-C", HERE, "fetch", "-q", "origin", f"refs/heads/{branch}")
    text = run("git", "-C", HERE, "show", "FETCH_HEAD:qemu-release").stdout
    m = re.search(r"^version=(.+)$", text, re.M)
    return m.group(1) if m else None


def changes(old, new):
    """Markdown on what changed upstream from old to new."""
    s = (f"QEMU's changelog for {new[0]}.{new[1]}: "
         f"https://wiki.qemu.org/ChangeLog/{new[0]}.{new[1]}\n\n"
         f"Upstream's changes: {UPSTREAM}/-/compare/v{fmt(old)}...v{fmt(new)}\n")
    if old[:2] != new[:2]:
        return s
    # A stable release: its commits, from GitLab's compare.
    q = urllib.parse.urlencode({"from": f"v{fmt(old)}", "to": f"v{fmt(new)}"})
    try:
        with urllib.request.urlopen(
                "https://gitlab.com/api/v4/projects/qemu-project%2Fqemu/"
                f"repository/compare?{q}", timeout=60) as r:
            commits = json.load(r)["commits"]
    except Exception as e:
        print(f"no commit list from GitLab: {e}", file=sys.stderr)
        return s
    s += f"\n<details><summary>{len(commits)} commits</summary>\n\n"
    for c in commits:
        # As code, so that no @name or #number in it links anything.
        title = c["title"].replace("`", "'")
        s += f"- `{title}`\n"
    return s + "\n</details>\n"


def edit_files(old, new, digest):
    o, n = fmt(old), fmt(new)
    with open(os.path.join(HERE, "qemu-release"), "w") as f:
        f.write(f"version={n}\nurl={tarball_url(new)}\nsha256={digest}\n")
    readme = os.path.join(HERE, "README.md")
    with open(readme) as f:
        text = f.read()
    for a, b in [
        (f"[![QEMU {o}](https://img.shields.io/badge/QEMU-{o}-orange)]",
         f"[![QEMU {n}](https://img.shields.io/badge/QEMU-{n}-orange)]"),
        (f"The patches apply to QEMU {o} (", f"The patches apply to QEMU {n} ("),
    ]:
        if text.count(a) != 1:
            sys.exit(f"README.md: expected one {a!r}")
        text = text.replace(a, b)
    with open(readme, "w") as f:
        f.write(text)
    # The Flatpak's manifest builds QEMU from the same tarball.
    manifest = os.path.join(HERE, FLATPAK_MANIFEST)
    with open(manifest) as f:
        text = f.read()
    for pattern, line in [(r"^ +url: https://download\.qemu\.org/.*$", f"url: {tarball_url(new)}"),
                          (r"^ +sha256: [0-9a-f]{64}$", f"sha256: {digest}")]:
        found = re.findall(pattern, text, re.M)
        if len(found) != 1:
            sys.exit(f"{FLATPAK_MANIFEST}: expected one line like {pattern!r}")
        indent = found[0][:len(found[0]) - len(found[0].lstrip())]
        text = text.replace(found[0], indent + line)
    with open(manifest, "w") as f:
        f.write(text)


def message(kind, old, new):
    o, n = fmt(old), fmt(new)
    what = ("the newest release of the pinned series," if kind == "point"
            else f"the newest release of a newer series, {new[0]}.{new[1]},")
    text = (f"QEMU {n}, {what} in place of {o}: qemu-release, the "
            f"Flatpak manifest's QEMU source and the README's mentions of "
            f"the version. The tarball's signature was "
            f"checked with QEMU's release key, {FINGERPRINT}, and the SHA-256 "
            f"is that of the verified file.")
    return (f"qemu-release: QEMU {n}\n\n{textwrap.fill(text, 72)}\n\n"
            f"Made by CI's qemu-sync job (./qemu-sync).\n")


def series_section(c, new):
    """The pull request's section on the patch series."""
    n = fmt(new)
    s = "## The patch series\n\n"
    if c["failed"]:
        patch = c["failed"].split(" ", 1)[0]
        return s + (
            f"**`{patch}` does not apply to QEMU {n}.** Nothing of the "
            f"series was carried over: `patches/` here is main's, and this "
            f"pull request's builds will fail until it is ported. "
            f"`./dev-series import` stopped at it; `git apply` said:\n\n"
            f"````\n{c['failed']}\n````\n\n"
            f"To port it: `./dev-series import DIR PATCHES` the patches "
            f"before it into a QEMU {n} tree (PATCHES a directory of just "
            f"those), apply `{patch}` by hand and commit it, then the "
            f"rest; `./dev-series export DIR` writes `patches/` back, to "
            f"commit here.\n")
    s += (f"Carried over to {n} as CI's round trip checks it: "
          f"`./dev-series import` applied `patches/` to the verified "
          f"tarball's tree, and `./dev-series export` wrote it back. ")
    if not c["changed"]:
        return s + "That changed nothing: the patches are main's.\n"
    k = len(c["changed"])
    s += (f"That changed {k} patch{'es' if k != 1 else ''}, in this pull "
          f"request's second commit:\n\n"
          + "".join(f"- `{f}`\n" for f in c["changed"]) + "\n")
    if not c["other"]:
        return s + ("Only hunk headers and context lines changed: each "
                    "patch's DEP-3 header, the files it touches and the "
                    "lines it adds and removes are as they were.\n")
    # Fenced with four backticks, since a patch may hold three; and only
    # the first ten, to keep within a pull request body's size.
    shown = "".join(f"````diff\n{o}\n````\n\n" for o in c["other"][:10])
    if len(c["other"]) > 10:
        shown += f"... and {len(c['other']) - 10} more: see the second commit.\n"
    return s + (
        "**More than hunk headers and context lines changed**, which "
        "carrying the series over shouldn't do. Check these before "
        "merging:\n\n" + shown)


def body(kind, old, new, digest, c):
    o, n = fmt(old), fmt(new)
    if kind == "point":
        expect = ("A point release of the pinned series: the patches should "
                  "still apply.")
    else:
        expect = (f"A newer series: the patches will likely need porting to "
                  f"{new[0]}.{new[1]} before CI passes.")
    return (f"QEMU {n} is out; this pins it in place of {o}.\n\n{expect}\n\n"
            f"**This pull request's CI says whether the patch series still "
            f"applies to {n} and builds:** `./build` applies `patches/*.patch` "
            f"to the new tarball, and the builds boot the smoke test.\n\n"
            f"{series_section(c, new)}\n"
            f"## Upstream\n\n{changes(old, new)}\n"
            f"## The tarball\n\n{tarball_url(new)}, verified against its "
            f"`.sig` with QEMU's release key `{FINGERPRINT}` "
            f"(`qemu-release-key.asc`).\nSHA-256: `{digest}`\n\n"
            f"Opened by CI's `qemu-sync` job, which updates this pull request "
            f"when a newer release comes out. It is never merged automatically.\n")


def series_message(new, c):
    n = fmt(new)
    nums = ", ".join(f.split("-", 1)[0] for f in c["changed"])
    text = (f"The series as it applies to QEMU {n}: ./dev-series import of "
            f"patches/ into {n}'s tree, and ./dev-series export of it, as "
            f"CI's round trip does. It changes {nums}.")
    text += (" Only hunk headers and context lines changed." if not c["other"]
             else " More than hunk headers and context lines changed: see "
                  "the pull request.")
    return (f"patches: the series re-exported for QEMU {n}\n\n"
            f"{textwrap.fill(text, 72)}\n\n"
            f"Made by CI's qemu-sync job (./qemu-sync).\n")


def commit(msg):
    env = dict(os.environ, TZ="UTC")
    run("git", "-C", HERE, "-c", "user.name=github-actions[bot]",
        "-c", "user.email=41898282+github-actions[bot]@users.noreply.github.com",
        "commit", "-q", "--author", BOT, "-F", "-", input=msg, env=env)


def warn(text):
    """A warning in the log, and on the run's summary."""
    print(f"::warning::{text}" if os.environ.get("GITHUB_ACTIONS")
          else f"warning: {text}")
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a") as f:
            f.write(f"{text}\n\n")


def bump(kind, old, new, digest, tarball, base, dry, tmp):
    branch = BRANCHES[kind]
    n = fmt(new)
    r = repo()
    title = f"qemu-release: QEMU {n}"
    prs = gh_json("pr", "list", "-R", r, "--head", branch, "--state", "open",
                  "--json", "number,url")
    have = remote_version(branch)
    if prs and have == n:
        print(f"{kind}: {prs[0]['url']} already targets {n}; nothing to do")
        return
    c = carry(tarball, new, tmp)
    print(f"{kind}: {describe(c, new)}", flush=True)
    if c["failed"]:
        print(textwrap.indent(c["failed"], "  "), flush=True)
    two = not c["failed"] and c["changed"]
    if dry:
        verb = f"update {prs[0]['url']}" if prs else "open a pull request"
        print(f"{kind}: would force-push {branch} (main + "
              f"{'two commits' if two else 'one commit'}), {verb}: {title!r}")
        return
    if c["failed"]:
        warn(f"{kind}: {describe(c, new)}. The pull request keeps main's "
             f"patches/ and names the patch to port.")
    elif c["other"]:
        warn(f"{kind}: {describe(c, new)}")

    # Made again whenever there's no pull request yet, so that the branch
    # is what the body says.
    if have != n or not prs:
        run("git", "-C", HERE, "switch", "-q", "-C", branch, base)
        edit_files(old, new, digest)
        run("git", "-C", HERE, "add", "qemu-release", "README.md", FLATPAK_MANIFEST)
        commit(message(kind, old, new))
        if two:
            for f in os.listdir(PATCHES):
                if f.endswith(".patch"):
                    os.remove(os.path.join(PATCHES, f))
            for f in os.listdir(c["out"]):
                shutil.copyfile(os.path.join(c["out"], f), os.path.join(PATCHES, f))
            run("git", "-C", HERE, "add", "-A", "patches")
            commit(series_message(new, c))
        run("git", "-C", HERE, "push", "-q", "--force", "origin", f"HEAD:refs/heads/{branch}")
        run("git", "-C", HERE, "switch", "-q", "--detach", base)
        print(f"{kind}: pushed {branch} with {n}")

    text = body(kind, old, new, digest, c)
    if prs:
        run("gh", "pr", "edit", prs[0]["url"], "--title", title, "--body", text)
        print(f"{kind}: updated {prs[0]['url']}")
    else:
        c = run("gh", "pr", "create", "-R", r, "--base", "main", "--head", branch,
                "--title", title, "--body", text, check=False)
        if c.returncode != 0:
            url = f"https://github.com/{r}/compare/main...{branch}?expand=1"
            note = (f"{kind}: {branch} is pushed with QEMU {n}, but no pull "
                    f"request could be opened ({c.stderr.strip()}). Workflows "
                    f"may need permission to open them; until then, open it "
                    f"by hand: {url}")
            print(f"::warning::{note}")
            summary = os.environ.get("GITHUB_STEP_SUMMARY")
            if summary:
                with open(summary, "a") as f:
                    f.write(f"{note}\n\nIts body:\n\n{text}\n")
            return
        print(f"{kind}: opened {c.stdout.strip()}")
    # Pushes and pull requests made with GITHUB_TOKEN start no workflow:
    # CI is run on the branch by hand, and its checks show on the PR.
    if os.environ.get("GITHUB_ACTIONS"):
        run("gh", "workflow", "run", "ci.yml", "-R", r, "--ref", branch)
        print(f"{kind}: started CI on {branch}")


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--self-test", action="store_true")
    a = ap.parse_args()
    if a.self_test:
        return self_test()

    current = parse(pinned()["version"])
    vs = releases()
    print(f"pinned: {fmt(current)}; newest upstream: {fmt(max(vs))}; "
          f"newest of {current[0]}.{current[1]}: "
          f"{fmt(max(v for v in vs if v[:2] == current[:2]))}")
    plan = due(current, vs)
    if not plan:
        print("nothing due: the pin is the newest release")
        return
    base = run("git", "-C", HERE, "rev-parse", "HEAD").stdout.strip()
    with tempfile.TemporaryDirectory() as tmp:
        for kind, new in plan.items():
            if not published(tarball_url(new)) or not published(tarball_url(new) + ".sig"):
                print(f"{kind}: {fmt(new)} is tagged, but its tarball or "
                      f"signature isn't on {DOWNLOAD} yet; later")
                continue
            print(f"{kind}: {fmt(current)} -> {fmt(new)}")
            tarball, digest = fetch_verified(new, tmp)
            bump(kind, current, new, digest, tarball, base, a.dry_run, tmp)
            os.unlink(tarball)


if __name__ == "__main__":
    main()
