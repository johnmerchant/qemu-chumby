From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Fri, 30 Oct 2026 03:16:18 +1030
Subject: [PATCH 25/42] hw/gpio/imx21_gpio: Drive GPIO output lines

The Chumby Classic's sensor card on CSPI1 is selected by two GPIOs,
PD28 and PD27, which the stock driver (chumby_accel.c) drives by hand
through the port's data register; the card decodes them into its chip
selects. For a board to wire those up, give the GPIO block one output
line per pin, numbered like its inputs (port * 32 + pin), carrying the
pin's level: the data register for pins configured as outputs, the
level driven from outside for inputs. A line changes only when its
pin's level does, after a register write, an input change or a reset.

Signed-off-by: John Merchant <john@johnmerchant.dev>
Claude-Session: https://claude.ai/code/session_01B1fN5Fc77Z6fVVe4rWJxPT
---
 hw/gpio/imx21_gpio.c         | 30 +++++++++++++++++++++++++++++-
 include/hw/gpio/imx21_gpio.h |  1 +
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/hw/gpio/imx21_gpio.c b/hw/gpio/imx21_gpio.c
index 01f47249a..7289e015d 100644
--- a/hw/gpio/imx21_gpio.c
+++ b/hw/gpio/imx21_gpio.c
@@ -8,7 +8,8 @@
  * Six 32-pin ports, 0x100 apart, sharing one interrupt, with a port
  * interrupt mask (PMASK) at 0x600. This is the i.MX1-style GPIO, not the
  * i.MX31 one. Pins configured as inputs read the level driven on the
- * device's GPIO inputs, idling high (pulled up).
+ * device's GPIO inputs, idling high (pulled up). The GPIO outputs, one per
+ * pin and numbered like the inputs, follow each pin's level.
  */
 
 #include "qemu/osdep.h"
@@ -42,6 +43,21 @@ static uint32_t imx21_gpio_level(IMX21GPIOState *s, int port)
     return out | (s->pins[port] & ~dir);
 }
 
+/* Drives the GPIO outputs of the pins whose level changed from @old. */
+static void imx21_gpio_set_outputs(IMX21GPIOState *s, int port, uint32_t old)
+{
+    uint32_t level = imx21_gpio_level(s, port);
+    uint32_t changed = old ^ level;
+    int pin;
+
+    for (pin = 0; pin < IMX21_GPIO_PINS_PER_PORT; pin++) {
+        if (changed & (1u << pin)) {
+            qemu_set_irq(s->output[port * IMX21_GPIO_PINS_PER_PORT + pin],
+                         !!(level & (1u << pin)));
+        }
+    }
+}
+
 static int imx21_gpio_sense(IMX21GPIOState *s, int port, int pin)
 {
     return extract32(s->regs[port][ICR1 / 4 + pin / 16], (pin % 16) * 2, 2);
@@ -105,6 +121,7 @@ static void imx21_gpio_set(void *opaque, int line, int level)
     }
     imx21_gpio_latch_levels(s, port);
     imx21_gpio_update(s);
+    imx21_gpio_set_outputs(s, port, old);
 }
 
 static uint64_t imx21_gpio_read(void *opaque, hwaddr offset, unsigned size)
@@ -137,6 +154,7 @@ static void imx21_gpio_write(void *opaque, hwaddr offset, uint64_t val,
     IMX21GPIOState *s = opaque;
     int port = offset / 0x100;
     hwaddr reg = offset % 0x100;
+    uint32_t old;
 
     if (offset == PMASK) {
         s->pmask = val & 0x3f;
@@ -148,6 +166,7 @@ static void imx21_gpio_write(void *opaque, hwaddr offset, uint64_t val,
                       "\n", __func__, offset);
         return;
     }
+    old = imx21_gpio_level(s, port);
     switch (reg) {
     case ISR:
         s->isr[port] &= ~val;
@@ -160,6 +179,7 @@ static void imx21_gpio_write(void *opaque, hwaddr offset, uint64_t val,
     }
     imx21_gpio_latch_levels(s, port);
     imx21_gpio_update(s);
+    imx21_gpio_set_outputs(s, port, old);
 }
 
 static const MemoryRegionOps imx21_gpio_ops = {
@@ -175,8 +195,12 @@ static const MemoryRegionOps imx21_gpio_ops = {
 static void imx21_gpio_reset(DeviceState *dev)
 {
     IMX21GPIOState *s = IMX21_GPIO(dev);
+    uint32_t old[IMX21_GPIO_NUM_PORTS];
     int port;
 
+    for (port = 0; port < IMX21_GPIO_NUM_PORTS; port++) {
+        old[port] = imx21_gpio_level(s, port);
+    }
     memset(s->regs, 0, sizeof(s->regs));
     memset(s->isr, 0, sizeof(s->isr));
     for (port = 0; port < IMX21_GPIO_NUM_PORTS; port++) {
@@ -184,6 +208,9 @@ static void imx21_gpio_reset(DeviceState *dev)
     }
     s->pmask = 0x3f;
     imx21_gpio_update(s);
+    for (port = 0; port < IMX21_GPIO_NUM_PORTS; port++) {
+        imx21_gpio_set_outputs(s, port, old[port]);
+    }
 }
 
 static void imx21_gpio_init(Object *obj)
@@ -196,6 +223,7 @@ static void imx21_gpio_init(Object *obj)
     sysbus_init_mmio(sbd, &s->iomem);
     sysbus_init_irq(sbd, &s->irq);
     qdev_init_gpio_in(DEVICE(obj), imx21_gpio_set, IMX21_GPIO_NUM_PINS);
+    qdev_init_gpio_out(DEVICE(obj), s->output, IMX21_GPIO_NUM_PINS);
 }
 
 static const VMStateDescription vmstate_imx21_gpio = {
diff --git a/include/hw/gpio/imx21_gpio.h b/include/hw/gpio/imx21_gpio.h
index aa7a1ee72..83fb01bfe 100644
--- a/include/hw/gpio/imx21_gpio.h
+++ b/include/hw/gpio/imx21_gpio.h
@@ -25,6 +25,7 @@ struct IMX21GPIOState {
 
     MemoryRegion iomem;
     qemu_irq irq;
+    qemu_irq output[IMX21_GPIO_NUM_PINS];
 
     uint32_t regs[IMX21_GPIO_NUM_PORTS][IMX21_GPIO_NUM_REGS];
     uint32_t isr[IMX21_GPIO_NUM_PORTS];
