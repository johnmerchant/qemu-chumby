From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Fri, 30 Oct 2026 02:57:40 +1030
Subject: [PATCH 19/42] ui/input: Let a handler pass on events it does not take

An input event goes to one handler: the first one registered for its
kind. A device that wants one key from the keyboard (a board's button
bound to a host key, say) has to register a keyboard handler, which
then takes every key from the guest's real keyboard.

Add qemu_input_event_pass_on(), which hands an event to the handler
that would have had it if the caller were not registered, so such a
handler can sit in front of the keyboard and pass on the keys it does
not want.

Signed-off-by: John Merchant <john@johnmerchant.dev>
Claude-Session: https://claude.ai/code/session_01B1fN5Fc77Z6fVVe4rWJxPT
---
 include/ui/input.h |  6 ++++++
 ui/input.c         | 26 +++++++++++++++++++++++---
 2 files changed, 29 insertions(+), 3 deletions(-)

diff --git a/include/ui/input.h b/include/ui/input.h
index a1560cac0..5a574b5a1 100644
--- a/include/ui/input.h
+++ b/include/ui/input.h
@@ -56,6 +56,12 @@ void qemu_input_handler_bind(QemuInputHandlerState *s,
                              Error **errp);
 void qemu_input_event_send(QemuConsole *src, QemuInputEvent *evt);
 void qemu_input_event_send_impl(QemuConsole *src, QemuInputEvent *evt);
+/*
+ * Hands an event that a handler does not want to the handler that would
+ * get it if that one were not registered.
+ */
+void qemu_input_event_pass_on(QemuInputHandlerState *from,
+                              QemuConsole *src, QemuInputEvent *evt);
 void qemu_input_event_sync(void);
 void qemu_input_event_sync_impl(void);
 
diff --git a/ui/input.c b/ui/input.c
index b82622c86..0e9757132 100644
--- a/ui/input.c
+++ b/ui/input.c
@@ -111,12 +111,13 @@ void qemu_input_handler_bind(QemuInputHandlerState *s,
 }
 
 static QemuInputHandlerState*
-qemu_input_find_handler(uint32_t mask, const QemuConsole *con)
+qemu_input_find_handler_except(uint32_t mask, const QemuConsole *con,
+                               const QemuInputHandlerState *except)
 {
     QemuInputHandlerState *s;
 
     QTAILQ_FOREACH(s, &handlers, node) {
-        if (s->con == NULL || s->con != con) {
+        if (s->con == NULL || s->con != con || s == except) {
             continue;
         }
         if (mask & s->handler->mask) {
@@ -125,7 +126,7 @@ qemu_input_find_handler(uint32_t mask, const QemuConsole *con)
     }
 
     QTAILQ_FOREACH(s, &handlers, node) {
-        if (s->con != NULL) {
+        if (s->con != NULL || s == except) {
             continue;
         }
         if (mask & s->handler->mask) {
@@ -135,6 +136,12 @@ qemu_input_find_handler(uint32_t mask, const QemuConsole *con)
     return NULL;
 }
 
+static QemuInputHandlerState*
+qemu_input_find_handler(uint32_t mask, const QemuConsole *con)
+{
+    return qemu_input_find_handler_except(mask, con, NULL);
+}
+
 void qemu_input_handler_set_leds_mask(QemuInputHandlerState *s, uint32_t leds_mask)
 {
     assert(s->handler->mask & INPUT_EVENT_MASK_KEY);
@@ -356,6 +363,19 @@ void qemu_input_event_send_impl(QemuConsole *src, QemuInputEvent *evt)
     s->events++;
 }
 
+void qemu_input_event_pass_on(QemuInputHandlerState *from,
+                              QemuConsole *src, QemuInputEvent *evt)
+{
+    QemuInputHandlerState *s;
+
+    s = qemu_input_find_handler_except(1 << evt->type, src, from);
+    if (!s) {
+        return;
+    }
+    s->handler->event(s->dev, src, evt);
+    s->events++;
+}
+
 void qemu_input_event_send(QemuConsole *src, QemuInputEvent *evt)
 {
     if (evt->type == INPUT_EVENT_KIND_KEY && !evt->key.key) {
