+/*
+ * Chumby Classic board controls
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The board-level lines around the i.MX21 that a user sees or handles,
+ * as the stock kernel's sense1 driver uses them:
+ *
+ * - the LCD backlight, driven by the PWM's duty cycle (the driver writes
+ *   samples of 700 to 0xffff), and the panel's power, keypad column 2;
+ *   together they set how bright the LCD controller's output is drawn,
+ *   from black (off) to full. Until the PWM is first programmed the
+ *   backlight is full, so kernels without a backlight driver show their
+ *   screen.
+ * - the speaker amplifier's mute, keypad column 4, high to mute.
+ * - the headphone jack's detect switch, keypad row 3, low while
+ *   headphones are plugged in: the "headphones" property.
+ * - the top button, keypad row 0, low while pressed: the "button"
+ *   property, and a key ("button-key", a QKeyCode name) that holds the
+ *   button while it is down. Other keys pass on to the next keyboard.
+ * - a USB keyboard, plugged into the USB host's root hub when a key is
+ *   pressed that no keyboard takes ("usb-keyboard", on by default), as a
+ *   user would plug one in to type. The keys are held until the guest has
+ *   set the keyboard up, then typed into it.
+ *
+ * Changes are reported as QMP events and query-chumby-state returns the
+ * lot; see qapi/chumby.json.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/chumby_io.h"
+#include "hw/core/irq.h"
+#include "hw/usb/usb.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-chumby.h"
+#include "qapi/qapi-events-chumby.h"
+#include "qapi/qapi-types-ui.h"
+#include "qapi/util.h"
+#include "qemu/main-loop.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "system/reset.h"
+#include "system/system.h"
+#include "trace.h"
+
+static void chumby_io_update_lcd(ChumbyIOState *s)
+{
+    qemu_set_irq(s->lcd_brightness, s->lcd_on ? s->backlight : 0);
+}
+
+static void chumby_io_set_backlight(void *opaque, int n, int level)
+{
+    ChumbyIOState *s = opaque;
+    uint32_t backlight = MIN(MAX(level, 0), CHUMBY_IO_BACKLIGHT_MAX);
+
+    if (backlight != s->backlight) {
+        trace_chumby_io_backlight(backlight);
+        s->backlight = backlight;
+        chumby_io_update_lcd(s);
+        qapi_event_send_chumby_backlight(backlight);
+    }
+}
+
+static void chumby_io_set_lcd_power(void *opaque, int n, int level)
+{
+    ChumbyIOState *s = opaque;
+
+    if (!!level != s->lcd_on) {
+        trace_chumby_io_lcd(!!level);
+        s->lcd_on = level;
+        chumby_io_update_lcd(s);
+        qapi_event_send_chumby_lcd(s->lcd_on);
+    }
+}
+
+static void chumby_io_set_amp_mute(void *opaque, int n, int level)
+{
+    ChumbyIOState *s = opaque;
+
+    if (!!level != s->speaker_mute) {
+        trace_chumby_io_speaker_mute(!!level);
+        s->speaker_mute = level;
+        qemu_set_irq(s->speaker_mute_out, s->speaker_mute);
+        qapi_event_send_chumby_speaker_mute(s->speaker_mute);
+    }
+}
+
+static void chumby_io_update_button(ChumbyIOState *s)
+{
+    qemu_set_irq(s->button_n, !s->button);
+}
+
+static void chumby_io_update_headphones(ChumbyIOState *s)
+{
+    qemu_set_irq(s->headphones_n, !s->headphones);
+    qemu_set_irq(s->headphones_out, s->headphones);
+}
+
+static void chumby_io_press_button(ChumbyIOState *s, bool pressed)
+{
+    if (pressed != s->button) {
+        trace_chumby_io_button(pressed);
+        s->button = pressed;
+        chumby_io_update_button(s);
+    }
+}
+
+/*
+ * How often to look for the guest having configured a plugged-in
+ * keyboard, how long to wait before typing the held keys anyway, and how
+ * long its driver gets after the configuration to open the keyboard.
+ * The held keys are then typed one every poll: the keyboard queues only
+ * 16 key changes.
+ */
+#define CHUMBY_IO_KBD_POLL_MS    20
+#define CHUMBY_IO_KBD_TIMEOUT_MS 10000
+#define CHUMBY_IO_KBD_SETTLE_MS  500
+
+static void chumby_io_kbd_hold(ChumbyIOState *s, QemuInputEvent *evt)
+{
+    if (s->kbd_nkeys < CHUMBY_IO_KBD_KEYS) {
+        s->kbd_keys[s->kbd_nkeys].key = evt->key.key;
+        s->kbd_keys[s->kbd_nkeys].down = evt->key.down;
+        s->kbd_nkeys++;
+    }
+}
+
+/* Plugs in the keyboard, behind the button's key. */
+static bool chumby_io_kbd_attach(ChumbyIOState *s)
+{
+    Object *bus = object_resolve_path_type("", TYPE_USB_BUS, NULL);
+    USBDevice *kbd;
+    Error *err = NULL;
+
+    if (!bus || !object_class_by_name("usb-kbd")) {
+        warn_report("chumby-io: no USB bus or usb-kbd to plug a keyboard "
+                    "into");
+        return false;
+    }
+    kbd = USB_DEVICE(qdev_new("usb-kbd"));
+    if (!usb_realize_and_unref(kbd, USB_BUS(bus), &err)) {
+        warn_reportf_err(err, "chumby-io: plugging in a keyboard: ");
+        return false;
+    }
+    trace_chumby_io_keyboard_plug(kbd->port ? kbd->port->path : "?");
+    s->kbd = kbd;
+    /* The keyboard put its handler first: the button's key comes first */
+    qemu_input_handler_activate(s->key_handler);
+    return true;
+}
+
+static void chumby_io_kbd_plug(void *opaque)
+{
+    ChumbyIOState *s = opaque;
+
+    if (s->kbd) {
+        return;
+    }
+    if (!chumby_io_kbd_attach(s)) {
+        goto fail;
+    }
+    s->kbd_deadline = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                      CHUMBY_IO_KBD_TIMEOUT_MS;
+    timer_mod(s->kbd_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                            CHUMBY_IO_KBD_POLL_MS);
+    return;
+
+fail:
+    s->usb_keyboard = false;
+    s->kbd_nkeys = 0;
+}
+
+/*
+ * The port's reset empties the keyboard's queue: type the held keys once
+ * the guest has configured it and its driver has had time to open it.
+ * Keys pressed meanwhile are held behind them.
+ */
+static void chumby_io_kbd_poll(void *opaque)
+{
+    ChumbyIOState *s = opaque;
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+    QemuInputEvent evt = { .type = INPUT_EVENT_KIND_KEY };
+
+    if (!s->kbd_settled) {
+        if (!s->kbd->configuration && now < s->kbd_deadline) {
+            timer_mod(s->kbd_timer, now + CHUMBY_IO_KBD_POLL_MS);
+            return;
+        }
+        trace_chumby_io_keyboard_ready(s->kbd->configuration, s->kbd_nkeys);
+        s->kbd_settled = true;
+        timer_mod(s->kbd_timer, now + CHUMBY_IO_KBD_SETTLE_MS);
+        return;
+    }
+    if (s->kbd_next < s->kbd_nkeys) {
+        evt.key.key = s->kbd_keys[s->kbd_next].key;
+        evt.key.down = s->kbd_keys[s->kbd_next].down;
+        s->kbd_next++;
+        qemu_input_event_pass_on(s->key_handler, NULL, &evt);
+        qemu_input_event_sync();
+        timer_mod(s->kbd_timer, now + CHUMBY_IO_KBD_POLL_MS);
+        return;
+    }
+    s->kbd_ready = true;
+    s->kbd_nkeys = 0;
+    s->kbd_next = 0;
+}
+
+static void chumby_io_key_event(DeviceState *dev, QemuConsole *src,
+                                QemuInputEvent *evt)
+{
+    ChumbyIOState *s = CHUMBY_IO(dev);
+
+    if (evt->type == INPUT_EVENT_KIND_KEY &&
+        qemu_input_linux_to_qcode(evt->key.key) == s->button_qcode) {
+        chumby_io_press_button(s, evt->key.down);
+        return;
+    }
+    if (evt->type == INPUT_EVENT_KIND_KEY && s->kbd && !s->kbd_ready) {
+        chumby_io_kbd_hold(s, evt);
+        return;
+    }
+    if (qemu_input_event_pass_on(s->key_handler, src, evt) ||
+        evt->type != INPUT_EVENT_KIND_KEY || !s->usb_keyboard || s->kbd) {
+        return;
+    }
+    /* No keyboard took the key: plug one in, once a key goes down */
+    if (evt->key.down || s->kbd_nkeys) {
+        chumby_io_kbd_hold(s, evt);
+        qemu_bh_schedule(s->kbd_bh);
+    }
+}
+
+static const QemuInputHandler chumby_io_key_handler = {
+    .name = "Chumby top button",
+    .mask = INPUT_EVENT_MASK_KEY,
+    .event = chumby_io_key_event,
+};
+
+/*
+ * A handler while a key is bound or a keyboard may be plugged in, ahead
+ * of any keyboard.
+ */
+static void chumby_io_update_key_handler(ChumbyIOState *s)
+{
+    bool want = s->button_qcode >= 0 || s->usb_keyboard;
+
+    if (want && !s->key_handler) {
+        s->key_handler = qemu_input_handler_register(DEVICE(s),
+                                                     &chumby_io_key_handler);
+        qemu_input_handler_activate(s->key_handler);
+    } else if (!want && s->key_handler) {
+        qemu_input_handler_unregister(s->key_handler);
+        s->key_handler = NULL;
+    }
+}
+
+static bool chumby_io_get_button(Object *obj, Error **errp)
+{
+    return CHUMBY_IO(obj)->button;
+}
+
+static void chumby_io_set_button(Object *obj, bool value, Error **errp)
+{
+    chumby_io_press_button(CHUMBY_IO(obj), value);
+}
+
+static bool chumby_io_get_headphones(Object *obj, Error **errp)
+{
+    return CHUMBY_IO(obj)->headphones;
+}
+
+static void chumby_io_set_headphones(Object *obj, bool value, Error **errp)
+{
+    ChumbyIOState *s = CHUMBY_IO(obj);
+
+    if (value != s->headphones) {
+        trace_chumby_io_headphones(value);
+        s->headphones = value;
+        chumby_io_update_headphones(s);
+        qapi_event_send_chumby_headphones(value);
+    }
+}
+
+static char *chumby_io_get_button_key(Object *obj, Error **errp)
+{
+    return g_strdup(CHUMBY_IO(obj)->button_key);
+}
+
+static void chumby_io_set_button_key(Object *obj, const char *value,
+                                     Error **errp)
+{
+    ChumbyIOState *s = CHUMBY_IO(obj);
+    int qcode = -1;
+
+    if (*value && strcmp(value, "none")) {
+        qcode = qapi_enum_parse(&QKeyCode_lookup, value, -1, errp);
+        if (qcode < 0) {
+            return;
+        }
+    }
+    if (s->button && qcode != s->button_qcode) {
+        chumby_io_press_button(s, false);
+    }
+    g_free(s->button_key);
+    s->button_key = g_strdup(qcode < 0 ? "none" : value);
+    s->button_qcode = qcode;
+    if (DEVICE(s)->realized) {
+        chumby_io_update_key_handler(s);
+    }
+}
+
+static bool chumby_io_get_usb_keyboard(Object *obj, Error **errp)
+{
+    return CHUMBY_IO(obj)->usb_keyboard;
+}
+
+static void chumby_io_set_usb_keyboard(Object *obj, bool value, Error **errp)
+{
+    ChumbyIOState *s = CHUMBY_IO(obj);
+
+    s->usb_keyboard = value;
+    if (DEVICE(s)->realized) {
+        chumby_io_update_key_handler(s);
+    }
+}
+
+ChumbyState *qmp_query_chumby_state(Error **errp)
+{
+    ChumbyIOState *s;
+    ChumbyState *info;
+    Object *machine;
+    Error *err = NULL;
+
+    s = CHUMBY_IO(object_resolve_path_type("", TYPE_CHUMBY_IO, NULL));
+    if (!s) {
+        error_setg(errp, "This machine has no Chumby board");
+        return NULL;
+    }
+    info = g_new0(ChumbyState, 1);
+    info->backlight = s->backlight;
+    info->lcd_on = s->lcd_on;
+    info->speaker_mute = s->speaker_mute;
+    info->headphones = s->headphones;
+    info->button = s->button;
+
+    /* The rest is the machine's, which reads the acceleration from the part */
+    machine = qdev_get_machine();
+    info->accel_x = object_property_get_int(machine, "accel-x", &err);
+    if (!err) {
+        info->accel_y = object_property_get_int(machine, "accel-y", &err);
+    }
+    if (!err) {
+        info->accel_z = object_property_get_int(machine, "accel-z", &err);
+    }
+    if (!err) {
+        info->guid = object_property_get_str(machine, "guid", &err);
+    }
+    if (!err) {
+        info->serial = object_property_get_str(machine, "serial", &err);
+    }
+    if (!err) {
+        info->hwversion = object_property_get_str(machine, "hwversion", &err);
+    }
+    if (err) {
+        error_propagate(errp, err);
+        qapi_free_ChumbyState(info);
+        return NULL;
+    }
+    return info;
+}
+
+static void chumby_io_reset(DeviceState *dev)
+{
+    ChumbyIOState *s = CHUMBY_IO(dev);
+
+    /*
+     * The PWM is not programmed yet: the backlight is full. The panel's
+     * power and the amplifier's mute follow the keypad port's pins, which
+     * idle high.
+     */
+    chumby_io_set_backlight(s, 0, CHUMBY_IO_BACKLIGHT_MAX);
+    chumby_io_update_lcd(s);
+    qemu_set_irq(s->speaker_mute_out, s->speaker_mute);
+    chumby_io_update_button(s);
+    chumby_io_update_headphones(s);
+}
+
+/*
+ * A keyboard given with -device puts its handler first when it is
+ * created, after the machine: put the button's key back in front.
+ */
+static void chumby_io_machine_done(Notifier *notifier, void *data)
+{
+    ChumbyIOState *s = container_of(notifier, ChumbyIOState, machine_done);
+
+    if (s->key_handler) {
+        qemu_input_handler_activate(s->key_handler);
+    }
+}
+
+static void chumby_io_realize(DeviceState *dev, Error **errp)
+{
+    ChumbyIOState *s = CHUMBY_IO(dev);
+
+    s->kbd_bh = qemu_bh_new(chumby_io_kbd_plug, s);
+    s->kbd_timer = timer_new_ms(QEMU_CLOCK_VIRTUAL, chumby_io_kbd_poll, s);
+    chumby_io_update_key_handler(s);
+    s->machine_done.notify = chumby_io_machine_done;
+    qemu_add_machine_init_done_notifier(&s->machine_done);
+    qemu_register_resettable(OBJECT(dev));
+}
+
+static void chumby_io_unrealize(DeviceState *dev)
+{
+    ChumbyIOState *s = CHUMBY_IO(dev);
+
+    qemu_unregister_resettable(OBJECT(dev));
+    qemu_remove_machine_init_done_notifier(&s->machine_done);
+    if (s->key_handler) {
+        qemu_input_handler_unregister(s->key_handler);
+        s->key_handler = NULL;
+    }
+    timer_free(s->kbd_timer);
+    qemu_bh_delete(s->kbd_bh);
+}
+
+static void chumby_io_init(Object *obj)
+{
+    ChumbyIOState *s = CHUMBY_IO(obj);
+    DeviceState *dev = DEVICE(obj);
+
+    qdev_init_gpio_in_named(dev, chumby_io_set_backlight,
+                            CHUMBY_IO_BACKLIGHT, 1);
+    qdev_init_gpio_in_named(dev, chumby_io_set_lcd_power,
+                            CHUMBY_IO_LCD_POWER, 1);
+    qdev_init_gpio_in_named(dev, chumby_io_set_amp_mute,
+                            CHUMBY_IO_AMP_MUTE, 1);
+    qdev_init_gpio_out_named(dev, &s->lcd_brightness,
+                             CHUMBY_IO_LCD_BRIGHTNESS, 1);
+    qdev_init_gpio_out_named(dev, &s->button_n, CHUMBY_IO_BUTTON_N, 1);
+    qdev_init_gpio_out_named(dev, &s->headphones_n,
+                             CHUMBY_IO_HEADPHONES_N, 1);
+    qdev_init_gpio_out_named(dev, &s->speaker_mute_out,
+                             CHUMBY_IO_SPEAKER_MUTE, 1);
+    qdev_init_gpio_out_named(dev, &s->headphones_out,
+                             CHUMBY_IO_HEADPHONES, 1);
+
+    /* The lines' levels at power on, as the pins idle */
+    s->backlight = CHUMBY_IO_BACKLIGHT_MAX;
+    s->lcd_on = true;
+    s->speaker_mute = true;
+    s->button_key = g_strdup("f12");
+    s->button_qcode = Q_KEY_CODE_F12;
+    s->usb_keyboard = true;
+}
+
+static void chumby_io_finalize(Object *obj)
+{
+    g_free(CHUMBY_IO(obj)->button_key);
+}
+
+static bool chumby_io_kbd_needed(void *opaque)
+{
+    return CHUMBY_IO(opaque)->kbd;
+}
+
+/*
+ * The keyboard was plugged in when the state was saved: plug it in here
+ * too, before its own state, which comes later in the stream, is loaded.
+ */
+static int chumby_io_kbd_post_load(void *opaque, int version_id)
+{
+    ChumbyIOState *s = opaque;
+
+    if (s->kbd_nkeys < 0 || s->kbd_nkeys > CHUMBY_IO_KBD_KEYS ||
+        s->kbd_next < 0 || s->kbd_next > s->kbd_nkeys) {
+        return -EINVAL;
+    }
+    if (!s->kbd && !chumby_io_kbd_attach(s)) {
+        return -ENODEV;
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_chumby_io_kbd_key = {
+    .name = TYPE_CHUMBY_IO "/keyboard/key",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(key, ChumbyIOKbdKey),
+        VMSTATE_BOOL(down, ChumbyIOKbdKey),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const VMStateDescription vmstate_chumby_io_kbd = {
+    .name = TYPE_CHUMBY_IO "/keyboard",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = chumby_io_kbd_needed,
+    .post_load = chumby_io_kbd_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(kbd_settled, ChumbyIOState),
+        VMSTATE_BOOL(kbd_ready, ChumbyIOState),
+        VMSTATE_TIMER_PTR(kbd_timer, ChumbyIOState),
+        VMSTATE_INT64(kbd_deadline, ChumbyIOState),
+        VMSTATE_STRUCT_ARRAY(kbd_keys, ChumbyIOState, CHUMBY_IO_KBD_KEYS, 1,
+                             vmstate_chumby_io_kbd_key, ChumbyIOKbdKey),
+        VMSTATE_INT32(kbd_nkeys, ChumbyIOState),
+        VMSTATE_INT32(kbd_next, ChumbyIOState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const VMStateDescription vmstate_chumby_io = {
+    .name = TYPE_CHUMBY_IO,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(backlight, ChumbyIOState),
+        VMSTATE_BOOL(lcd_on, ChumbyIOState),
+        VMSTATE_BOOL(speaker_mute, ChumbyIOState),
+        VMSTATE_BOOL(button, ChumbyIOState),
+        VMSTATE_BOOL(headphones, ChumbyIOState),
+        VMSTATE_END_OF_LIST()
+    },
+    .subsections = (const VMStateDescription * const []) {
+        &vmstate_chumby_io_kbd,
+        NULL
+    },
+};
+
+static void chumby_io_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = chumby_io_realize;
+    dc->unrealize = chumby_io_unrealize;
+    dc->vmsd = &vmstate_chumby_io;
+    device_class_set_legacy_reset(dc, chumby_io_reset);
+    dc->desc = "Chumby Classic board controls";
+    /* Part of the chumby-classic machine */
+    dc->user_creatable = false;
+
+    object_class_property_add_bool(klass, "button", chumby_io_get_button,
+                                   chumby_io_set_button);
+    object_class_property_set_description(klass, "button",
+        "The top button: true while pressed");
+    object_class_property_add_bool(klass, "headphones",
+                                   chumby_io_get_headphones,
+                                   chumby_io_set_headphones);
+    object_class_property_set_description(klass, "headphones",
+        "Headphones: true while plugged in");
+    object_class_property_add_str(klass, "button-key",
+                                  chumby_io_get_button_key,
+                                  chumby_io_set_button_key);
+    object_class_property_set_description(klass, "button-key",
+        "The key (a QKeyCode name, or none) that holds the top button "
+        "while it is down; default f12");
+    object_class_property_add_bool(klass, "usb-keyboard",
+                                   chumby_io_get_usb_keyboard,
+                                   chumby_io_set_usb_keyboard);
+    object_class_property_set_description(klass, "usb-keyboard",
+        "Plug a USB keyboard in when a key is pressed that no keyboard "
+        "takes; default on");
+}
+
+static const TypeInfo chumby_io_info = {
+    .name = TYPE_CHUMBY_IO,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(ChumbyIOState),
+    .instance_init = chumby_io_init,
+    .instance_finalize = chumby_io_finalize,
+    .class_init = chumby_io_class_init,
+};
+
+static void chumby_io_register_types(void)
+{
+    type_register_static(&chumby_io_info);
+}
+
+type_init(chumby_io_register_types)
