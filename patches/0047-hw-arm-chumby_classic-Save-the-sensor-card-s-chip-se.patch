From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Fri, 30 Oct 2026 12:43:35 +0000
Subject: [PATCH 47/52] hw/arm/chumby_classic: Save the sensor card's chip
 select

The board decodes CSPI1's two select GPIOs into the sensor card's chip
selects, and kept the decoded SS1:SS0 only in the machine. A restore
reset it to idle while the GPIO controller and the parts kept their
saved state, so the next change of one line decoded wrongly: with the
DC ID EEPROM selected (1), lowering SS0 selected the accelerometer
instead of nothing.

A machine is not a device and has no vmsd, so the board registers a
small VMState of its own, "chumby-classic", for the decoder. The parts'
own state says whether each is selected, so the decoder's outputs are
not driven again on load. A value of 4 or more is refused.

A state saved before this has no such section and still loads, with the
decoder idle.

Signed-off-by: John Merchant <john@johnmerchant.dev>
Claude-Session: https://claude.ai/code/session_01B1fN5Fc77Z6fVVe4rWJxPT
---
 hw/arm/chumby_classic.c | 30 +++++++++++++++++++++++++++++-
 1 file changed, 29 insertions(+), 1 deletion(-)

diff --git a/hw/arm/chumby_classic.c b/hw/arm/chumby_classic.c
index 597be2424..b36a79fd8 100644
--- a/hw/arm/chumby_classic.c
+++ b/hw/arm/chumby_classic.c
@@ -54,6 +54,7 @@
 #include "hw/nvram/at25080a.h"
 #include "hw/sensor/kxp74.h"
 #include "hw/ssi/ssi.h"
+#include "migration/vmstate.h"
 #include "qemu/cutils.h"
 #include "qemu/uuid.h"
 #include "qemu/units.h"
@@ -135,7 +136,7 @@ struct ChumbyClassicState {
     int32_t accel_mg[KXP74_AXES];
 
     /* The sensor card's chip-select decoder: SS1:SS0, and its outputs */
-    unsigned sensor_sel;
+    uint32_t sensor_sel;
     qemu_irq sensor_cs[CHUMBY_SENSOR_NUM_CS];
 };
 
@@ -300,6 +301,32 @@ static void chumby_classic_sensor_select(void *opaque, int n, int level)
     }
 }
 
+static int chumby_classic_post_load(void *opaque, int version_id)
+{
+    ChumbyClassicState *s = opaque;
+
+    /*
+     * Each part's own state says whether it is selected, so the decoder's
+     * outputs need not be driven again.
+     */
+    return s->sensor_sel < CHUMBY_SENSOR_NUM_CS ? 0 : -EINVAL;
+}
+
+/*
+ * The board's own state, outside its devices. A machine is not a device,
+ * so this is registered by itself.
+ */
+static const VMStateDescription vmstate_chumby_classic = {
+    .name = "chumby-classic",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = chumby_classic_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(sensor_sel, ChumbyClassicState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
 /* Appends a DC ID tag header to @buf. */
 static void chumby_dcid_tag(GByteArray *buf, const char *name, int len,
                             bool parent)
@@ -378,6 +405,7 @@ static void chumby_classic_init_sensors(ChumbyClassicState *s)
                           qemu_allocate_irq(chumby_classic_sensor_select,
                                             s, 1));
     chumby_classic_sensor_select(s, 0, 1);
+    vmstate_register(NULL, 0, &vmstate_chumby_classic, s);
 }
 
 static void chumby_classic_init(MachineState *machine)
