From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Fri, 30 Oct 2026 03:16:26 +1030
Subject: [PATCH 26/42] hw/ssi/imx21_cspi: Add a bytewise transfer mode

The CSPI hands each word of a burst to the SSI bus as one transfer, which
suits a word-oriented peripheral like the TSC2100. The parts on the
Chumby Classic's sensor card are byte-oriented, and the stock driver
(chumby_accel.c) talks to them with 8, 16 and 32-bit words: a 16-bit
word is a command byte and a data byte, a 32-bit EEPROM read is the
opcode, two address bytes and the data byte. On the wire that is a
stream of bytes, most significant first.

Add a "bytewise" property, off by default: when set, each word goes to
the bus as its bytes, MSB first, and the bytes received make up the
word read back. Its width is the control register's bit count, rounded
up to whole bytes.

Signed-off-by: John Merchant <john@johnmerchant.dev>
Claude-Session: https://claude.ai/code/session_01B1fN5Fc77Z6fVVe4rWJxPT
---
 hw/ssi/imx21_cspi.c         | 28 +++++++++++++++++++++++++++-
 include/hw/ssi/imx21_cspi.h |  1 +
 2 files changed, 28 insertions(+), 1 deletion(-)

diff --git a/hw/ssi/imx21_cspi.c b/hw/ssi/imx21_cspi.c
index ab394c056..f510f9dbb 100644
--- a/hw/ssi/imx21_cspi.c
+++ b/hw/ssi/imx21_cspi.c
@@ -10,11 +10,16 @@
  * FIFO at once, as one chip-select frame, and the replies land in the
  * receive FIFO. This is the older CSPI, not the i.MX6 ECSPI; only one
  * chip select is wired, and DMA is not modelled.
+ *
+ * Each word goes to the bus as one transfer, unless "bytewise" is set:
+ * then it goes as its bytes, most significant first, which is what a
+ * byte-oriented peripheral sees on the wire.
  */
 
 #include "qemu/osdep.h"
 #include "hw/ssi/imx21_cspi.h"
 #include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
 #include "migration/vmstate.h"
 #include "qemu/log.h"
 #include "qemu/module.h"
@@ -79,6 +84,21 @@ static void imx21_cspi_update_irq(IMX21CSPIState *s)
                  !!(imx21_cspi_status(s) & (s->int_en >> INT_EN_SHIFT)));
 }
 
+static uint32_t imx21_cspi_transfer(IMX21CSPIState *s, uint32_t tx,
+                                    uint32_t bits)
+{
+    uint32_t rx = 0;
+    int i;
+
+    if (!s->bytewise) {
+        return ssi_transfer(s->bus, tx);
+    }
+    for (i = DIV_ROUND_UP(bits, 8) - 1; i >= 0; i--) {
+        rx = (rx << 8) | (ssi_transfer(s->bus, (tx >> (i * 8)) & 0xff) & 0xff);
+    }
+    return rx;
+}
+
 static void imx21_cspi_exchange(IMX21CSPIState *s)
 {
     uint32_t bits = (s->ctrl & CONTROL_BITCOUNT) + 1;
@@ -86,7 +106,8 @@ static void imx21_cspi_exchange(IMX21CSPIState *s)
 
     qemu_set_irq(s->cs_lines[0], 0);
     while (!fifo32_is_empty(&s->tx_fifo)) {
-        uint32_t rx = ssi_transfer(s->bus, fifo32_pop(&s->tx_fifo) & mask);
+        uint32_t rx = imx21_cspi_transfer(s, fifo32_pop(&s->tx_fifo) & mask,
+                                          bits);
 
         if (fifo32_is_full(&s->rx_fifo)) {
             s->overflow = true;
@@ -246,11 +267,16 @@ static const VMStateDescription vmstate_imx21_cspi = {
     },
 };
 
+static const Property imx21_cspi_properties[] = {
+    DEFINE_PROP_BOOL("bytewise", IMX21CSPIState, bytewise, false),
+};
+
 static void imx21_cspi_class_init(ObjectClass *klass, const void *data)
 {
     DeviceClass *dc = DEVICE_CLASS(klass);
 
     dc->realize = imx21_cspi_realize;
+    device_class_set_props(dc, imx21_cspi_properties);
     dc->vmsd = &vmstate_imx21_cspi;
     device_class_set_legacy_reset(dc, imx21_cspi_reset);
     dc->desc = "i.MX21 CSPI";
diff --git a/include/hw/ssi/imx21_cspi.h b/include/hw/ssi/imx21_cspi.h
index 7eeb221f6..ba69037a2 100644
--- a/include/hw/ssi/imx21_cspi.h
+++ b/include/hw/ssi/imx21_cspi.h
@@ -27,6 +27,7 @@ struct IMX21CSPIState {
     qemu_irq irq;
     qemu_irq cs_lines[IMX21_CSPI_NUM_CS];
     SSIBus *bus;
+    bool bytewise;
 
     Fifo32 tx_fifo;
     Fifo32 rx_fifo;
