diff --git a/include/hw/misc/imx21_crm.h b/include/hw/misc/imx21_crm.h
new file mode 100644
index 000000000..b204e4b20
--- /dev/null
+++ b/include/hw/misc/imx21_crm.h
@@ -0,0 +1,28 @@
+/*
+ * i.MX21 clock and reset module (CRM) and system control registers
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_CRM_H
+#define IMX21_CRM_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_CRM "imx21.crm"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21CRMState, IMX21_CRM)
+
+#define IMX21_CRM_NUM_REGS 0x40
+
+struct IMX21CRMState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    uint32_t crm[IMX21_CRM_NUM_REGS];
+    uint32_t sys[IMX21_CRM_NUM_REGS];
+};
+
+#endif /* IMX21_CRM_H */
