From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Wed, 28 Oct 2026 13:12:20 +0000
Subject: [PATCH 03/11] hw/misc: Add i.MX21 CRM, PWM and USB OTG register
 models

The clock and reset module with the system control registers beside
it, its PLLs always locked at a boot loader's settings; the PWM, whose
sample FIFO always has room; and the USB OTG block's control registers
with a host root hub of three empty ports, enough for Linux's drivers
to probe.

Signed-off-by: John Merchant <john@johnmerchant.dev>
---
 hw/misc/imx21_crm.c         | 151 ++++++++++++++++++++++++++++++++++++
 hw/misc/imx21_pwm.c         | 130 +++++++++++++++++++++++++++++++
 hw/misc/imx21_usbotg.c      | 145 ++++++++++++++++++++++++++++++++++
 hw/misc/meson.build         |   1 +
 include/hw/misc/imx21_crm.h |  28 +++++++
 5 files changed, 455 insertions(+)
 create mode 100644 hw/misc/imx21_crm.c
 create mode 100644 hw/misc/imx21_pwm.c
 create mode 100644 hw/misc/imx21_usbotg.c
 create mode 100644 include/hw/misc/imx21_crm.h

diff --git a/hw/misc/imx21_crm.c b/hw/misc/imx21_crm.c
new file mode 100644
index 000000000..7b41973b3
--- /dev/null
+++ b/hw/misc/imx21_crm.c
@@ -0,0 +1,151 @@
+/*
+ * i.MX21 clock and reset module (CRM) and system control registers
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The CRM at 0x10027000 and the system control block beside it at
+ * 0x10027800. The PLLs are always locked, and the registers start as a
+ * boot loader leaves them: MPLL 266 MHz from the 26 MHz oscillator, HCLK
+ * 133 MHz, PERCLK1-4 44.3 MHz, SPLL 288 MHz. Other registers read back
+ * what was written.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/imx21_crm.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+#define CSCR        0x00
+#define MPCTL0      0x04
+#define MPCTL1      0x08
+#define SPCTL0      0x0c
+#define SPCTL1      0x10
+#define OSC26MCTL   0x14
+#define PCDR0       0x18
+#define PCDR1       0x1c
+#define PCCR0       0x20
+#define PCCR1       0x24
+
+#define PLL_LOCKED  (1 << 15)
+
+#define SYS_OFFSET  0x800
+#define SIDR        0x04
+#define FMCR        0x14
+
+static uint64_t imx21_crm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX21CRMState *s = opaque;
+    unsigned i = (offset & 0x7ff) / 4;
+
+    if (i >= IMX21_CRM_NUM_REGS) {
+        qemu_log_mask(LOG_UNIMP, "%s: unmodelled register 0x%" HWADDR_PRIx
+                      "\n", __func__, offset);
+        return 0;
+    }
+    return offset >= SYS_OFFSET ? s->sys[i] : s->crm[i];
+}
+
+static void imx21_crm_write(void *opaque, hwaddr offset, uint64_t val,
+                            unsigned size)
+{
+    IMX21CRMState *s = opaque;
+    unsigned i = (offset & 0x7ff) / 4;
+
+    if (i >= IMX21_CRM_NUM_REGS) {
+        qemu_log_mask(LOG_UNIMP, "%s: unmodelled register 0x%" HWADDR_PRIx
+                      "\n", __func__, offset);
+        return;
+    }
+    if (offset >= SYS_OFFSET) {
+        if (offset - SYS_OFFSET != SIDR) {
+            s->sys[i] = val;
+        }
+        return;
+    }
+    switch (offset) {
+    case MPCTL1:
+    case SPCTL1:
+        /* The PLLs lock at once. */
+        val |= PLL_LOCKED;
+        break;
+    }
+    s->crm[i] = val;
+}
+
+static const MemoryRegionOps imx21_crm_ops = {
+    .read = imx21_crm_read,
+    .write = imx21_crm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void imx21_crm_reset(DeviceState *dev)
+{
+    IMX21CRMState *s = IMX21_CRM(dev);
+
+    memset(s->crm, 0, sizeof(s->crm));
+    memset(s->sys, 0, sizeof(s->sys));
+    /* USB_DIV 5, MCU_SEL oscillator, BCLKDIV 1, IPDIV 1, PLLs on */
+    s->crm[CSCR / 4] = 0x14010607;
+    s->crm[MPCTL0 / 4] = 0x00191403;     /* 266 MHz */
+    s->crm[MPCTL1 / 4] = PLL_LOCKED;
+    s->crm[SPCTL0 / 4] = 0x000c1407;     /* 288 MHz */
+    s->crm[SPCTL1 / 4] = PLL_LOCKED;
+    s->crm[OSC26MCTL / 4] = 0x3f00;
+    s->crm[PCDR0 / 4] = 0;
+    s->crm[PCDR1 / 4] = 0x05050505;      /* PERCLKn = MPLL / 6 */
+    s->crm[PCCR0 / 4] = 0xffffffff;      /* every clock on */
+    s->crm[PCCR1 / 4] = 0xffffffff;
+    s->sys[SIDR / 4] = 0x101d101d;       /* an i.MX21 silicon ID */
+    s->sys[FMCR / 4] = 0xffffffcb;
+}
+
+static void imx21_crm_init(Object *obj)
+{
+    IMX21CRMState *s = IMX21_CRM(obj);
+
+    memory_region_init_io(&s->iomem, obj, &imx21_crm_ops, s,
+                          TYPE_IMX21_CRM, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static const VMStateDescription vmstate_imx21_crm = {
+    .name = TYPE_IMX21_CRM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(crm, IMX21CRMState, IMX21_CRM_NUM_REGS),
+        VMSTATE_UINT32_ARRAY(sys, IMX21CRMState, IMX21_CRM_NUM_REGS),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx21_crm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_imx21_crm;
+    device_class_set_legacy_reset(dc, imx21_crm_reset);
+    dc->desc = "i.MX21 clock and reset module";
+}
+
+static const TypeInfo imx21_crm_info = {
+    .name = TYPE_IMX21_CRM,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMX21CRMState),
+    .instance_init = imx21_crm_init,
+    .class_init = imx21_crm_class_init,
+};
+
+static void imx21_crm_register_types(void)
+{
+    type_register_static(&imx21_crm_info);
+}
+
+type_init(imx21_crm_register_types)
diff --git a/hw/misc/imx21_pwm.c b/hw/misc/imx21_pwm.c
new file mode 100644
index 000000000..d1d7ca9f5
--- /dev/null
+++ b/hw/misc/imx21_pwm.c
@@ -0,0 +1,130 @@
+/*
+ * i.MX21 PWM
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The i.MX1-style PWM: control, sample, period and counter registers.
+ * Samples are taken at once, so the FIFO always has room. No output is
+ * produced.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/core/sysbus.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_PWM "imx21.pwm"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21PWMState, IMX21_PWM)
+
+#define PWMC        0x00
+#define PWMS        0x04
+#define PWMP        0x08
+#define PWMCNT      0x0c
+
+#define PWMC_FIFOAV (1 << 5)
+#define PWMC_SWR    (1 << 16)
+
+struct IMX21PWMState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    uint32_t regs[4];
+};
+
+static uint64_t imx21_pwm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX21PWMState *s = opaque;
+
+    if (offset >= sizeof(s->regs)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad register at 0x%"
+                      HWADDR_PRIx "\n", __func__, offset);
+        return 0;
+    }
+    if (offset == PWMC) {
+        return s->regs[0] | PWMC_FIFOAV;
+    }
+    return s->regs[offset / 4];
+}
+
+static void imx21_pwm_write(void *opaque, hwaddr offset, uint64_t val,
+                            unsigned size)
+{
+    IMX21PWMState *s = opaque;
+
+    if (offset >= sizeof(s->regs)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad register at 0x%"
+                      HWADDR_PRIx "\n", __func__, offset);
+        return;
+    }
+    if (offset == PWMC && (val & PWMC_SWR)) {
+        memset(s->regs, 0, sizeof(s->regs));
+        return;
+    }
+    if (offset != PWMCNT) {
+        s->regs[offset / 4] = val;
+    }
+}
+
+static const MemoryRegionOps imx21_pwm_ops = {
+    .read = imx21_pwm_read,
+    .write = imx21_pwm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void imx21_pwm_reset(DeviceState *dev)
+{
+    IMX21PWMState *s = IMX21_PWM(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+}
+
+static void imx21_pwm_init(Object *obj)
+{
+    IMX21PWMState *s = IMX21_PWM(obj);
+
+    memory_region_init_io(&s->iomem, obj, &imx21_pwm_ops, s,
+                          TYPE_IMX21_PWM, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static const VMStateDescription vmstate_imx21_pwm = {
+    .name = TYPE_IMX21_PWM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, IMX21PWMState, 4),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx21_pwm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_imx21_pwm;
+    device_class_set_legacy_reset(dc, imx21_pwm_reset);
+    dc->desc = "i.MX21 PWM";
+}
+
+static const TypeInfo imx21_pwm_info = {
+    .name = TYPE_IMX21_PWM,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMX21PWMState),
+    .instance_init = imx21_pwm_init,
+    .class_init = imx21_pwm_class_init,
+};
+
+static void imx21_pwm_register_types(void)
+{
+    type_register_static(&imx21_pwm_info);
+}
+
+type_init(imx21_pwm_register_types)
diff --git a/hw/misc/imx21_usbotg.c b/hw/misc/imx21_usbotg.c
new file mode 100644
index 000000000..cd9c89da8
--- /dev/null
+++ b/hw/misc/imx21_usbotg.c
@@ -0,0 +1,145 @@
+/*
+ * i.MX21 USB OTG block (host controller root hub only)
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The control registers of the i.MX21 USB OTG module and a host
+ * controller root hub with three empty ports, enough for the host
+ * driver to probe and find nothing attached. The ETD-based transfer
+ * engine is not modelled.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/core/sysbus.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_USBOTG "imx21.usbotg"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21USBOTGState, IMX21_USBOTG)
+
+#define USBOTG_SIZE     0x2000
+#define USBOTG_REGS     (USBOTG_SIZE / 4)
+
+#define RST_CTRL        0x10
+#define ROOTHUBA        0xe8
+#define PORTSTAT0       0xf4
+#define PORTSTAT2       0xfc
+
+#define PORTSTAT_PPS    (1 << 8)
+#define PORTSTAT_LSDA   (1 << 9)
+
+struct IMX21USBOTGState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t regs[USBOTG_REGS];
+};
+
+static uint64_t imx21_usbotg_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX21USBOTGState *s = opaque;
+
+    if (offset == RST_CTRL) {
+        /* Resets complete at once. */
+        return 0;
+    }
+    return s->regs[offset / 4];
+}
+
+static void imx21_usbotg_write(void *opaque, hwaddr offset, uint64_t val,
+                               unsigned size)
+{
+    IMX21USBOTGState *s = opaque;
+    uint32_t *r = &s->regs[offset / 4];
+
+    switch (offset) {
+    case RST_CTRL:
+        break;
+    case ROOTHUBA:
+        /* The port count is fixed. */
+        *r = (*r & 0xff) | (val & ~0xffu);
+        break;
+    case PORTSTAT0 ... PORTSTAT2:
+        /*
+         * Port status is write-1-to-act; with nothing connected the only
+         * state that sticks is port power.
+         */
+        if (val & PORTSTAT_PPS) {
+            *r |= PORTSTAT_PPS;
+        }
+        if (val & PORTSTAT_LSDA) {
+            *r &= ~PORTSTAT_PPS;
+        }
+        break;
+    default:
+        *r = val;
+        break;
+    }
+}
+
+static const MemoryRegionOps imx21_usbotg_ops = {
+    .read = imx21_usbotg_read,
+    .write = imx21_usbotg_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void imx21_usbotg_reset(DeviceState *dev)
+{
+    IMX21USBOTGState *s = IMX21_USBOTG(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    /* Three downstream ports, individually powered. */
+    s->regs[ROOTHUBA / 4] = 0x00000103;
+}
+
+static void imx21_usbotg_init(Object *obj)
+{
+    IMX21USBOTGState *s = IMX21_USBOTG(obj);
+
+    memory_region_init_io(&s->iomem, obj, &imx21_usbotg_ops, s,
+                          TYPE_IMX21_USBOTG, USBOTG_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+}
+
+static const VMStateDescription vmstate_imx21_usbotg = {
+    .name = TYPE_IMX21_USBOTG,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, IMX21USBOTGState, USBOTG_REGS),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx21_usbotg_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_imx21_usbotg;
+    device_class_set_legacy_reset(dc, imx21_usbotg_reset);
+    dc->desc = "i.MX21 USB OTG (root hub only)";
+}
+
+static const TypeInfo imx21_usbotg_info = {
+    .name = TYPE_IMX21_USBOTG,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMX21USBOTGState),
+    .instance_init = imx21_usbotg_init,
+    .class_init = imx21_usbotg_class_init,
+};
+
+static void imx21_usbotg_register_types(void)
+{
+    type_register_static(&imx21_usbotg_info);
+}
+
+type_init(imx21_usbotg_register_types)
