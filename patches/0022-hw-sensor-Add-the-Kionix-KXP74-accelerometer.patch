diff --git a/include/hw/sensor/kxp74.h b/include/hw/sensor/kxp74.h
new file mode 100644
--- /dev/null
+++ b/include/hw/sensor/kxp74.h
@@ -0,0 +1,42 @@
+/*
+ * Kionix KXP74 three-axis accelerometer, SPI interface
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_SENSOR_KXP74_H
+#define HW_SENSOR_KXP74_H
+
+#include "hw/ssi/ssi.h"
+#include "qom/object.h"
+
+#define TYPE_KXP74 "kxp74"
+OBJECT_DECLARE_SIMPLE_TYPE(KXP74State, KXP74)
+
+enum {
+    KXP74_X,
+    KXP74_Y,
+    KXP74_Z,
+    KXP74_AXES
+};
+
+/* The settable range, in milli-g; the ADC saturates well before. */
+#define KXP74_ACCEL_LIMIT_MG 16000
+
+struct KXP74State {
+    SSIPeripheral parent_obj;
+
+    /* The acceleration on each axis, in milli-g. */
+    int32_t accel[KXP74_AXES];
+
+    uint8_t ctrl;
+    /* The frame: bytes seen since chip select, and its command byte. */
+    uint32_t byte;
+    uint8_t cmd;
+    /* The conversion being clocked out. */
+    uint16_t result;
+};
+
+#endif /* HW_SENSOR_KXP74_H */
