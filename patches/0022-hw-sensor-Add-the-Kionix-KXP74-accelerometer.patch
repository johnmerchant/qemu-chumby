+/*
+ * Kionix KXP74 three-axis accelerometer, SPI interface
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * An analog accelerometer with a 12-bit ADC behind a byte-wide command
+ * protocol, as the Chumby Classic's stock driver (chumby_accel.c) uses
+ * it. In one chip-select frame, the first byte is a command:
+ *
+ *   0x00, 0x01, 0x02   convert X, Z or Y; the next two bytes clock out
+ *                      the result, MSB first, in bits 15:4
+ *   0x04               write the control register (the next byte)
+ *
+ * Control register bit 2 enables the part; a disabled part converts to
+ * zero. Conversions finish at once. Those are the only commands the
+ * stock driver sends; the part's datasheet was not at hand, so nothing
+ * else is modelled.
+ *
+ * The output is ratiometric: 0 g at mid-scale (2048), 819.2 counts per g,
+ * so the 12-bit range spans +/-2.5 g. The properties "x-mg", "y-mg" and
+ * "z-mg" set the acceleration on each axis in milli-g, at any time; they
+ * are the part's physical surroundings, so a reset leaves them alone. A
+ * part lying flat and still reads +1 g on Z.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/sensor/kxp74.h"
+#include "migration/vmstate.h"
+#include "qapi/error.h"
+#include "qapi/visitor.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "trace.h"
+
+#define CMD_CONVERT_X   0x00
+#define CMD_CONVERT_Z   0x01
+#define CMD_CONVERT_Y   0x02
+#define CMD_WRITE_CTRL  0x04
+
+#define CTRL_ENABLE     (1 << 2)
+
+#define ZERO_G          2048
+#define ADC_MAX         4095
+/* 819.2 counts per g */
+#define COUNTS_PER_G_X5 4096
+
+static const char *const axis_name[KXP74_AXES] = { "x-mg", "y-mg", "z-mg" };
+
+static uint16_t kxp74_convert(KXP74State *s, int axis)
+{
+    int64_t scaled = (int64_t)s->accel[axis] * COUNTS_PER_G_X5;
+    int64_t counts;
+
+    if (!(s->ctrl & CTRL_ENABLE)) {
+        return 0;
+    }
+    /* Rounded to the nearest count */
+    counts = ZERO_G + (scaled + (scaled < 0 ? -2500 : 2500)) / 5000;
+    return MIN(MAX(counts, 0), ADC_MAX);
+}
+
+static uint32_t kxp74_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    KXP74State *s = KXP74(dev);
+    uint32_t n = s->byte++;
+    uint32_t ret = 0;
+
+    val &= 0xff;
+    if (n == 0) {
+        s->cmd = val;
+        switch (val) {
+        case CMD_CONVERT_X:
+            s->result = kxp74_convert(s, KXP74_X);
+            break;
+        case CMD_CONVERT_Y:
+            s->result = kxp74_convert(s, KXP74_Y);
+            break;
+        case CMD_CONVERT_Z:
+            s->result = kxp74_convert(s, KXP74_Z);
+            break;
+        case CMD_WRITE_CTRL:
+            break;
+        default:
+            qemu_log_mask(LOG_GUEST_ERROR, "%s: unknown command 0x%02x\n",
+                          __func__, val);
+            break;
+        }
+        trace_kxp74_command(val, s->result);
+        return 0;
+    }
+
+    switch (s->cmd) {
+    case CMD_CONVERT_X:
+    case CMD_CONVERT_Y:
+    case CMD_CONVERT_Z:
+        if (n == 1) {
+            ret = s->result >> 4;
+        } else if (n == 2) {
+            ret = (s->result << 4) & 0xf0;
+        }
+        break;
+    case CMD_WRITE_CTRL:
+        if (n == 1) {
+            s->ctrl = val;
+            trace_kxp74_write_ctrl(val);
+        }
+        break;
+    }
+    return ret;
+}
+
+/* The chip select is active low: a frame starts when it goes low. */
+static int kxp74_set_cs(SSIPeripheral *dev, bool level)
+{
+    KXP74State *s = KXP74(dev);
+
+    if (!level) {
+        s->byte = 0;
+    }
+    return 0;
+}
+
+static void kxp74_get_accel(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    KXP74State *s = KXP74(obj);
+    int *axis = opaque;
+    int64_t value = s->accel[*axis];
+
+    visit_type_int(v, name, &value, errp);
+}
+
+static void kxp74_set_accel(Object *obj, Visitor *v, const char *name,
+                            void *opaque, Error **errp)
+{
+    KXP74State *s = KXP74(obj);
+    int *axis = opaque;
+    int64_t value;
+
+    if (!visit_type_int(v, name, &value, errp)) {
+        return;
+    }
+    if (value < -KXP74_ACCEL_LIMIT_MG || value > KXP74_ACCEL_LIMIT_MG) {
+        error_setg(errp, "%s: acceleration %" PRId64 " mg is out of range "
+                   "(%d to %d)", name, value, -KXP74_ACCEL_LIMIT_MG,
+                   KXP74_ACCEL_LIMIT_MG);
+        return;
+    }
+    s->accel[*axis] = value;
+    trace_kxp74_set_accel(name, value);
+}
+
+static void kxp74_realize(SSIPeripheral *dev, Error **errp)
+{
+}
+
+static void kxp74_reset(DeviceState *dev)
+{
+    KXP74State *s = KXP74(dev);
+
+    s->ctrl = 0;
+    s->byte = 0;
+    s->cmd = 0;
+    s->result = 0;
+}
+
+static void kxp74_init(Object *obj)
+{
+    KXP74State *s = KXP74(obj);
+
+    s->accel[KXP74_Z] = 1000;
+}
+
+static const VMStateDescription vmstate_kxp74 = {
+    .name = TYPE_KXP74,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, KXP74State),
+        VMSTATE_INT32_ARRAY(accel, KXP74State, KXP74_AXES),
+        VMSTATE_UINT8(ctrl, KXP74State),
+        VMSTATE_UINT32(byte, KXP74State),
+        VMSTATE_UINT8(cmd, KXP74State),
+        VMSTATE_UINT16(result, KXP74State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void kxp74_class_init(ObjectClass *klass, const void *data)
+{
+    static int axes[KXP74_AXES] = { KXP74_X, KXP74_Y, KXP74_Z };
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+    int i;
+
+    k->realize = kxp74_realize;
+    k->transfer = kxp74_transfer;
+    k->set_cs = kxp74_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    dc->vmsd = &vmstate_kxp74;
+    device_class_set_legacy_reset(dc, kxp74_reset);
+    dc->desc = "Kionix KXP74 accelerometer";
+
+    for (i = 0; i < KXP74_AXES; i++) {
+        object_class_property_add(klass, axis_name[i], "int",
+                                  kxp74_get_accel, kxp74_set_accel,
+                                  NULL, &axes[i]);
+        object_class_property_set_description(klass, axis_name[i],
+            "Acceleration along this axis, in milli-g");
+    }
+}
+
+static const TypeInfo kxp74_info = {
+    .name = TYPE_KXP74,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(KXP74State),
+    .instance_init = kxp74_init,
+    .class_init = kxp74_class_init,
+};
+
+static void kxp74_register_types(void)
+{
+    type_register_static(&kxp74_info);
+}
+
+type_init(kxp74_register_types)
