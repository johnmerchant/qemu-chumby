 arm_common_ss.add(when: 'CONFIG_ASPEED_SOC', if_true: files(
diff --git a/include/hw/arm/fsl-imx21.h b/include/hw/arm/fsl-imx21.h
new file mode 100644
--- /dev/null
+++ b/include/hw/arm/fsl-imx21.h
@@ -0,0 +1,125 @@
+/*
+ * Freescale i.MX21 SoC
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef FSL_IMX21_H
+#define FSL_IMX21_H
+
+#include "hw/intc/imx21_aitc.h"
+#include "hw/timer/imx21_gpt.h"
+#include "hw/char/imx_serial.h"
+#include "hw/misc/imx21_crm.h"
+#include "hw/gpio/imx21_gpio.h"
+#include "hw/ssi/imx21_cspi.h"
+#include "hw/display/imx21_lcdc.h"
+#include "hw/block/imx21_nfc.h"
+#include "hw/input/imx21_kpp.h"
+#include "hw/dma/imx21_dma.h"
+#include "hw/audio/imx21_audmux.h"
+#include "hw/i2c/imx_i2c.h"
+#include "hw/rtc/imx21_rtc.h"
+#include "hw/watchdog/wdt_imx2.h"
+#include "qemu/units.h"
+#include "system/memory.h"
+#include "target/arm/cpu.h"
+#include "qom/object.h"
+
+#define TYPE_FSL_IMX21 "fsl-imx21"
+OBJECT_DECLARE_SIMPLE_TYPE(FslIMX21State, FSL_IMX21)
+
+#define FSL_IMX21_MIDR 0x41069264
+
+#define FSL_IMX21_NUM_UARTS 4
+#define FSL_IMX21_NUM_GPTS 3
+#define FSL_IMX21_NUM_CSPIS 3
+#define FSL_IMX21_NUM_SSIS 2
+
+struct FslIMX21State {
+    DeviceState parent_obj;
+
+    ARMCPU cpu;
+    IMX21AITCState aitc;
+    IMX21GPTState gpt[FSL_IMX21_NUM_GPTS];
+    IMXSerialState uart[FSL_IMX21_NUM_UARTS];
+    IMX21CRMState crm;
+    IMX21GPIOState gpio;
+    IMX21CSPIState cspi[FSL_IMX21_NUM_CSPIS];
+    IMX21LCDCState lcdc;
+    IMX21NFCState nfc;
+    IMX21KPPState kpp;
+    IMX21DMAState dma;
+    IMX21SSIState ssi[FSL_IMX21_NUM_SSIS];
+    IMX21AudmuxState audmux;
+    IMX2WdtState wdt;
+    IMX21RTCState rtc;
+    IMXI2CState i2c;
+    DeviceState *pwm;
+    DeviceState *usbotg;
+    /* Peripheral and memory controller registers not modelled yet. */
+    MemoryRegion aipi_regs;
+    MemoryRegion emi_regs;
+};
+
+/* Memory map */
+#define FSL_IMX21_AIPI_ADDR     0x10000000
+#define FSL_IMX21_AIPI_SIZE     0x41000
+#define FSL_IMX21_DMA_ADDR      0x10001000
+#define FSL_IMX21_WDT_ADDR      0x10002000
+#define FSL_IMX21_GPT1_ADDR     0x10003000
+#define FSL_IMX21_GPT2_ADDR     0x10004000
+#define FSL_IMX21_GPT3_ADDR     0x10005000
+#define FSL_IMX21_PWM_ADDR      0x10006000
+#define FSL_IMX21_RTC_ADDR      0x10007000
+#define FSL_IMX21_KPP_ADDR      0x10008000
+#define FSL_IMX21_UART1_ADDR    0x1000a000
+#define FSL_IMX21_UART2_ADDR    0x1000b000
+#define FSL_IMX21_UART3_ADDR    0x1000c000
+#define FSL_IMX21_UART4_ADDR    0x1000d000
+#define FSL_IMX21_CSPI1_ADDR    0x1000e000
+#define FSL_IMX21_CSPI2_ADDR    0x1000f000
+#define FSL_IMX21_SSI1_ADDR     0x10010000
+#define FSL_IMX21_SSI2_ADDR     0x10011000
+#define FSL_IMX21_I2C_ADDR      0x10012000
+#define FSL_IMX21_GPIO_ADDR     0x10015000
+#define FSL_IMX21_AUDMUX_ADDR   0x10016000
+#define FSL_IMX21_CSPI3_ADDR    0x10017000
+#define FSL_IMX21_LCDC_ADDR     0x10021000
+#define FSL_IMX21_USBOTG_ADDR   0x10024000
+#define FSL_IMX21_CRM_ADDR      0x10027000
+#define FSL_IMX21_AITC_ADDR     0x10040000
+#define FSL_IMX21_SDRAM0_ADDR   0xc0000000
+#define FSL_IMX21_SDRAM0_SIZE   (64 * MiB)
+#define FSL_IMX21_EMI_ADDR      0xdf000000
+#define FSL_IMX21_EMI_SIZE      0x3000
+#define FSL_IMX21_NFC_ADDR      0xdf003000
+
+/* Interrupts */
+#define FSL_IMX21_CSPI3_IRQ     6
+#define FSL_IMX21_GPIO_IRQ      8
+#define FSL_IMX21_I2C_IRQ       12
+#define FSL_IMX21_SSI2_IRQ      13
+#define FSL_IMX21_SSI1_IRQ      14
+#define FSL_IMX21_CSPI2_IRQ     15
+#define FSL_IMX21_CSPI1_IRQ     16
+#define FSL_IMX21_UART4_IRQ     17
+#define FSL_IMX21_UART3_IRQ     18
+#define FSL_IMX21_UART2_IRQ     19
+#define FSL_IMX21_UART1_IRQ     20
+#define FSL_IMX21_RTC_IRQ       22
+#define FSL_IMX21_GPT3_IRQ      24
+#define FSL_IMX21_GPT2_IRQ      25
+#define FSL_IMX21_GPT1_IRQ      26
+#define FSL_IMX21_WDT_IRQ       27
+#define FSL_IMX21_NFC_IRQ       29
