diff --git a/hw/arm/fsl-imx21.c b/hw/arm/fsl-imx21.c
new file mode 100644
--- /dev/null
+++ b/hw/arm/fsl-imx21.c
@@ -0,0 +1,265 @@
+/*
+ * Freescale i.MX21 SoC
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * An ARM926EJ-S with the i.MX21's interrupt controller, timers, UARTs,
+ * clocks, GPIO, keypad port, SPI, LCD and NAND flash controllers, DMA
+ * controller, SSIs and audio multiplexer, PWM, USB host, watchdog, RTC
+ * and I2C controller. Peripheral and memory controller registers that
+ * are not modelled (SDHC, SDRAM and WEIM controllers and others) read
+ * back what was last written.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/arm/fsl-imx21.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/core/sysbus.h"
+#include "chardev/char.h"
+#include "system/address-spaces.h"
+#include "system/system.h"
+#include "target/arm/cpu-qom.h"
+
+static void fsl_imx21_init(Object *obj)
+{
+    FslIMX21State *s = FSL_IMX21(obj);
+    int i;
+
+    object_initialize_child(obj, "cpu", &s->cpu, ARM_CPU_TYPE_NAME("arm926"));
+    object_initialize_child(obj, "aitc", &s->aitc, TYPE_IMX21_AITC);
+    for (i = 0; i < FSL_IMX21_NUM_GPTS; i++) {
+        object_initialize_child(obj, "gpt[*]", &s->gpt[i], TYPE_IMX21_GPT);
+    }
+    for (i = 0; i < FSL_IMX21_NUM_UARTS; i++) {
+        object_initialize_child(obj, "uart[*]", &s->uart[i], TYPE_IMX_SERIAL);
+    }
+    object_initialize_child(obj, "crm", &s->crm, TYPE_IMX21_CRM);
+    object_initialize_child(obj, "gpio", &s->gpio, TYPE_IMX21_GPIO);
+    for (i = 0; i < FSL_IMX21_NUM_CSPIS; i++) {
+        object_initialize_child(obj, "cspi[*]", &s->cspi[i], TYPE_IMX21_CSPI);
+    }
+    object_initialize_child(obj, "lcdc", &s->lcdc, TYPE_IMX21_LCDC);
+    object_initialize_child(obj, "nfc", &s->nfc, TYPE_IMX21_NFC);
+    object_initialize_child(obj, "kpp", &s->kpp, TYPE_IMX21_KPP);
+    object_initialize_child(obj, "dma", &s->dma, TYPE_IMX21_DMA);
+    for (i = 0; i < FSL_IMX21_NUM_SSIS; i++) {
+        object_initialize_child(obj, "ssi[*]", &s->ssi[i], TYPE_IMX21_SSI);
+    }
+    object_initialize_child(obj, "audmux", &s->audmux, TYPE_IMX21_AUDMUX);
+    object_initialize_child(obj, "wdt", &s->wdt, TYPE_IMX2_WDT);
+    object_initialize_child(obj, "rtc", &s->rtc, TYPE_IMX21_RTC);
+    object_initialize_child(obj, "i2c", &s->i2c, TYPE_IMX_I2C);
+}
+
+static bool fsl_imx21_map(DeviceState *dev, SysBusDevice *sbd, hwaddr addr,
+                          int irq, Error **errp)
+{
+    if (!sysbus_realize(sbd, errp)) {
+        return false;
+    }
+    sysbus_mmio_map(sbd, 0, addr);
+    if (irq >= 0) {
+        sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(dev, irq));
+    }
+    return true;
+}
+
+static void fsl_imx21_realize(DeviceState *dev, Error **errp)
+{
+    FslIMX21State *s = FSL_IMX21(dev);
+    DeviceState *aitc = DEVICE(&s->aitc);
+    MemoryRegion *sysmem = get_system_memory();
+    int i;
+
+    static const struct {
+        hwaddr addr;
+        int irq;
+    } gpts[FSL_IMX21_NUM_GPTS] = {
+        { FSL_IMX21_GPT1_ADDR, FSL_IMX21_GPT1_IRQ },
+        { FSL_IMX21_GPT2_ADDR, FSL_IMX21_GPT2_IRQ },
+        { FSL_IMX21_GPT3_ADDR, FSL_IMX21_GPT3_IRQ },
+    }, uarts[FSL_IMX21_NUM_UARTS] = {
+        { FSL_IMX21_UART1_ADDR, FSL_IMX21_UART1_IRQ },
+        { FSL_IMX21_UART2_ADDR, FSL_IMX21_UART2_IRQ },
+        { FSL_IMX21_UART3_ADDR, FSL_IMX21_UART3_IRQ },
+        { FSL_IMX21_UART4_ADDR, FSL_IMX21_UART4_IRQ },
+    }, cspis[FSL_IMX21_NUM_CSPIS] = {
+        { FSL_IMX21_CSPI1_ADDR, FSL_IMX21_CSPI1_IRQ },
+        { FSL_IMX21_CSPI2_ADDR, FSL_IMX21_CSPI2_IRQ },
+        { FSL_IMX21_CSPI3_ADDR, FSL_IMX21_CSPI3_IRQ },
+    };
+
+    /* The i.MX21's core is an ARM926EJ-S r0p4. */
+    if (!object_property_set_int(OBJECT(&s->cpu), "midr", FSL_IMX21_MIDR,
+                                 errp) ||
+        !qdev_realize(DEVICE(&s->cpu), NULL, errp)) {
+        return;
+    }
+
+    if (!sysbus_realize(SYS_BUS_DEVICE(aitc), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(aitc), 0, FSL_IMX21_AITC_ADDR);
+    sysbus_connect_irq(SYS_BUS_DEVICE(aitc), 0,
+                       qdev_get_gpio_in(DEVICE(&s->cpu), ARM_CPU_IRQ));
+    sysbus_connect_irq(SYS_BUS_DEVICE(aitc), 1,
+                       qdev_get_gpio_in(DEVICE(&s->cpu), ARM_CPU_FIQ));
+
+    for (i = 0; i < FSL_IMX21_NUM_GPTS; i++) {
+        if (!fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->gpt[i]), gpts[i].addr,
+                           gpts[i].irq, errp)) {
+            return;
+        }
+    }
+
+    for (i = 0; i < FSL_IMX21_NUM_UARTS; i++) {
+        DeviceState *uart = DEVICE(&s->uart[i]);
+        g_autofree char *chr = object_property_get_str(OBJECT(uart),
+                                                       "chardev", NULL);
+
+        /* A board may have attached something else already. */
+        if (!chr || !*chr) {
+            qdev_prop_set_chr(uart, "chardev", serial_hd(i));
+        }
+        if (!fsl_imx21_map(aitc, SYS_BUS_DEVICE(uart), uarts[i].addr,
+                           uarts[i].irq, errp)) {
+            return;
+        }
+    }
+
+    if (!fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->crm), FSL_IMX21_CRM_ADDR,
+                       -1, errp) ||
+        !fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->gpio), FSL_IMX21_GPIO_ADDR,
+                       FSL_IMX21_GPIO_IRQ, errp) ||
+        !fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->lcdc), FSL_IMX21_LCDC_ADDR,
+                       FSL_IMX21_LCDC_IRQ, errp) ||
+        !fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->nfc), FSL_IMX21_NFC_ADDR,
+                       FSL_IMX21_NFC_IRQ, errp) ||
+        !fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->kpp), FSL_IMX21_KPP_ADDR,
+                       -1, errp)) {
+        return;
+    }
+
+    /*
+     * WRSR tells the Chumby's kernel why it was reset. The kernel services
+     * the watchdog every tick, so a quarter second after a host stall is
+     * plenty.
+     */
+    if (!object_property_set_bool(OBJECT(&s->wdt), "reset-source", true,
+                                  errp) ||
+        !object_property_set_uint(OBJECT(&s->wdt), "stall-grace-ms", 250,
+                                  errp) ||
+        !fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->wdt), FSL_IMX21_WDT_ADDR,
+                       FSL_IMX21_WDT_IRQ, errp) ||
+        !fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->rtc), FSL_IMX21_RTC_ADDR,
+                       FSL_IMX21_RTC_IRQ, errp) ||
+        !fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->i2c), FSL_IMX21_I2C_ADDR,
+                       FSL_IMX21_I2C_IRQ, errp)) {
+        return;
+    }
+
+    for (i = 0; i < FSL_IMX21_NUM_CSPIS; i++) {
+        if (!fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->cspi[i]), cspis[i].addr,
+                           cspis[i].irq, errp)) {
+            return;
+        }
+    }
+
+    /* The DMA controller: one interrupt per channel. */
+    if (!fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->dma), FSL_IMX21_DMA_ADDR,
+                       -1, errp)) {
+        return;
+    }
+    for (i = 0; i < IMX21_DMA_CHANNELS; i++) {
+        sysbus_connect_irq(SYS_BUS_DEVICE(&s->dma), i,
+                           qdev_get_gpio_in(aitc, FSL_IMX21_DMA_IRQ + i));
+    }
+
+    /*
+     * SSI1 and SSI2, their DMA requests (receive and transmit for FIFO 0,
+     * then FIFO 1, from FSL_IMX21_DMA_REQ_SSIn_RX0 on), and the audio
+     * multiplexer that connects them to the pins.
+     */
+    for (i = 0; i < FSL_IMX21_NUM_SSIS; i++) {
+        static const struct {
+            hwaddr addr;
+            int irq;
+            int req;
+        } ssis[FSL_IMX21_NUM_SSIS] = {
+            { FSL_IMX21_SSI1_ADDR, FSL_IMX21_SSI1_IRQ,
+              FSL_IMX21_DMA_REQ_SSI1_RX0 },
+            { FSL_IMX21_SSI2_ADDR, FSL_IMX21_SSI2_IRQ,
+              FSL_IMX21_DMA_REQ_SSI2_RX0 },
+        };
+        static const int reqs[IMX21_SSI_NUM_DMA] = {
+            [IMX21_SSI_DMA_RX0] = 0, [IMX21_SSI_DMA_TX0] = 1,
+            [IMX21_SSI_DMA_RX1] = 2, [IMX21_SSI_DMA_TX1] = 3,
+        };
+        int j;
+
+        if (!fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->ssi[i]), ssis[i].addr,
+                           ssis[i].irq, errp)) {
+            return;
+        }
+        for (j = 0; j < IMX21_SSI_NUM_DMA; j++) {
+            qdev_connect_gpio_out_named(DEVICE(&s->ssi[i]), IMX21_SSI_DMA, j,
+                                        qdev_get_gpio_in(DEVICE(&s->dma),
+                                                         ssis[i].req +
+                                                         reqs[j]));
+        }
+    }
+    if (!object_property_set_link(OBJECT(&s->audmux), "ssi1",
+                                  OBJECT(&s->ssi[0]), errp) ||
+        !object_property_set_link(OBJECT(&s->audmux), "ssi2",
+                                  OBJECT(&s->ssi[1]), errp) ||
+        !fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->audmux),
+                       FSL_IMX21_AUDMUX_ADDR, -1, errp)) {
+        return;
+    }
+
+    s->pwm = sysbus_create_simple("imx21.pwm", FSL_IMX21_PWM_ADDR, NULL);
+    s->usbotg = sysbus_create_simple("imx21.usbotg", FSL_IMX21_USBOTG_ADDR,
+                                     qdev_get_gpio_in(aitc,
+                                                      FSL_IMX21_USBHOST_IRQ));
+
+    /* Everything else in the peripheral and memory controller spaces. */
+    if (!memory_region_init_ram(&s->aipi_regs, OBJECT(dev), "imx21.aipi",
+                                FSL_IMX21_AIPI_SIZE, errp) ||
+        !memory_region_init_ram(&s->emi_regs, OBJECT(dev), "imx21.emi",
+                                FSL_IMX21_EMI_SIZE, errp)) {
+        return;
+    }
+    memory_region_add_subregion_overlap(sysmem, FSL_IMX21_AIPI_ADDR,
+                                        &s->aipi_regs, -1000);
+    memory_region_add_subregion_overlap(sysmem, FSL_IMX21_EMI_ADDR,
+                                        &s->emi_regs, -1000);
+}
+
+static void fsl_imx21_class_init(ObjectClass *oc, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(oc);
+
+    dc->realize = fsl_imx21_realize;
+    dc->desc = "i.MX21 SoC";
+    /* Reason: uses serial_hd() in the realize function */
+    dc->user_creatable = false;
+}
+
+static const TypeInfo fsl_imx21_type_info = {
+    .name = TYPE_FSL_IMX21,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(FslIMX21State),
+    .instance_init = fsl_imx21_init,
+    .class_init = fsl_imx21_class_init,
+};
+
+static void fsl_imx21_register_types(void)
+{
+    type_register_static(&fsl_imx21_type_info);
+}
+
+type_init(fsl_imx21_register_types)
