+static const char *const chumby_accel_props[KXP74_AXES] = {
+    "x-mg", "y-mg", "z-mg"
+};
+
+static void chumby_classic_get_accel(Object *obj, Visitor *v,
+                                     const char *name, void *opaque,
+                                     Error **errp)
+{
+    ChumbyClassicState *s = CHUMBY_CLASSIC_MACHINE(obj);
+    int axis = (uintptr_t)opaque;
+    int64_t value = s->accel_mg[axis];
+
+    if (s->accel) {
+        value = object_property_get_int(OBJECT(s->accel),
+                                        chumby_accel_props[axis], errp);
+    }
+    visit_type_int(v, name, &value, errp);
+}
+
+static void chumby_classic_set_accel(Object *obj, Visitor *v,
+                                     const char *name, void *opaque,
+                                     Error **errp)
+{
+    ChumbyClassicState *s = CHUMBY_CLASSIC_MACHINE(obj);
+    int axis = (uintptr_t)opaque;
+    int64_t value;
+
+    if (!visit_type_int(v, name, &value, errp)) {
+        return;
+    }
+    if (value < -KXP74_ACCEL_LIMIT_MG || value > KXP74_ACCEL_LIMIT_MG) {
+        error_setg(errp, "%s: %" PRId64 " mg is out of range (%d to %d)",
+                   name, value, -KXP74_ACCEL_LIMIT_MG, KXP74_ACCEL_LIMIT_MG);
+        return;
+    }
+    s->accel_mg[axis] = value;
+    if (s->accel) {
+        object_property_set_int(OBJECT(s->accel), chumby_accel_props[axis],
+                                value, errp);
+    }
+}
+
+/* The sensor card's decoder: line 0 is SS0, line 1 SS1 */
+static void chumby_classic_sensor_select(void *opaque, int n, int level)
+{
+    ChumbyClassicState *s = opaque;
+    int i;
+
+    s->sensor_sel = deposit32(s->sensor_sel, n, 1, !!level);
+    for (i = 0; i < CHUMBY_SENSOR_NUM_CS; i++) {
+        /* Active low; an unused select has no line. */
+        qemu_set_irq(s->sensor_cs[i], s->sensor_sel != i);
+    }
+}
+
+/* Appends a DC ID tag header to @buf. */
+static void chumby_dcid_tag(GByteArray *buf, const char *name, int len,
+                            bool parent)
+{
+    uint8_t hdr[CHUMBY_DCID_TAG_HDR] = {
+        0, (CHUMBY_DCID_TAG_HDR + len) | (parent ? CHUMBY_DCID_TAG_PARENT : 0)
+    };
+
+    memcpy(&hdr[2], name, 4);
+    g_byte_array_append(buf, hdr, sizeof(hdr));
+}
+
+/*
+ * Programs the DC ID EEPROM. The tags are made up, as no real card's
+ * contents are known: <dcid><vers>01</vers><hwvr>MAJOR MINOR</hwvr>
+ * </dcid>. The revision is 00.00.MAJOR.MINOR and the serial number the
+ * last 12 characters of the device's.
+ */
+static void chumby_classic_program_dcid(ChumbyClassicState *s,
+                                        AT25080AState *dcid)
+{
+    g_autoptr(GByteArray) buf = g_byte_array_new();
+    const uint8_t vers = 1;
+    const uint8_t hwvr[2] = { s->hw_major, s->hw_minor };
+    const uint8_t rev[4] = { 0, 0, s->hw_major, s->hw_minor };
+
+    g_byte_array_append(buf, (const uint8_t *)"sexi", 4);
+    chumby_dcid_tag(buf, "dcid", 2 * CHUMBY_DCID_TAG_HDR + sizeof(vers) +
+                    sizeof(hwvr), true);
+    chumby_dcid_tag(buf, "vers", sizeof(vers), false);
+    g_byte_array_append(buf, &vers, sizeof(vers));
+    chumby_dcid_tag(buf, "hwvr", sizeof(hwvr), false);
+    g_byte_array_append(buf, hwvr, sizeof(hwvr));
+    g_byte_array_append(buf, (const uint8_t *)"pus!", 4);
+    at25080a_program(dcid, 0, buf->data, buf->len);
+
+    at25080a_program(dcid, CHUMBY_DCID_REV_ADDR, rev, sizeof(rev));
+    at25080a_program(dcid, CHUMBY_DCID_SERIAL_ADDR,
+                     s->serial + CHUMBY_CP_SERIAL_LEN - CHUMBY_DCID_SERIAL_LEN,
+                     CHUMBY_DCID_SERIAL_LEN);
+}
+
+/* The sensor card on CSPI1: the accelerometer and the DC ID EEPROM */
+static void chumby_classic_init_sensors(ChumbyClassicState *s)
+{
+    SSIBus *spi = (SSIBus *)qdev_get_child_bus(DEVICE(&s->soc.cspi[0]),
+                                               "spi");
+    DeviceState *accel, *dcid;
+    int i;
+
+    accel = qdev_new(TYPE_KXP74);
+    qdev_prop_set_uint8(accel, "cs", CHUMBY_SENSOR_CS_ACCEL);
+    object_property_add_child(OBJECT(s), "accel", OBJECT(accel));
+    for (i = 0; i < KXP74_AXES; i++) {
+        object_property_set_int(OBJECT(accel), chumby_accel_props[i],
+                                s->accel_mg[i], &error_abort);
+    }
+    ssi_realize_and_unref(accel, spi, &error_fatal);
+    s->accel = accel;
+    s->sensor_cs[CHUMBY_SENSOR_CS_ACCEL] =
+        qdev_get_gpio_in_named(accel, SSI_GPIO_CS, 0);
+
+    dcid = qdev_new(TYPE_AT25080A);
+    qdev_prop_set_uint8(dcid, "cs", CHUMBY_SENSOR_CS_DCID);
+    object_property_add_child(OBJECT(s), "dcid", OBJECT(dcid));
+    chumby_classic_program_dcid(s, AT25080A(dcid));
+    ssi_realize_and_unref(dcid, spi, &error_fatal);
+    s->sensor_cs[CHUMBY_SENSOR_CS_DCID] =
+        qdev_get_gpio_in_named(dcid, SSI_GPIO_CS, 0);
+
+    s->sensor_sel = CHUMBY_SENSOR_CS_IDLE;
+    qdev_connect_gpio_out(DEVICE(&s->soc.gpio), CHUMBY_SENSOR_SS0_GPIO,
+                          qemu_allocate_irq(chumby_classic_sensor_select,
+                                            s, 0));
+    qdev_connect_gpio_out(DEVICE(&s->soc.gpio), CHUMBY_SENSOR_SS1_GPIO,
+                          qemu_allocate_irq(chumby_classic_sensor_select,
+                                            s, 1));
+    chumby_classic_sensor_select(s, 0, 1);
+}
