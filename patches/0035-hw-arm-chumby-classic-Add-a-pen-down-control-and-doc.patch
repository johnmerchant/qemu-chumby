diff --git a/hw/input/tsc2100.c b/hw/input/tsc2100.c
--- a/hw/input/tsc2100.c
+++ b/hw/input/tsc2100.c
@@ -87,6 +87,7 @@
 #define RESET_MAGIC     0xbb00
 #define STATUS_RESET    0x8000
 #define PEN_RESENSE_NS  (100 * 1000)
+#define PEN_HELD_DELAY_NS (1000 * 1000)
 #define ADC_MAX         0xfff
 
 /* The result registers each scan mode (ADC bits 13:10) converts. */
@@ -553,6 +554,9 @@ static void tsc2100_pen_tick(void *opaque)
 {
     TSC2100State *s = opaque;
 
+    if (s->pen_held) {
+        s->down = true;
+    }
     if (s->down) {
         s->pen_latch = true;
         tsc2100_update_pintdav(s);
@@ -589,6 +593,21 @@ static void tsc2100_reset(DeviceState *dev)
     s->word = 0;
     s->down = false;
     tsc2100_update_pintdav(s);
+    if (s->pen_held) {
+        /* After everything's reset, so the pin's edge reaches the GPIO. */
+        timer_mod(s->pen_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                  PEN_HELD_DELAY_NS);
+    }
+}
+
+void tsc2100_hold_pen(TSC2100State *s, bool held)
+{
+    s->pen_held = held;
+    s->down = held;
+    if (held) {
+        s->pen_latch = true;
+    }
+    tsc2100_update_pintdav(s);
 }
 
 static int tsc2100_post_load(void *opaque, int version_id)
