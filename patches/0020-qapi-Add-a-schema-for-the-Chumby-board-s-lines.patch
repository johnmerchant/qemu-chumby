From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Fri, 30 Oct 2026 02:57:49 +1030
Subject: [PATCH 20/42] qapi: Add a schema for the Chumby board's lines

A frontend for the chumby-classic machine shows what the guest does
with the board's outputs (dims or blanks its view with the backlight
and the LCD's power, shows the speaker as muted) and drives its inputs
(headphones, the top button). Polling for the outputs wastes wakeups.

Add qapi/chumby.json with query-chumby-state, returning the backlight
level (the PWM's duty cycle, 0 to 65535), LCD power, speaker mute,
headphones and button, and the events CHUMBY_BACKLIGHT, CHUMBY_LCD,
CHUMBY_SPEAKER_MUTE and CHUMBY_HEADPHONES. A backlight fade is many
changes, so CHUMBY_BACKLIGHT is rate-limited to one each 100 ms, the
last level always arriving. Machines without the board answer the
query with an error, from a stub.

The schema is a module of its own, for the board's other controls to
join.

Signed-off-by: John Merchant <john@johnmerchant.dev>
Claude-Session: https://claude.ai/code/session_01B1fN5Fc77Z6fVVe4rWJxPT
---
 monitor/monitor.c     |   2 +
 qapi/chumby.json      | 135 ++++++++++++++++++++++++++++++++++++++++++
 qapi/meson.build      |   1 +
 qapi/qapi-schema.json |   1 +
 stubs/meson.build     |   1 +
 stubs/qmp-chumby.c    |  11 ++++
 6 files changed, 151 insertions(+)
 create mode 100644 qapi/chumby.json
 create mode 100644 stubs/qmp-chumby.c

diff --git a/monitor/monitor.c b/monitor/monitor.c
index ed195fd97..4c093aefc 100644
--- a/monitor/monitor.c
+++ b/monitor/monitor.c
@@ -336,6 +336,8 @@ static MonitorQAPIEventConf monitor_qapi_event_conf[QAPI_EVENT__MAX] = {
     [QAPI_EVENT_VSERPORT_CHANGE]   = { 1000 * SCALE_MS },
     [QAPI_EVENT_MEMORY_DEVICE_SIZE_CHANGE] = { 1000 * SCALE_MS },
     [QAPI_EVENT_HV_BALLOON_STATUS_REPORT] = { 1000 * SCALE_MS },
+    /* A backlight fade is many changes; a display follows it this fast. */
+    [QAPI_EVENT_CHUMBY_BACKLIGHT]  = { 100 * SCALE_MS },
 };
 
 /*
diff --git a/qapi/chumby.json b/qapi/chumby.json
new file mode 100644
index 000000000..eb341c1c3
--- /dev/null
+++ b/qapi/chumby.json
@@ -0,0 +1,135 @@
+# -*- Mode: Python -*-
+# vim: filetype=python
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+##
+# ************
+# Chumby board
+# ************
+##
+
+##
+# The board-level controls of the ``chumby-classic`` machine: the
+# lines the guest drives (backlight, LCD power, speaker mute) and the
+# ones a user does (headphones, the top button).
+##
+
+##
+# @ChumbyState:
+#
+# The state of the Chumby's board-level lines.
+#
+# @backlight: the backlight's duty cycle, 0 (off) to 65535 (fully on),
+#     as the guest's PWM drives it
+#
+# @lcd-on: whether the guest has the LCD panel powered
+#
+# @speaker-mute: whether the guest has the speaker amplifier muted
+#
+# @headphones: whether headphones are plugged in
+#
+# @button: whether the top button is held
+#
+# Since: 11.2
+##
+{ 'struct': 'ChumbyState',
+  'data': { 'backlight': 'uint16',
+            'lcd-on': 'bool',
+            'speaker-mute': 'bool',
+            'headphones': 'bool',
+            'button': 'bool' } }
+
+##
+# @query-chumby-state:
+#
+# Return the state of the Chumby's board-level lines.  Only the
+# ``chumby-classic`` machine has them; other machines report an error.
+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     -> { "execute": "query-chumby-state" }
+#     <- { "return": { "backlight": 65535, "lcd-on": true,
+#                      "speaker-mute": false, "headphones": false,
+#                      "button": false } }
+##
+{ 'command': 'query-chumby-state', 'returns': 'ChumbyState' }
+
+##
+# @CHUMBY_BACKLIGHT:
+#
+# Emitted when the guest changes the backlight's duty cycle.
+#
+# @level: the new duty cycle, 0 (off) to 65535 (fully on)
+#
+# .. note:: This event is rate-limited: a fade sends the first level
+#    at once and then at most one every 100 ms, the last being the
+#    final level.
+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     <- { "event": "CHUMBY_BACKLIGHT",
+#          "data": { "level": 32768 },
+#          "timestamp": { "seconds": 1265044230, "microseconds": 450486 } }
+##
+{ 'event': 'CHUMBY_BACKLIGHT',
+  'data': { 'level': 'uint16' } }
+
+##
+# @CHUMBY_LCD:
+#
+# Emitted when the guest powers the LCD panel on or off.
+#
+# @on: whether the panel is now powered
+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     <- { "event": "CHUMBY_LCD",
+#          "data": { "on": false },
+#          "timestamp": { "seconds": 1265044230, "microseconds": 450486 } }
+##
+{ 'event': 'CHUMBY_LCD',
+  'data': { 'on': 'bool' } }
+
+##
+# @CHUMBY_SPEAKER_MUTE:
+#
+# Emitted when the guest mutes or unmutes the speaker amplifier.
+#
+# @muted: whether the speaker is now muted
+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     <- { "event": "CHUMBY_SPEAKER_MUTE",
+#          "data": { "muted": true },
+#          "timestamp": { "seconds": 1265044230, "microseconds": 450486 } }
+##
+{ 'event': 'CHUMBY_SPEAKER_MUTE',
+  'data': { 'muted': 'bool' } }
+
+##
+# @CHUMBY_HEADPHONES:
+#
+# Emitted when headphones are plugged in or out (the machine's
+# ``headphones`` property).
+#
+# @inserted: whether headphones are now plugged in
+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     <- { "event": "CHUMBY_HEADPHONES",
+#          "data": { "inserted": true },
+#          "timestamp": { "seconds": 1265044230, "microseconds": 450486 } }
+##
+{ 'event': 'CHUMBY_HEADPHONES',
+  'data': { 'inserted': 'bool' } }
