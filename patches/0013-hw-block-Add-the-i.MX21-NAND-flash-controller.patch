+
+#ifndef IMX21_NFC_H
+#define IMX21_NFC_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_NFC "imx21.nfc"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21NFCState, IMX21_NFC)
+
+/* A page is 512 data bytes and 16 spare bytes. */
+#define IMX21_NAND_PAGE         512
+#define IMX21_NAND_SPARE        16
+#define IMX21_NAND_RECORD       (IMX21_NAND_PAGE + IMX21_NAND_SPARE)
+#define IMX21_NFC_BUF_SIZE      0x840
+
+struct IMX21NFCState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    BlockBackend *blk;
+    /* After a restore: read the contents again before the machine runs */
+    struct VMChangeStateEntry *vmstate_change;
+    bool reload;
+
+    /* The chip's identity and size. */
+    uint8_t manf_id;
+    uint8_t chip_id;
+    uint32_t pages;
+    uint32_t pages_per_block;
+
+    /* The controller. */
+    uint8_t buf[IMX21_NFC_BUF_SIZE];
+    uint16_t bufsize;
+    uint16_t rba;
+    uint16_t addr_reg;
+    uint16_t cmd_reg;
+    uint16_t config;
+    uint16_t wr_prot;
+    uint16_t unlock_start;
+    uint16_t unlock_end;
+    uint16_t config1;
+    uint16_t config2;
+
+    /* The chip: its contents as records of data then spare. */
+    uint8_t *data;
+    uint8_t cmd;
+    uint8_t addr[4];
+    uint32_t naddr;
+    uint32_t page;
+    uint32_t col;
+    uint8_t prog[IMX21_NAND_RECORD];
+    uint32_t prog_col;
+    uint32_t area;
+};
+
+#endif /* IMX21_NFC_H */
