From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Fri, 30 Oct 2026 03:20:56 +1030
Subject: [PATCH 29/42] hw/char/chumby_cp: Make the identity settable

The crypto processor reports the device's identity to the stock tools:
the GUID ("PIDX", printed by "cpi -p" and used as the device ID by the
control panel download), the serial number ("SNUM", "chumby_version
-n") and the hardware version ("HWVR", "chumby_version -h"). They were
fixed, so every emulated Chumby was the same device to a server.

Keep them in the CP's state, with today's values as the defaults, and
add chumby_cp_set_identity() for the board to set them.

Signed-off-by: John Merchant <john@johnmerchant.dev>
Claude-Session: https://claude.ai/code/session_01B1fN5Fc77Z6fVVe4rWJxPT
---
 hw/char/chumby_cp.c         | 32 ++++++++++++++++++++++----------
 include/hw/char/chumby_cp.h | 20 ++++++++++++++++++++
 2 files changed, 42 insertions(+), 10 deletions(-)

diff --git a/hw/char/chumby_cp.c b/hw/char/chumby_cp.c
index 34b09c9ae..ec99c998f 100644
--- a/hw/char/chumby_cp.c
+++ b/hw/char/chumby_cp.c
@@ -15,9 +15,10 @@
  * '\r'. A reply is a four-letter tag, one base64 data line ending in
  * '\r', and a final '\r'; or "FAIL\r" when refused.
  *
- * This CP is hardware version 3.8 with a fixed, made-up identity: GUID
+ * By default this CP is hardware version 3.8 with a made-up identity: GUID
  * C40BB1E0-0000-4000-8000-0E4000000001, serial number 0000000000000000.
- * It holds no keys, and refuses key and challenge requests.
+ * The board can give it another (chumby_cp_set_identity). It holds no
+ * keys, and refuses key and challenge requests.
  */
 
 #include "qemu/osdep.h"
@@ -29,15 +30,23 @@
 #define CP_LATENCY_NS   (2 * SCALE_MS)
 #define CP_CHAR_NS      (NANOSECONDS_PER_SECOND / 3840)
 
-static const uint8_t cp_guid[16] = {
+static const uint8_t cp_default_guid[CHUMBY_CP_GUID_LEN] = {
     0xc4, 0x0b, 0xb1, 0xe0, 0x00, 0x00, 0x40, 0x00,
     0x80, 0x00, 0x0e, 0x40, 0x00, 0x00, 0x00, 0x01,
 };
 
-/* Hardware version 3.8: minor then major, at bytes 12-13. */
-static const uint8_t cp_hwver[16] = {
-    [12] = 0x08, [13] = 0x03,
-};
+void chumby_cp_set_identity(ChumbyCPChardev *cp, const uint8_t *guid,
+                            const char *serial, uint8_t hw_major,
+                            uint8_t hw_minor)
+{
+    assert(strlen(serial) == CHUMBY_CP_SERIAL_LEN);
+    memcpy(cp->guid, guid, CHUMBY_CP_GUID_LEN);
+    memcpy(cp->serial, serial, CHUMBY_CP_SERIAL_LEN);
+    /* The hardware version: minor then major, at bytes 12-13. */
+    memset(cp->hwver, 0, sizeof(cp->hwver));
+    cp->hwver[12] = hw_minor;
+    cp->hwver[13] = hw_major;
+}
 
 static const uint8_t cp_version[6] = { 1, 0, 0, 0, 0, 0 };
 
@@ -121,11 +130,11 @@ static void chumby_cp_request(ChumbyCPChardev *cp)
     g_strlcpy(cmd, req, sizeof(cmd));
 
     if (!strcmp(cmd, "HWVR")) {
-        chumby_cp_reply(cp, "HVRS", cp_hwver, sizeof(cp_hwver));
+        chumby_cp_reply(cp, "HVRS", cp->hwver, sizeof(cp->hwver));
     } else if (!strcmp(cmd, "PIDX")) {
-        chumby_cp_reply(cp, "PIDX", cp_guid, sizeof(cp_guid));
+        chumby_cp_reply(cp, "PIDX", cp->guid, sizeof(cp->guid));
     } else if (!strcmp(cmd, "SNUM")) {
-        chumby_cp_reply(cp, "SNUM", (const uint8_t *)"0000000000000000", 16);
+        chumby_cp_reply(cp, "SNUM", cp->serial, sizeof(cp->serial));
     } else if (!strcmp(cmd, "VERS")) {
         chumby_cp_reply(cp, "VRSR", cp_version, sizeof(cp_version));
     } else if (!strcmp(cmd, "TIME")) {
@@ -170,6 +179,9 @@ static void chumby_cp_init(Object *obj)
 {
     ChumbyCPChardev *cp = CHARDEV_CHUMBY_CP(obj);
 
+    chumby_cp_set_identity(cp, cp_default_guid, CHUMBY_CP_DEFAULT_SERIAL,
+                           CHUMBY_CP_DEFAULT_HW_MAJOR,
+                           CHUMBY_CP_DEFAULT_HW_MINOR);
     timer_init_ns(&cp->timer, QEMU_CLOCK_VIRTUAL, chumby_cp_timer, cp);
 }
 
diff --git a/include/hw/char/chumby_cp.h b/include/hw/char/chumby_cp.h
index 7a55d7b53..31fbfa9e6 100644
--- a/include/hw/char/chumby_cp.h
+++ b/include/hw/char/chumby_cp.h
@@ -19,9 +19,21 @@ OBJECT_DECLARE_SIMPLE_TYPE(ChumbyCPChardev, CHARDEV_CHUMBY_CP)
 #define CHUMBY_CP_LINE_MAX  256
 #define CHUMBY_CP_OUT_MAX   512
 
+#define CHUMBY_CP_GUID_LEN          16
+#define CHUMBY_CP_SERIAL_LEN        16
+#define CHUMBY_CP_DEFAULT_GUID      "C40BB1E0-0000-4000-8000-0E4000000001"
+#define CHUMBY_CP_DEFAULT_SERIAL    "0000000000000000"
+#define CHUMBY_CP_DEFAULT_HW_MAJOR  3
+#define CHUMBY_CP_DEFAULT_HW_MINOR  8
+
 struct ChumbyCPChardev {
     Chardev parent;
 
+    /* The identity it reports. */
+    uint8_t guid[CHUMBY_CP_GUID_LEN];
+    uint8_t serial[CHUMBY_CP_SERIAL_LEN];
+    uint8_t hwver[16];
+
     QEMUTimer timer;
     /* The request being received. */
     uint8_t line[CHUMBY_CP_LINE_MAX];
@@ -33,4 +45,12 @@ struct ChumbyCPChardev {
     int out_len;
 };
 
+/*
+ * Sets the identity the CP reports: a 16-byte GUID, a serial number of
+ * CHUMBY_CP_SERIAL_LEN characters and the hardware version.
+ */
+void chumby_cp_set_identity(ChumbyCPChardev *cp, const uint8_t *guid,
+                            const char *serial, uint8_t hw_major,
+                            uint8_t hw_minor);
+
 #endif /* HW_CHAR_CHUMBY_CP_H */
