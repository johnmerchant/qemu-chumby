From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Wed, 28 Oct 2026 13:12:21 +0000
Subject: [PATCH 06/11] hw/display: Add the i.MX21 LCD controller

A background plane and a graphic window blended over it with alpha and
a colour key, both 16 bpp RGB565 in system memory, shown on a QEMU
graphic console.

Signed-off-by: John Merchant <john@johnmerchant.dev>
---
 hw/display/imx21_lcdc.c         | 276 ++++++++++++++++++++++++++++++++
 hw/display/meson.build          |   1 +
 include/hw/display/imx21_lcdc.h |  32 ++++
 3 files changed, 309 insertions(+)
 create mode 100644 hw/display/imx21_lcdc.c
 create mode 100644 include/hw/display/imx21_lcdc.h

diff --git a/hw/display/imx21_lcdc.c b/hw/display/imx21_lcdc.c
new file mode 100644
index 000000000..da2fa57f8
--- /dev/null
+++ b/hw/display/imx21_lcdc.c
@@ -0,0 +1,276 @@
+/*
+ * i.MX21 LCD controller (LCDC)
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * A background plane and a graphic window overlaid on it with alpha
+ * blending and a colour key, both read from system memory. Only 16 bpp
+ * (RGB565) frames are drawn. The registers are kept as written; every
+ * frame has always ended, so the interrupt status reads as such.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/display/imx21_lcdc.h"
+#include "hw/core/irq.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/bswap.h"
+#include "qemu/module.h"
+#include "system/address-spaces.h"
+#include "ui/pixel_ops.h"
+
+#define LSSAR       0x00
+#define LSR         0x04
+#define LVPWR       0x08
+#define LPCR        0x18
+#define LISR        0x40
+#define LGWSAR      0x50
+#define LGWSR       0x54
+#define LGWVPWR     0x58
+#define LGWPOR      0x5c
+#define LGWPR       0x60
+#define LGWCR       0x64
+#define PALETTE     0x800
+#define PALETTE_END 0xbff
+
+#define LPCR_BPIX_16    5
+#define LGWCR_GWE       (1 << 22)
+#define LGWCR_GWCKE     (1 << 23)
+
+/* LISR: end of frame, and the graphic window's end of frame */
+#define LISR_EOF        (1 << 0)
+#define LISR_GW_EOF     (1 << 5)
+
+#define MAX_WIDTH       1024
+#define DEFAULT_WIDTH   320
+#define DEFAULT_HEIGHT  240
+
+#define REG(s, r)       ((s)->regs[(r) / 4])
+
+static uint64_t imx21_lcdc_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX21LCDCState *s = opaque;
+
+    if (offset == LISR) {
+        return LISR_EOF | LISR_GW_EOF;
+    }
+    if (offset >= PALETTE && offset <= PALETTE_END) {
+        return s->palette[(offset - PALETTE) / 4];
+    }
+    if (offset < sizeof(s->regs)) {
+        return REG(s, offset);
+    }
+    qemu_log_mask(LOG_GUEST_ERROR, "%s: bad register at 0x%" HWADDR_PRIx
+                  "\n", __func__, offset);
+    return 0;
+}
+
+static void imx21_lcdc_write(void *opaque, hwaddr offset, uint64_t val,
+                             unsigned size)
+{
+    IMX21LCDCState *s = opaque;
+
+    if (offset >= PALETTE && offset <= PALETTE_END) {
+        s->palette[(offset - PALETTE) / 4] = val;
+    } else if (offset < sizeof(s->regs)) {
+        REG(s, offset) = val;
+    } else {
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad register at 0x%"
+                      HWADDR_PRIx "\n", __func__, offset);
+    }
+}
+
+static const MemoryRegionOps imx21_lcdc_ops = {
+    .read = imx21_lcdc_read,
+    .write = imx21_lcdc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void imx21_lcdc_size(IMX21LCDCState *s, int *w, int *h)
+{
+    *w = extract32(REG(s, LSR), 20, 6) * 16;
+    *h = extract32(REG(s, LSR), 0, 10);
+    if (*w == 0 || *h == 0) {
+        *w = DEFAULT_WIDTH;
+        *h = DEFAULT_HEIGHT;
+    }
+}
+
+static uint32_t rgb565_to_rgb888(uint16_t p)
+{
+    unsigned r = (p >> 11) & 0x1f;
+    unsigned g = (p >> 5) & 0x3f;
+    unsigned b = p & 0x1f;
+
+    return rgb_to_pixel32((r << 3) | (r >> 2), (g << 2) | (g >> 4),
+                          (b << 3) | (b >> 2));
+}
+
+static void imx21_lcdc_read_line(hwaddr addr, uint16_t *line, int n)
+{
+    int i;
+
+    address_space_read(&address_space_memory, addr, MEMTXATTRS_UNSPECIFIED,
+                       line, n * 2);
+    for (i = 0; i < n; i++) {
+        line[i] = le16_to_cpu(line[i]);
+    }
+}
+
+/* Composes the visible frame into dest, w x h pixels of xRGB8888. */
+static void imx21_lcdc_render(IMX21LCDCState *s, uint32_t *dest, int w, int h)
+{
+    uint16_t line[MAX_WIDTH];
+    uint32_t base = REG(s, LSSAR);
+    uint32_t stride = MAX(extract32(REG(s, LVPWR), 0, 11), 1) * 4;
+    uint32_t gwcr = REG(s, LGWCR);
+    int x, y;
+
+    if (!base || extract32(REG(s, LPCR), 25, 3) != LPCR_BPIX_16) {
+        memset(dest, 0, w * h * 4);
+        return;
+    }
+    for (y = 0; y < h; y++) {
+        imx21_lcdc_read_line(base + y * stride, line, w);
+        for (x = 0; x < w; x++) {
+            dest[y * w + x] = rgb565_to_rgb888(line[x]);
+        }
+    }
+
+    if ((gwcr & LGWCR_GWE) && REG(s, LGWSAR)) {
+        unsigned alpha = extract32(gwcr, 24, 8);
+        /* The colour key has 6 bits per channel. */
+        uint32_t key = (extract32(gwcr, 12, 6) << 18) |
+                       (extract32(gwcr, 6, 6) << 10) |
+                       (extract32(gwcr, 0, 6) << 2);
+        int gw = MIN(extract32(REG(s, LGWSR), 20, 6) * 16, MAX_WIDTH);
+        int gh = extract32(REG(s, LGWSR), 0, 10);
+        int gx = extract32(REG(s, LGWPR), 16, 10);
+        int gy = extract32(REG(s, LGWPR), 0, 10);
+        uint32_t gstride = MAX(extract32(REG(s, LGWVPWR), 0, 11), 1) * 4;
+        uint32_t goff = extract32(REG(s, LGWPOR), 0, 5);
+
+        for (y = 0; y < gh && gy + y < h; y++) {
+            imx21_lcdc_read_line(REG(s, LGWSAR) + y * gstride + goff * 2,
+                                 line, gw);
+            for (x = 0; x < gw && gx + x < w; x++) {
+                uint32_t p = rgb565_to_rgb888(line[x]);
+                uint32_t *d = &dest[(gy + y) * w + gx + x];
+                uint32_t bg = *d, out = 0;
+                int shift;
+
+                if ((gwcr & LGWCR_GWCKE) && (p & 0xfcfcfc) == key) {
+                    continue;
+                }
+                for (shift = 0; shift < 24; shift += 8) {
+                    unsigned a = (p >> shift) & 0xff;
+                    unsigned b = (bg >> shift) & 0xff;
+
+                    out |= ((a * alpha + b * (255 - alpha)) / 255) << shift;
+                }
+                *d = out;
+            }
+        }
+    }
+}
+
+static bool imx21_lcdc_update_display(void *opaque)
+{
+    IMX21LCDCState *s = opaque;
+    DisplaySurface *surface = qemu_console_surface(s->con);
+    g_autofree uint32_t *frame = NULL;
+    int w, h;
+
+    imx21_lcdc_size(s, &w, &h);
+    w = MIN(w, MAX_WIDTH);
+    if (!surface || surface_width(surface) != w ||
+        surface_height(surface) != h) {
+        qemu_console_resize(s->con, w, h);
+        surface = qemu_console_surface(s->con);
+    }
+    if (surface_bits_per_pixel(surface) != 32) {
+        return true;
+    }
+    frame = g_new(uint32_t, w * h);
+    imx21_lcdc_render(s, frame, w, h);
+    /* Only changed frames go to the displays. */
+    if (memcmp(surface_data(surface), frame, w * h * 4)) {
+        memcpy(surface_data(surface), frame, w * h * 4);
+        qemu_console_update_full(s->con);
+    }
+    return true;
+}
+
+static void imx21_lcdc_invalidate_display(void *opaque)
+{
+    IMX21LCDCState *s = opaque;
+
+    qemu_console_update_full(s->con);
+}
+
+static const GraphicHwOps imx21_lcdc_gfx_ops = {
+    .invalidate = imx21_lcdc_invalidate_display,
+    .gfx_update = imx21_lcdc_update_display,
+};
+
+static void imx21_lcdc_reset(DeviceState *dev)
+{
+    IMX21LCDCState *s = IMX21_LCDC(dev);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->palette, 0, sizeof(s->palette));
+}
+
+static void imx21_lcdc_realize(DeviceState *dev, Error **errp)
+{
+    IMX21LCDCState *s = IMX21_LCDC(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    memory_region_init_io(&s->iomem, OBJECT(dev), &imx21_lcdc_ops, s,
+                          TYPE_IMX21_LCDC, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->con = qemu_graphic_console_create(dev, 0, &imx21_lcdc_gfx_ops, s);
+    qemu_console_resize(s->con, DEFAULT_WIDTH, DEFAULT_HEIGHT);
+}
+
+static const VMStateDescription vmstate_imx21_lcdc = {
+    .name = TYPE_IMX21_LCDC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(regs, IMX21LCDCState, IMX21_LCDC_NUM_REGS),
+        VMSTATE_UINT32_ARRAY(palette, IMX21LCDCState, 256),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx21_lcdc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = imx21_lcdc_realize;
+    dc->vmsd = &vmstate_imx21_lcdc;
+    device_class_set_legacy_reset(dc, imx21_lcdc_reset);
+    dc->desc = "i.MX21 LCD controller";
+}
+
+static const TypeInfo imx21_lcdc_info = {
+    .name = TYPE_IMX21_LCDC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMX21LCDCState),
+    .class_init = imx21_lcdc_class_init,
+};
+
+static void imx21_lcdc_register_types(void)
+{
+    type_register_static(&imx21_lcdc_info);
+}
+
+type_init(imx21_lcdc_register_types)
diff --git a/hw/display/meson.build b/hw/display/meson.build
index ffecedbf7..f2aaa4de5 100644
--- a/hw/display/meson.build
+++ b/hw/display/meson.build
@@ -143,3 +143,4 @@ endif
 system_ss.add(when: 'CONFIG_OMAP', if_true: files('omap_lcdc.c'))
 
 modules += { 'hw-display': hw_display_modules }
+system_ss.add(when: 'CONFIG_FSL_IMX21', if_true: files('imx21_lcdc.c'))
diff --git a/include/hw/display/imx21_lcdc.h b/include/hw/display/imx21_lcdc.h
new file mode 100644
index 000000000..f01408804
--- /dev/null
+++ b/include/hw/display/imx21_lcdc.h
@@ -0,0 +1,32 @@
+/*
+ * i.MX21 LCD controller (LCDC)
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_LCDC_H
+#define IMX21_LCDC_H
+
+#include "hw/core/sysbus.h"
+#include "ui/console.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_LCDC "imx21.lcdc"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21LCDCState, IMX21_LCDC)
+
+#define IMX21_LCDC_NUM_REGS (0x80 / 4)
+
+struct IMX21LCDCState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    QemuConsole *con;
+
+    uint32_t regs[IMX21_LCDC_NUM_REGS];
+    uint32_t palette[256];
+};
+
+#endif /* IMX21_LCDC_H */
