-
-static void imx21_usbotg_write(void *opaque, hwaddr offset, uint64_t val,
-                               unsigned size)
-{
-    IMX21USBOTGState *s = opaque;
-    uint32_t *r = &s->regs[offset / 4];
-
-    switch (offset) {
-    case RST_CTRL:
-        break;
-    case ROOTHUBA:
-        /* The port count is fixed. */
-        *r = (*r & 0xff) | (val & ~0xffu);
-        break;
-    case PORTSTAT0 ... PORTSTAT2:
-        /*
-         * Port status is write-1-to-act; with nothing connected the only
-         * state that sticks is port power.
-         */
-        if (val & PORTSTAT_PPS) {
-            *r |= PORTSTAT_PPS;
-        }
-        if (val & PORTSTAT_LSDA) {
-            *r &= ~PORTSTAT_PPS;
-        }
-        break;
-    default:
-        *r = val;
-        break;
-    }
