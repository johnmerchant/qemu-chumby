diff --git a/hw/misc/imx21_pwm.c b/hw/misc/imx21_pwm.c
new file mode 100644
--- /dev/null
+++ b/hw/misc/imx21_pwm.c
@@ -0,0 +1,355 @@
+/*
+ * i.MX21 PWM
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The i.MX1-style PWM: control, sample, period and counter registers.
+ * A period is PWMP + 2 cycles of PERCLK1, divided by the prescaler and
+ * CLKSEL, or of the 32 kHz clock. Samples written to PWMS queue in a small
+ * FIFO; each takes over at the end of a period and lasts REPEAT periods,
+ * and the last one stays in use when the FIFO runs dry. The output is
+ * high for the sample's count of cycles each period, so a sample at or
+ * above the period keeps it high; it is low while the PWM is disabled.
+ *
+ * The output is the GPIO output line, whose level is the duty cycle from
+ * 0 (always low) to IMX21_PWM_DUTY_MAX (always high). It changes only when
+ * the guest changes the duty cycle, not at reset, so a board can decide
+ * what an unprogrammed PWM shows. The interrupt, and the byte and
+ * half-word swaps for audio samples, are not modelled.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/imx21_pwm.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "trace.h"
+
+#define PWMC        0x00
+#define PWMS        0x04
+#define PWMP        0x08
+#define PWMCNT      0x0c
+
+#define PWMC_CLKSEL     (3 << 0)
+#define PWMC_REPEAT_SHIFT 2
+#define PWMC_REPEAT     (3 << PWMC_REPEAT_SHIFT)
+#define PWMC_EN         (1 << 4)
+#define PWMC_FIFOAV     (1 << 5)
+#define PWMC_IRQEN      (1 << 6)
+#define PWMC_IRQ        (1 << 7)
+#define PWMC_PRESCALER_SHIFT 8
+#define PWMC_PRESCALER  (0x7f << PWMC_PRESCALER_SHIFT)
+#define PWMC_CLKSRC     (1 << 15)
+#define PWMC_SWR        (1 << 16)
+#define PWMC_BCTR       (1 << 17)
+#define PWMC_HCTR       (1 << 18)
+#define PWMC_WRITABLE   (PWMC_CLKSEL | PWMC_REPEAT | PWMC_EN | PWMC_IRQEN | \
+                         PWMC_PRESCALER | PWMC_CLKSRC | PWMC_BCTR | PWMC_HCTR)
+
+#define CLK32_FREQ      32768
+
+static bool imx21_pwm_enabled(IMX21PWMState *s)
+{
+    return s->pwmc & PWMC_EN;
+}
+
+/* Counter cycles in a period. */
+static uint32_t imx21_pwm_period(IMX21PWMState *s)
+{
+    return (s->pwmp & 0xffff) + 2;
+}
+
+/* Length of a counter cycle, in ns. */
+static uint64_t imx21_pwm_cycle_ns(IMX21PWMState *s)
+{
+    uint64_t div;
+
+    if (s->pwmc & PWMC_CLKSRC) {
+        return NANOSECONDS_PER_SECOND / CLK32_FREQ;
+    }
+    div = (2 << (s->pwmc & PWMC_CLKSEL)) *
+          (extract32(s->pwmc, PWMC_PRESCALER_SHIFT, 7) + 1);
+    return MAX(muldiv64(div, NANOSECONDS_PER_SECOND,
+                        MAX(s->perclk_freq, 1)), 1);
+}
+
+static uint64_t imx21_pwm_period_ns(IMX21PWMState *s)
+{
+    return imx21_pwm_cycle_ns(s) * imx21_pwm_period(s);
+}
+
+/* Periods each sample lasts. */
+static uint32_t imx21_pwm_repeats(IMX21PWMState *s)
+{
+    return 1 << extract32(s->pwmc, PWMC_REPEAT_SHIFT, 2);
+}
+
+static void imx21_pwm_update_output(IMX21PWMState *s)
+{
+    uint32_t period = imx21_pwm_period(s);
+    int32_t duty = 0;
+
+    if (imx21_pwm_enabled(s)) {
+        duty = muldiv64(MIN(s->sample, period), IMX21_PWM_DUTY_MAX, period);
+    }
+    if (duty != s->duty) {
+        trace_imx21_pwm_output(s->sample, period, duty);
+        s->duty = duty;
+        qemu_set_irq(s->out, duty);
+    }
+}
+
+/* Moves the next queued sample into use. */
+static void imx21_pwm_load_sample(IMX21PWMState *s)
+{
+    s->sample = s->fifo[0];
+    s->fifo_count--;
+    memmove(s->fifo, s->fifo + 1, s->fifo_count * sizeof(s->fifo[0]));
+    s->repeat = imx21_pwm_repeats(s) - 1;
+}
+
+/*
+ * Brings period_start up to the start of the period now running, with
+ * the repeat count spent by the periods gone by.
+ */
+static void imx21_pwm_catch_up(IMX21PWMState *s, int64_t now)
+{
+    uint64_t period_ns = imx21_pwm_period_ns(s);
+    uint64_t periods;
+
+    if (now <= s->period_start) {
+        return;
+    }
+    periods = (now - s->period_start) / period_ns;
+    s->period_start += periods * period_ns;
+    s->repeat -= MIN(s->repeat, periods);
+}
+
+/* Wakes at the end of the period when a queued sample is due. */
+static void imx21_pwm_schedule(IMX21PWMState *s)
+{
+    if (!imx21_pwm_enabled(s) || !s->fifo_count) {
+        timer_del(&s->timer);
+        return;
+    }
+    timer_mod(&s->timer, s->period_start +
+              (s->repeat + 1) * imx21_pwm_period_ns(s));
+}
+
+static void imx21_pwm_timeout(void *opaque)
+{
+    IMX21PWMState *s = opaque;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    imx21_pwm_catch_up(s, now);
+    if (s->fifo_count && !s->repeat) {
+        imx21_pwm_load_sample(s);
+    }
+    imx21_pwm_update_output(s);
+    imx21_pwm_schedule(s);
+}
+
+static void imx21_pwm_do_reset(IMX21PWMState *s)
+{
+    timer_del(&s->timer);
+    s->pwmc = 0;
+    s->pwmp = 0;
+    s->sample = 0;
+    s->fifo_count = 0;
+    s->repeat = 0;
+    s->period_start = 0;
+}
+
+static uint32_t imx21_pwm_counter(IMX21PWMState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (!imx21_pwm_enabled(s) || now <= s->period_start) {
+        return 0;
+    }
+    return ((now - s->period_start) / imx21_pwm_cycle_ns(s)) %
+           imx21_pwm_period(s);
+}
+
+static uint64_t imx21_pwm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX21PWMState *s = opaque;
+
+    switch (offset) {
+    case PWMC:
+        return s->pwmc |
+               (s->fifo_count < IMX21_PWM_FIFO_DEPTH ? PWMC_FIFOAV : 0);
+    case PWMS:
+        return s->sample;
+    case PWMP:
+        return s->pwmp;
+    case PWMCNT:
+        return imx21_pwm_counter(s);
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad register at 0x%"
+                      HWADDR_PRIx "\n", __func__, offset);
+        return 0;
+    }
+}
+
+static void imx21_pwm_write_control(IMX21PWMState *s, uint32_t val)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    bool was_enabled = imx21_pwm_enabled(s);
+
+    if (val & PWMC_SWR) {
+        /* The reset is over at once: the bit never reads as set. */
+        imx21_pwm_do_reset(s);
+        imx21_pwm_update_output(s);
+        return;
+    }
+    if (was_enabled) {
+        imx21_pwm_catch_up(s, now);
+    }
+    s->pwmc = val & PWMC_WRITABLE;
+    if (!was_enabled && imx21_pwm_enabled(s)) {
+        /* A new period starts, with the first queued sample. */
+        s->period_start = now;
+        if (s->fifo_count) {
+            imx21_pwm_load_sample(s);
+        }
+    }
+    imx21_pwm_update_output(s);
+    imx21_pwm_schedule(s);
+}
+
+static void imx21_pwm_write_sample(IMX21PWMState *s, uint32_t val)
+{
+    if (s->fifo_count == IMX21_PWM_FIFO_DEPTH) {
+        trace_imx21_pwm_fifo_full(val);
+        return;
+    }
+    s->fifo[s->fifo_count++] = val & 0xffff;
+    if (imx21_pwm_enabled(s) && !timer_pending(&s->timer)) {
+        imx21_pwm_catch_up(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+        imx21_pwm_schedule(s);
+    }
+}
+
+static void imx21_pwm_write(void *opaque, hwaddr offset, uint64_t val,
+                            unsigned size)
+{
+    IMX21PWMState *s = opaque;
+
+    trace_imx21_pwm_write(offset, val);
+    switch (offset) {
+    case PWMC:
+        imx21_pwm_write_control(s, val);
+        break;
+    case PWMS:
+        imx21_pwm_write_sample(s, val);
+        break;
+    case PWMP:
+        if (imx21_pwm_enabled(s)) {
+            imx21_pwm_catch_up(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+        }
+        s->pwmp = val & 0xffff;
+        imx21_pwm_update_output(s);
+        imx21_pwm_schedule(s);
+        break;
+    case PWMCNT:
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad register at 0x%"
+                      HWADDR_PRIx "\n", __func__, offset);
+        break;
+    }
+}
+
+static const MemoryRegionOps imx21_pwm_ops = {
+    .read = imx21_pwm_read,
+    .write = imx21_pwm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void imx21_pwm_reset(DeviceState *dev)
+{
+    IMX21PWMState *s = IMX21_PWM(dev);
+
+    imx21_pwm_do_reset(s);
+    /* Nothing has been driven yet: the next level is always sent. */
+    s->duty = -1;
+}
+
+static void imx21_pwm_init(Object *obj)
+{
+    IMX21PWMState *s = IMX21_PWM(obj);
+
+    memory_region_init_io(&s->iomem, obj, &imx21_pwm_ops, s,
+                          TYPE_IMX21_PWM, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+    qdev_init_gpio_out(DEVICE(obj), &s->out, 1);
+    timer_init_ns(&s->timer, QEMU_CLOCK_VIRTUAL, imx21_pwm_timeout, s);
+}
+
+static const Property imx21_pwm_properties[] = {
+    /* PERCLK1: 266 MHz MPLL / 6, as the boot loader leaves it. */
+    DEFINE_PROP_UINT32("perclk-freq", IMX21PWMState, perclk_freq, 44333333),
+};
+
+static int imx21_pwm_post_load(void *opaque, int version_id)
+{
+    IMX21PWMState *s = opaque;
+
+    if (s->fifo_count > IMX21_PWM_FIFO_DEPTH) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static const VMStateDescription vmstate_imx21_pwm = {
+    .name = TYPE_IMX21_PWM,
+    .version_id = 2,
+    .minimum_version_id = 2,
+    .post_load = imx21_pwm_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(pwmc, IMX21PWMState),
+        VMSTATE_UINT32(pwmp, IMX21PWMState),
+        VMSTATE_UINT32(sample, IMX21PWMState),
+        VMSTATE_UINT32_ARRAY(fifo, IMX21PWMState, IMX21_PWM_FIFO_DEPTH),
+        VMSTATE_UINT32(fifo_count, IMX21PWMState),
+        VMSTATE_UINT32(repeat, IMX21PWMState),
+        VMSTATE_INT64(period_start, IMX21PWMState),
+        VMSTATE_INT32(duty, IMX21PWMState),
+        VMSTATE_TIMER(timer, IMX21PWMState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx21_pwm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_imx21_pwm;
+    device_class_set_legacy_reset(dc, imx21_pwm_reset);
+    device_class_set_props(dc, imx21_pwm_properties);
+    dc->desc = "i.MX21 PWM";
+}
+
+static const TypeInfo imx21_pwm_info = {
+    .name = TYPE_IMX21_PWM,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMX21PWMState),
+    .instance_init = imx21_pwm_init,
+    .class_init = imx21_pwm_class_init,
+};
+
+static void imx21_pwm_register_types(void)
+{
+    type_register_static(&imx21_pwm_info);
+}
+
+type_init(imx21_pwm_register_types)
