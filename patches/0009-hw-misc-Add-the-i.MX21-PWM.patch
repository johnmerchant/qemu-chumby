diff --git a/include/hw/misc/imx21_pwm.h b/include/hw/misc/imx21_pwm.h
new file mode 100644
--- /dev/null
+++ b/include/hw/misc/imx21_pwm.h
@@ -0,0 +1,50 @@
+/*
+ * i.MX21 PWM
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_PWM_H
+#define IMX21_PWM_H
+
+#include "hw/core/sysbus.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_PWM "imx21.pwm"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21PWMState, IMX21_PWM)
+
+/* Samples the FIFO holds besides the one in use. */
+#define IMX21_PWM_FIFO_DEPTH 2
+
+/*
+ * The output's duty cycle, the GPIO output's level: 0 (always low) to
+ * IMX21_PWM_DUTY_MAX (always high).
+ */
+#define IMX21_PWM_DUTY_MAX 0xffff
+
+struct IMX21PWMState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    QEMUTimer timer;
+    qemu_irq out;
+    uint32_t perclk_freq;
+
+    uint32_t pwmc;
+    uint32_t pwmp;
+    /* The sample in use, and those queued behind it. */
+    uint32_t sample;
+    uint32_t fifo[IMX21_PWM_FIFO_DEPTH];
+    uint32_t fifo_count;
+    /* Periods left before the next sample loads (PWMC REPEAT). */
+    uint32_t repeat;
+    /* When the current period started, in virtual-clock ns. */
+    int64_t period_start;
+    /* The level last driven on the output, -1 before the first. */
+    int32_t duty;
+};
+
+#endif /* IMX21_PWM_H */
