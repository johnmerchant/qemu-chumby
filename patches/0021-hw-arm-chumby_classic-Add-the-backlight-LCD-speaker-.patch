new file mode 100644
index 000000000..898fd6424
--- /dev/null
+++ b/include/hw/misc/chumby_io.h
@@ -0,0 +1,54 @@
+/*
+ * Chumby Classic board controls
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef CHUMBY_IO_H
+#define CHUMBY_IO_H
+
+#include "hw/core/qdev.h"
+#include "ui/input.h"
+#include "qom/object.h"
+
+#define TYPE_CHUMBY_IO "chumby-io"
+OBJECT_DECLARE_SIMPLE_TYPE(ChumbyIOState, CHUMBY_IO)
+
+/* GPIO inputs, from the SoC */
+#define CHUMBY_IO_BACKLIGHT     "backlight"     /* PWM duty, 0 to 0xffff */
+#define CHUMBY_IO_LCD_POWER     "lcd-power"     /* high: panel on */
+#define CHUMBY_IO_AMP_MUTE      "amp-mute"      /* high: speaker muted */
+
+/* GPIO outputs */
+#define CHUMBY_IO_LCD_BRIGHTNESS "lcd-brightness" /* to the LCDC */
+#define CHUMBY_IO_BUTTON_N      "button-n"      /* low while held */
+#define CHUMBY_IO_HEADPHONES_N  "headphones-n"  /* low while plugged in */
+#define CHUMBY_IO_SPEAKER_MUTE  "speaker-mute"  /* high: speaker muted */
+#define CHUMBY_IO_HEADPHONES    "headphones"    /* high: plugged in */
+
+#define CHUMBY_IO_BACKLIGHT_MAX 0xffff
+
+struct ChumbyIOState {
+    DeviceState parent_obj;
+
+    qemu_irq lcd_brightness;
+    qemu_irq button_n;
+    qemu_irq headphones_n;
+    qemu_irq speaker_mute_out;
+    qemu_irq headphones_out;
+    QemuInputHandlerState *key_handler;
+    char *button_key;
+    int button_qcode;
+
+    /* Driven by the guest */
+    uint32_t backlight;
+    bool lcd_on;
+    bool speaker_mute;
+    /* Driven by the user */
+    bool button;
+    bool headphones;
+};
+
+#endif /* CHUMBY_IO_H */
