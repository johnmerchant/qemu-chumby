diff --git a/include/hw/audio/imx21_audmux.h b/include/hw/audio/imx21_audmux.h
new file mode 100644
index 000000000..5afb59990
--- /dev/null
+++ b/include/hw/audio/imx21_audmux.h
@@ -0,0 +1,40 @@
+/*
+ * i.MX21 digital audio multiplexer (AUDMUX)
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_AUDMUX_H
+#define IMX21_AUDMUX_H
+
+#include "hw/audio/imx21_ssi.h"
+
+#define TYPE_IMX21_AUDMUX "imx21.audmux"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21AudmuxState, IMX21_AUDMUX)
+
+/* Host ports 1-3 (1 and 2 are SSI1 and SSI2) and peripheral ports 1-3 */
+#define IMX21_AUDMUX_PORTS  3
+
+struct IMX21AudmuxState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    IMX21SSIState *ssi[2];
+
+    uint32_t hpcr[IMX21_AUDMUX_PORTS];
+    uint32_t ppcr[IMX21_AUDMUX_PORTS];
+};
+
+/*
+ * A device on peripheral port @pport (0 for port 1) taking (giving)
+ * audio from (to) whichever host port the multiplexer routes there.
+ * Same conventions as imx21_ssi_transmit() and imx21_ssi_receive().
+ */
+bool imx21_audmux_transmit(IMX21AudmuxState *s, int pport,
+                           int16_t *samples, int frames);
+bool imx21_audmux_receive(IMX21AudmuxState *s, int pport,
+                          const int16_t *samples, int frames);
+
+#endif /* IMX21_AUDMUX_H */
diff --git a/include/hw/audio/imx21_ssi.h b/include/hw/audio/imx21_ssi.h
new file mode 100644
index 000000000..690051646
--- /dev/null
+++ b/include/hw/audio/imx21_ssi.h
@@ -0,0 +1,69 @@
+/*
+ * i.MX21 synchronous serial interface (SSI)
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_SSI_H
+#define IMX21_SSI_H
+
+#include "hw/core/sysbus.h"
+#include "qemu/fifo32.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_SSI "imx21.ssi"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21SSIState, IMX21_SSI)
+
+#define IMX21_SSI_FIFO_SIZE 8
+
+/* Named GPIO outputs "dma": the DMA requests, active high. */
+#define IMX21_SSI_DMA       "dma"
+#define IMX21_SSI_DMA_TX0   0
+#define IMX21_SSI_DMA_RX0   1
+#define IMX21_SSI_DMA_TX1   2
+#define IMX21_SSI_DMA_RX1   3
+#define IMX21_SSI_NUM_DMA   4
+
+struct IMX21SSIState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    qemu_irq dma[IMX21_SSI_NUM_DMA];
+
+    uint32_t scr;
+    uint32_t sier;
+    uint32_t stcr;
+    uint32_t srcr;
+    uint32_t stccr;
+    uint32_t srccr;
+    uint32_t sfcsr;
+    uint32_t str;
+    uint32_t sor;
+    uint32_t sacnt;
+    uint32_t sacadd;
+    uint32_t sacdat;
+    uint32_t satag;
+    uint32_t stmsk;
+    uint32_t srmsk;
+    /* Sticky status: underrun and overrun. */
+    uint32_t sisr;
+    Fifo32 tx[2];
+    Fifo32 rx[2];
+    uint32_t last_rx[2];
+    uint32_t dma_level;
+};
+
+/*
+ * The serial side, for the audio multiplexer: the codec clocks @frames
+ * frames out of or into the SSI, as 16-bit stereo samples. Each frame
+ * carries the frame's first two unmasked slots as left and right.
+ * Returns whether the transmitter (receiver) is enabled; a disabled
+ * transmitter gives silence.
+ */
+bool imx21_ssi_transmit(IMX21SSIState *s, int16_t *samples, int frames);
+bool imx21_ssi_receive(IMX21SSIState *s, const int16_t *samples, int frames);
+
+#endif /* IMX21_SSI_H */
