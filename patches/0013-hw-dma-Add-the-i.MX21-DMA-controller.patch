diff --git a/include/hw/dma/imx21_dma.h b/include/hw/dma/imx21_dma.h
new file mode 100644
index 000000000..8cce5d80e
--- /dev/null
+++ b/include/hw/dma/imx21_dma.h
@@ -0,0 +1,68 @@
+/*
+ * i.MX21 DMA controller (DMAC)
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_DMA_H
+#define IMX21_DMA_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_DMA "imx21.dma"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21DMAState, IMX21_DMA)
+
+#define IMX21_DMA_CHANNELS  16
+/*
+ * GPIO inputs: the 32 DMA request lines, active high, numbered as in the
+ * channels' RSSR (1 CSPI3 receive, 13 SSI1 transmit FIFO 0, ...).
+ */
+#define IMX21_DMA_REQUESTS  32
+
+typedef struct IMX21DMAChannel {
+    uint32_t sar;
+    uint32_t dar;
+    uint32_t cntr;
+    uint32_t ccr;
+    uint32_t rssr;
+    uint32_t blr;
+    uint32_t rtor;
+    /* The transfer in progress: addresses and count loaded at its start. */
+    bool active;
+    uint32_t src;
+    uint32_t dst;
+    uint32_t count;
+    uint32_t done;
+    /* A burst forced by CCR.FRC, not yet made. */
+    bool force;
+} IMX21DMAChannel;
+
+struct IMX21DMAState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq[IMX21_DMA_CHANNELS];
+    QEMUBH *bh;
+
+    uint32_t dcr;
+    uint32_t disr;
+    uint32_t dimr;
+    uint32_t dbtosr;
+    uint32_t drtosr;
+    uint32_t dsesr;
+    uint32_t dbosr;
+    uint32_t dbtocr;
+    /* 2D memory geometry: W, X and Y for sets A and B. */
+    uint32_t wsr[2];
+    uint32_t xsr[2];
+    uint32_t ysr[2];
+    IMX21DMAChannel ch[IMX21_DMA_CHANNELS];
+
+    uint32_t requests;
+    bool running;
+};
+
+#endif /* IMX21_DMA_H */
