--- /dev/null
+++ b/include/hw/gpio/imx21_gpio.h
@@ -0,0 +1,37 @@
+/*
+ * i.MX21 GPIO ports A-F
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_GPIO_H
+#define IMX21_GPIO_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_GPIO "imx21.gpio"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21GPIOState, IMX21_GPIO)
+
+#define IMX21_GPIO_NUM_PORTS 6
+#define IMX21_GPIO_PINS_PER_PORT 32
+#define IMX21_GPIO_NUM_PINS (IMX21_GPIO_NUM_PORTS * IMX21_GPIO_PINS_PER_PORT)
+#define IMX21_GPIO_NUM_REGS (0x44 / 4)
+
+struct IMX21GPIOState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    qemu_irq output[IMX21_GPIO_NUM_PINS];
+
+    uint32_t regs[IMX21_GPIO_NUM_PORTS][IMX21_GPIO_NUM_REGS];
+    uint32_t isr[IMX21_GPIO_NUM_PORTS];
+    /* Levels driven on the pins from outside; inputs idle high. */
+    uint32_t pins[IMX21_GPIO_NUM_PORTS];
+    uint32_t pmask;
+};
+
+#endif /* IMX21_GPIO_H */
