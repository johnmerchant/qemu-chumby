@@ -0,0 +1,43 @@
+/*
+ * i.MX21 general purpose timer (GPT)
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_GPT_H
+#define IMX21_GPT_H
+
+#include "hw/core/sysbus.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_GPT "imx21.gpt"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21GPTState, IMX21_GPT)
+
+struct IMX21GPTState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    QEMUTimer timer;
+    qemu_irq irq;
+
+    uint32_t tctl;
+    uint32_t tprer;
+    uint32_t tcmp;
+    uint32_t tcr;
+    uint32_t tstat;
+
+    /* The counter held cnt_base at t0_ns and has counted at freq since. */
+    uint32_t cnt_base;
+    int64_t t0_ns;
+    /* The tick, counted from t0_ns, of the next compare event. */
+    uint64_t next_cmp_tick;
+    /* A late compare event: TCN holds at TCMP until it is acknowledged. */
+    bool hold;
+
+    uint32_t perclk_freq;
+};
+
+#endif /* IMX21_GPT_H */
