+/*
+ * i.MX21 general purpose timer (GPT)
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The i.MX1-style timer of the i.MX21 (GPT1-3): a 32-bit up-counter
+ * behind an 11-bit prescaler, with one compare and one capture register,
+ * in restart or free-running mode. Unlike the i.MX25/31 GPT, it has a
+ * single compare channel and a different register layout. Capture is not
+ * modelled.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/timer/imx21_gpt.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+#define TCTL    0x00
+#define TPRER   0x04
+#define TCMP    0x08
+#define TCR     0x0c
+#define TCN     0x10
+#define TSTAT   0x14
+
+#define TCTL_TEN        (1 << 0)
+#define TCTL_CLKSOURCE  (7 << 1)
+#define TCTL_COMPEN     (1 << 4)
+#define TCTL_CAPTEN     (1 << 5)
+#define TCTL_FRR        (1 << 8)
+#define TCTL_SWR        (1 << 15)
+
+#define TSTAT_COMP      (1 << 0)
+#define TSTAT_CAPT      (1 << 1)
+
+#define CLK32K_FREQ     32768
+
+/* The counting rate in Hz, or 0 when the timer is stopped. */
+static uint32_t imx21_gpt_freq(IMX21GPTState *s)
+{
+    uint32_t in;
+
+    if (!(s->tctl & TCTL_TEN)) {
+        return 0;
+    }
+    switch ((s->tctl & TCTL_CLKSOURCE) >> 1) {
+    case 1:
+        in = s->perclk_freq;
+        break;
+    case 2:
+        in = s->perclk_freq / 4;
+        break;
+    case 4 ... 7:
+        in = CLK32K_FREQ;
+        break;
+    default:
+        /* Stopped, or the TIN pin, which nothing drives. */
+        return 0;
+    }
+    return in / ((s->tprer & 0x7ff) + 1);
+}
+
+static uint64_t imx21_gpt_period(IMX21GPTState *s)
+{
+    return (s->tctl & TCTL_FRR) ? (1ULL << 32) : (uint64_t)s->tcmp + 1;
+}
+
+static uint64_t imx21_gpt_ticks(IMX21GPTState *s, int64_t now)
+{
+    uint32_t freq = imx21_gpt_freq(s);
+
+    if (!freq || now <= s->t0_ns) {
+        return 0;
+    }
+    return muldiv64(now - s->t0_ns, freq, NANOSECONDS_PER_SECOND);
+}
+
+static uint32_t imx21_gpt_count(IMX21GPTState *s, uint64_t ticks)
+{
+    return ((uint64_t)s->cnt_base + ticks) % imx21_gpt_period(s);
+}
+
+static void imx21_gpt_update_irq(IMX21GPTState *s)
+{
+    qemu_set_irq(s->irq,
+                 ((s->tstat & TSTAT_COMP) && (s->tctl & TCTL_COMPEN)) ||
+                 ((s->tstat & TSTAT_CAPT) && (s->tctl & TCTL_CAPTEN)));
+}
+
+static void imx21_gpt_arm(IMX21GPTState *s)
+{
+    uint32_t freq = imx21_gpt_freq(s);
+
+    if (!freq) {
+        timer_del(&s->timer);
+        return;
+    }
+    timer_mod(&s->timer, s->t0_ns + 1 +
+              muldiv64(s->next_cmp_tick, NANOSECONDS_PER_SECOND, freq));
+}
+
+/*
+ * Moves the time base to the last whole tick before now, keeping the
+ * count, so that the configuration can change; then finds the next
+ * compare event.
+ */
+static void imx21_gpt_rebase(IMX21GPTState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    uint32_t freq = imx21_gpt_freq(s);
+
+    if (freq) {
+        uint64_t ticks = imx21_gpt_ticks(s, now);
+
+        s->cnt_base = imx21_gpt_count(s, ticks);
+        s->t0_ns += muldiv64(ticks, NANOSECONDS_PER_SECOND, freq);
+    } else {
+        s->t0_ns = now;
+    }
+}
+
+static void imx21_gpt_schedule(IMX21GPTState *s)
+{
+    uint64_t first;
+
+    if (!(s->tctl & TCTL_FRR) && s->cnt_base > s->tcmp) {
+        s->cnt_base = 0;
+    }
+    first = (uint32_t)(s->tcmp - s->cnt_base);
+    if (first == 0) {
+        first = imx21_gpt_period(s);
+    }
+    s->next_cmp_tick = first;
+    imx21_gpt_arm(s);
+}
+
+/*
+ * Latches a compare event that is due. Register accesses do this too, so
+ * the guest never sees the count past a compare whose flag is not yet set,
+ * however late the timer callback runs.
+ *
+ * In restart mode the count returns to zero one tick after the compare,
+ * by which time the hardware has long interrupted the CPU. If the event
+ * is caught up only after that, the count reads as the compare value
+ * until the guest acknowledges the event, so that a clock built from the
+ * tick count and the counter never runs backwards.
+ */
+static void imx21_gpt_catch_up(IMX21GPTState *s)
+{
+    uint64_t ticks = imx21_gpt_ticks(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+    uint64_t period = imx21_gpt_period(s);
+
+    if (!imx21_gpt_freq(s) || ticks < s->next_cmp_tick) {
+        return;
+    }
+    if (!(s->tctl & TCTL_FRR) && ticks > s->next_cmp_tick) {
+        s->hold = true;
+    }
+    s->tstat |= TSTAT_COMP;
+    s->next_cmp_tick += period * ((ticks - s->next_cmp_tick) / period + 1);
+    imx21_gpt_arm(s);
+    imx21_gpt_update_irq(s);
+}
+
+static void imx21_gpt_timeout(void *opaque)
+{
+    imx21_gpt_catch_up(opaque);
+}
+
+static uint64_t imx21_gpt_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX21GPTState *s = opaque;
+
+    imx21_gpt_catch_up(s);
+    switch (offset) {
+    case TCTL:
+        return s->tctl;
+    case TPRER:
+        return s->tprer;
+    case TCMP:
+        return s->tcmp;
+    case TCR:
+        return s->tcr;
+    case TCN:
+        if (s->hold && (s->tstat & TSTAT_COMP)) {
+            return s->tcmp;
+        }
+        return imx21_gpt_count(s, imx21_gpt_ticks(s,
+                               qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)));
+    case TSTAT:
+        return s->tstat;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad register at 0x%" HWADDR_PRIx
+                      "\n", __func__, offset);
+        return 0;
+    }
+}
+
+static void imx21_gpt_do_reset(IMX21GPTState *s)
+{
+    s->tctl = 0;
+    s->tprer = 0;
+    s->tcmp = 0xffffffff;
+    s->tcr = 0;
+    s->tstat = 0;
+    s->cnt_base = 0;
+    s->t0_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    s->next_cmp_tick = 0;
+    s->hold = false;
+    timer_del(&s->timer);
+}
+
+static void imx21_gpt_write(void *opaque, hwaddr offset, uint64_t val,
+                            unsigned size)
+{
+    IMX21GPTState *s = opaque;
+
+    imx21_gpt_catch_up(s);
+    if (offset != TSTAT) {
+        s->hold = false;
+    }
+    switch (offset) {
+    case TCTL:
+        imx21_gpt_rebase(s);
+        if (val & TCTL_SWR) {
+            imx21_gpt_do_reset(s);
+            break;
+        }
+        if (!(s->tctl & TCTL_TEN) && (val & TCTL_TEN)) {
+            /* Enabling starts the count from zero. */
+            s->cnt_base = 0;
+            s->t0_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        }
+        s->tctl = val & 0xffff;
+        imx21_gpt_schedule(s);
+        break;
+    case TPRER:
+        imx21_gpt_rebase(s);
+        s->tprer = val & 0x7ff;
+        imx21_gpt_schedule(s);
+        break;
+    case TCMP:
+        imx21_gpt_rebase(s);
+        s->tcmp = val;
+        if (!(s->tctl & TCTL_FRR)) {
+            /* In restart mode a compare write restarts the count. */
+            s->cnt_base = 0;
+            s->t0_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        }
+        imx21_gpt_schedule(s);
+        break;
+    case TSTAT:
+        /* Write 1 to clear; a write of 0 clears every flag. */
+        s->tstat = val ? s->tstat & ~val : 0;
+        if (!(s->tstat & TSTAT_COMP)) {
+            s->hold = false;
+        }
+        break;
+    case TCR:
+    case TCN:
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad register at 0x%" HWADDR_PRIx
+                      "\n", __func__, offset);
+        return;
+    }
+    imx21_gpt_update_irq(s);
+}
+
+static const MemoryRegionOps imx21_gpt_ops = {
+    .read = imx21_gpt_read,
+    .write = imx21_gpt_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void imx21_gpt_reset(DeviceState *dev)
+{
+    IMX21GPTState *s = IMX21_GPT(dev);
+
+    imx21_gpt_do_reset(s);
+    imx21_gpt_update_irq(s);
+}
+
+static void imx21_gpt_init(Object *obj)
+{
+    IMX21GPTState *s = IMX21_GPT(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &imx21_gpt_ops, s,
+                          TYPE_IMX21_GPT, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    timer_init_ns(&s->timer, QEMU_CLOCK_VIRTUAL, imx21_gpt_timeout, s);
+}
+
+static const Property imx21_gpt_properties[] = {
+    /* PERCLK1: 266 MHz MPLL / 6, as the boot loader leaves it. */
+    DEFINE_PROP_UINT32("perclk-freq", IMX21GPTState, perclk_freq, 44333333),
+};
+
+static const VMStateDescription vmstate_imx21_gpt = {
+    .name = TYPE_IMX21_GPT,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(tctl, IMX21GPTState),
+        VMSTATE_UINT32(tprer, IMX21GPTState),
+        VMSTATE_UINT32(tcmp, IMX21GPTState),
+        VMSTATE_UINT32(tcr, IMX21GPTState),
+        VMSTATE_UINT32(tstat, IMX21GPTState),
+        VMSTATE_UINT32(cnt_base, IMX21GPTState),
+        VMSTATE_INT64(t0_ns, IMX21GPTState),
+        VMSTATE_UINT64(next_cmp_tick, IMX21GPTState),
+        VMSTATE_BOOL(hold, IMX21GPTState),
+        VMSTATE_TIMER(timer, IMX21GPTState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx21_gpt_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_imx21_gpt;
+    device_class_set_legacy_reset(dc, imx21_gpt_reset);
+    device_class_set_props(dc, imx21_gpt_properties);
+    dc->desc = "i.MX21 general purpose timer";
+}
+
+static const TypeInfo imx21_gpt_info = {
+    .name = TYPE_IMX21_GPT,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMX21GPTState),
+    .instance_init = imx21_gpt_init,
+    .class_init = imx21_gpt_class_init,
+};
+
+static void imx21_gpt_register_types(void)
+{
+    type_register_static(&imx21_gpt_info);
+}
+
+type_init(imx21_gpt_register_types)
