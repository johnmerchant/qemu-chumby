 Sound goes to the audio backend given with ``-audiodev`` and the
@@ -198,3 +199,63 @@ The GUID is 32 hex digits as ``XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX``,
 the serial number 16 letters or digits, and the hardware version
 ``MAJOR.MINOR``; anything else is refused at startup. Give each emulated
 Chumby its own GUID so that it pairs with a server as a separate device.
+
+Frontend interface
+------------------
+
+A frontend (a window, a test harness, a script) controls and watches
+the machine with the names below. They are stable: they will not be
+renamed, removed or changed in meaning without a note in this section.
+New ones may be added, and a client should ignore fields it does not
+know.
+
+Machine properties, given with ``-M chumby-classic,NAME=VALUE``; all but
+the identity can also be read and set at any time with ``qom-get`` and
+``qom-set`` on ``/machine``:
+
+- ``button`` (bool): the top button, true while held
+- ``headphones`` (bool): true while headphones are plugged in
+- ``button-key`` (string): the QKeyCode that holds the top button,
+  ``f12`` by default, or ``none``
+- ``usb-keyboard`` (bool): whether an unheard key plugs in a USB
+  keyboard; on by default
+- ``accel-x``, ``accel-y``, ``accel-z`` (int): the acceleration along
+  each of the accelerometer's axes in milli-g, -16000 to 16000; 0, 0
+  and 1000 by default
+- ``guid``, ``serial``, ``hwversion`` (string): the identity,
+  ``XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX``, 16 letters or digits and
+  ``MAJOR.MINOR``; fixed once the machine is created
+
+``query-chumby-state`` returns the button, headphones, acceleration and
+identity together with the board's outputs, so that a frontend can
+resynchronise with one command:
+
+.. code-block:: json
+
+  { "backlight": 65535, "lcd-on": true, "speaker-mute": false,
+    "headphones": false, "button": false,
+    "accel-x": 0, "accel-y": 0, "accel-z": 1000,
+    "guid": "C40BB1E0-0000-4000-8000-0E4000000001",
+    "serial": "0000000000000000", "hwversion": "3.8" }
+
+``backlight`` is the PWM's duty cycle, 0 to 65535; ``lcd-on`` and
+``speaker-mute`` are the lines the guest drives. The events
+``CHUMBY_BACKLIGHT`` (``level``, at most one each 100 ms, the last
+being the final level), ``CHUMBY_LCD`` (``on``),
+``CHUMBY_SPEAKER_MUTE`` (``muted``) and ``CHUMBY_HEADPHONES``
+(``inserted``) report changes as they happen.
+
+Input:
+
+- The pen is QMP's ``input-send-event`` with ``abs`` events on the
+  ``x`` and ``y`` axes, 0 to 32767 across the screen left to right and
+  top to bottom, and the ``left`` button, down while the pen touches.
+  A tap is a press of 100 to 200 ms. Any display's absolute pointer
+  sends the same events.
+- Keys are QKeyCodes, from ``send-key``, ``input-send-event`` or a
+  display's keyboard. F12 (``button-key``) holds the top button; the
+  others go to the guest's USB keyboard.
+
+Output: ``screendump`` with ``"format": "png"`` (or the default PPM)
+writes the 320x240 screen as the LCD controller composes it, dimmed by
+the backlight.
diff --git a/hw/arm/chumby_classic.c b/hw/arm/chumby_classic.c
index b36a79fd8..a1a5552a6 100644
--- a/hw/arm/chumby_classic.c
+++ b/hw/arm/chumby_classic.c
@@ -179,6 +179,17 @@ static bool chumby_classic_codec_adc(void *opaque, int16_t *samples,
                                 frames);
 }
 
+/* The identity is fixed once the machine is created. */
+static bool chumby_classic_identity_settable(const char *name, Error **errp)
+{
+    if (phase_check(PHASE_MACHINE_INITIALIZED)) {
+        error_setg(errp, "%s can only be set when the machine is created",
+                   name);
+        return false;
+    }
+    return true;
+}
+
 static char *chumby_classic_get_guid(Object *obj, Error **errp)
 {
     return g_strdup(CHUMBY_CLASSIC_MACHINE(obj)->guid);
@@ -189,6 +200,9 @@ static void chumby_classic_set_guid(Object *obj, const char *value,
 {
     ChumbyClassicState *s = CHUMBY_CLASSIC_MACHINE(obj);
 
+    if (!chumby_classic_identity_settable("guid", errp)) {
+        return;
+    }
     if (qemu_uuid_parse(value, &s->guid_bytes) < 0) {
         error_setg(errp, "invalid GUID '%s': expected 32 hex digits as "
                    "XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX", value);
@@ -209,6 +223,9 @@ static void chumby_classic_set_serial(Object *obj, const char *value,
     ChumbyClassicState *s = CHUMBY_CLASSIC_MACHINE(obj);
     const char *p;
 
+    if (!chumby_classic_identity_settable("serial", errp)) {
+        return;
+    }
     for (p = value; *p && g_ascii_isalnum(*p); p++) {
         /* letters and digits only */
     }
@@ -233,6 +250,9 @@ static void chumby_classic_set_hwversion(Object *obj, const char *value,
     unsigned int major, minor;
     char end;
 
+    if (!chumby_classic_identity_settable("hwversion", errp)) {
+        return;
+    }
     if (!g_ascii_isdigit(value[0]) ||
         sscanf(value, "%3u.%3u%c", &major, &minor, &end) != 2 ||
         major > 255 || minor > 255) {
diff --git a/hw/misc/chumby_io.c b/hw/misc/chumby_io.c
index c99bc0819..b4651a70e 100644
--- a/hw/misc/chumby_io.c
+++ b/hw/misc/chumby_io.c
@@ -332,6 +332,8 @@ ChumbyState *qmp_query_chumby_state(Error **errp)
 {
     ChumbyIOState *s;
     ChumbyState *info;
+    Object *machine;
+    Error *err = NULL;
 
     s = CHUMBY_IO(object_resolve_path_type("", TYPE_CHUMBY_IO, NULL));
     if (!s) {
@@ -344,6 +346,30 @@ ChumbyState *qmp_query_chumby_state(Error **errp)
     info->speaker_mute = s->speaker_mute;
     info->headphones = s->headphones;
     info->button = s->button;
+
+    /* The rest is the machine's, which reads the acceleration from the part */
+    machine = qdev_get_machine();
+    info->accel_x = object_property_get_int(machine, "accel-x", &err);
+    if (!err) {
+        info->accel_y = object_property_get_int(machine, "accel-y", &err);
+    }
+    if (!err) {
+        info->accel_z = object_property_get_int(machine, "accel-z", &err);
+    }
+    if (!err) {
+        info->guid = object_property_get_str(machine, "guid", &err);
+    }
+    if (!err) {
+        info->serial = object_property_get_str(machine, "serial", &err);
+    }
+    if (!err) {
+        info->hwversion = object_property_get_str(machine, "hwversion", &err);
+    }
+    if (err) {
+        error_propagate(errp, err);
+        qapi_free_ChumbyState(info);
+        return NULL;
+    }
     return info;
 }
 
