--- /dev/null
+++ b/hw/nvram/at25080a.c
@@ -0,0 +1,222 @@
+/*
+ * Atmel AT25080A 1 KiB SPI serial EEPROM
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * An 8 Kbit EEPROM, 1024 x 8, with the SPI serial EEPROM instruction set:
+ * WREN, WRDI, RDSR, WRSR, READ and WRITE (with a 16-bit address, of which
+ * the low 10 bits count). A frame is one chip select; READ runs on
+ * through the array, WRITE fills a 32-byte page, wrapping within it.
+ * Writes complete at once, so the status register's busy bit stays clear.
+ * Block protection (BP1:0) guards the top quarter, half or all of the
+ * array; WPEN and the WP pin are kept but WP is not wired, so WPEN has no
+ * effect. Once the frame ends, a WRITE or WRSR clears the write latch.
+ *
+ * The contents are not backed by a file: the board programs them at
+ * startup, and guest writes last until QEMU exits.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/nvram/at25080a.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "trace.h"
+
+#define OP_WRSR     0x01
+#define OP_WRITE    0x02
+#define OP_READ     0x03
+#define OP_WRDI     0x04
+#define OP_RDSR     0x05
+#define OP_WREN     0x06
+/* Bit 3 of the opcode is a don't-care on this part. */
+#define OP_MASK     0xf7
+
+#define SR_RDY      (1 << 0)    /* busy writing; never set here */
+#define SR_WEN      (1 << 1)
+#define SR_BP_SHIFT 2
+#define SR_BP_MASK  (3 << SR_BP_SHIFT)
+#define SR_WPEN     (1 << 7)
+#define SR_WRITABLE (SR_BP_MASK | SR_WPEN)
+
+#define PAGE_SIZE   32
+
+void at25080a_program(AT25080AState *s, uint32_t addr, const void *buf,
+                      size_t len)
+{
+    assert(addr <= AT25080A_SIZE && len <= AT25080A_SIZE - addr);
+    memcpy(&s->mem[addr], buf, len);
+}
+
+static bool at25080a_protected(AT25080AState *s, uint16_t addr)
+{
+    switch ((s->status & SR_BP_MASK) >> SR_BP_SHIFT) {
+    case 1:
+        return addr >= AT25080A_SIZE * 3 / 4;
+    case 2:
+        return addr >= AT25080A_SIZE / 2;
+    case 3:
+        return true;
+    default:
+        return false;
+    }
+}
+
+static uint32_t at25080a_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    AT25080AState *s = AT25080A(dev);
+    uint32_t n = s->byte++;
+    uint32_t ret = 0;
+
+    val &= 0xff;
+    if (n == 0) {
+        s->opcode = val & OP_MASK;
+        switch (s->opcode) {
+        case OP_WREN:
+            s->status |= SR_WEN;
+            break;
+        case OP_WRDI:
+            s->status &= ~SR_WEN;
+            break;
+        case OP_RDSR:
+        case OP_WRSR:
+        case OP_READ:
+        case OP_WRITE:
+            break;
+        default:
+            qemu_log_mask(LOG_GUEST_ERROR, "%s: unknown opcode 0x%02x\n",
+                          __func__, val);
+            s->opcode = 0;
+            break;
+        }
+        trace_at25080a_opcode(val);
+        return 0;
+    }
+
+    switch (s->opcode) {
+    case OP_RDSR:
+        ret = s->status;
+        break;
+    case OP_WRSR:
+        if (n == 1 && (s->status & SR_WEN)) {
+            s->status = (s->status & ~SR_WRITABLE) | (val & SR_WRITABLE);
+            trace_at25080a_write_status(s->status);
+        }
+        break;
+    case OP_READ:
+    case OP_WRITE:
+        if (n == 1) {
+            s->addr = val << 8;
+            break;
+        } else if (n == 2) {
+            s->addr = (s->addr | val) % AT25080A_SIZE;
+            break;
+        }
+        if (s->opcode == OP_READ) {
+            ret = s->mem[s->addr];
+            trace_at25080a_read(s->addr, ret);
+            s->addr = (s->addr + 1) % AT25080A_SIZE;
+        } else {
+            if ((s->status & SR_WEN) && !at25080a_protected(s, s->addr)) {
+                s->mem[s->addr] = val;
+                trace_at25080a_write(s->addr, val);
+            }
+            s->addr = (s->addr & ~(PAGE_SIZE - 1)) |
+                      ((s->addr + 1) & (PAGE_SIZE - 1));
+        }
+        break;
+    }
+    return ret;
+}
+
+/* The chip select is active low: a frame starts when it goes low. */
+static int at25080a_set_cs(SSIPeripheral *dev, bool level)
+{
+    AT25080AState *s = AT25080A(dev);
+
+    if (!level) {
+        s->byte = 0;
+        s->opcode = 0;
+    } else if (s->byte > 1 &&
+               (s->opcode == OP_WRITE || s->opcode == OP_WRSR)) {
+        s->status &= ~SR_WEN;
+    }
+    return 0;
+}
+
+static void at25080a_realize(SSIPeripheral *dev, Error **errp)
+{
+}
+
+static void at25080a_reset(DeviceState *dev)
+{
+    AT25080AState *s = AT25080A(dev);
+
+    /* Power-up: the write latch is clear; BP and WPEN are nonvolatile. */
+    s->status &= SR_WRITABLE;
+    s->byte = 0;
+    s->opcode = 0;
+    s->addr = 0;
+}
+
+static void at25080a_init(Object *obj)
+{
+    AT25080AState *s = AT25080A(obj);
+
+    /* Shipped erased. */
+    memset(s->mem, 0xff, sizeof(s->mem));
+}
+
+static int at25080a_post_load(void *opaque, int version_id)
+{
+    AT25080AState *s = opaque;
+
+    return s->addr < AT25080A_SIZE ? 0 : -EINVAL;
+}
+
+static const VMStateDescription vmstate_at25080a = {
+    .name = TYPE_AT25080A,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .post_load = at25080a_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, AT25080AState),
+        VMSTATE_UINT8_ARRAY(mem, AT25080AState, AT25080A_SIZE),
+        VMSTATE_UINT8(status, AT25080AState),
+        VMSTATE_UINT32(byte, AT25080AState),
+        VMSTATE_UINT8(opcode, AT25080AState),
+        VMSTATE_UINT16(addr, AT25080AState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void at25080a_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = at25080a_realize;
+    k->transfer = at25080a_transfer;
+    k->set_cs = at25080a_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    dc->vmsd = &vmstate_at25080a;
+    device_class_set_legacy_reset(dc, at25080a_reset);
+    dc->desc = "Atmel AT25080A SPI EEPROM";
+}
+
+static const TypeInfo at25080a_info = {
+    .name = TYPE_AT25080A,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(AT25080AState),
+    .instance_init = at25080a_init,
+    .class_init = at25080a_class_init,
+};
+
+static void at25080a_register_types(void)
+{
+    type_register_static(&at25080a_info);
+}
+
+type_init(at25080a_register_types)
