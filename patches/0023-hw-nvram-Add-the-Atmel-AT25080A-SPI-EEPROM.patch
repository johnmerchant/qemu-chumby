diff --git a/include/hw/nvram/at25080a.h b/include/hw/nvram/at25080a.h
new file mode 100644
--- /dev/null
+++ b/include/hw/nvram/at25080a.h
@@ -0,0 +1,35 @@
+/*
+ * Atmel AT25080A 1 KiB SPI serial EEPROM
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_NVRAM_AT25080A_H
+#define HW_NVRAM_AT25080A_H
+
+#include "hw/ssi/ssi.h"
+#include "qom/object.h"
+
+#define TYPE_AT25080A "at25080a"
+OBJECT_DECLARE_SIMPLE_TYPE(AT25080AState, AT25080A)
+
+#define AT25080A_SIZE 1024
+
+struct AT25080AState {
+    SSIPeripheral parent_obj;
+
+    uint8_t mem[AT25080A_SIZE];
+    uint8_t status;
+    /* The frame: bytes seen since chip select, its opcode and address. */
+    uint32_t byte;
+    uint8_t opcode;
+    uint16_t addr;
+};
+
+/* Sets the contents, as if programmed before the board was built. */
+void at25080a_program(AT25080AState *s, uint32_t addr, const void *buf,
+                      size_t len);
+
+#endif /* HW_NVRAM_AT25080A_H */
