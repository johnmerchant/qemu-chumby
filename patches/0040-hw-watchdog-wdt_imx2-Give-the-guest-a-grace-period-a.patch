From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Fri, 30 Oct 2026 04:02:38 +1030
Subject: [PATCH 40/42] hw/watchdog/wdt_imx2: Give the guest a grace period
 after a host stall

Without -icount the virtual clock keeps running while the host does not
run QEMU at all: the host sleeping, QEMU stopped by SIGSTOP, or a
starved process. The Chumby's kernel arms the watchdog for 2.5 s and
services it every 10 ms, but after any such stall longer than that the
timeout has passed before the guest could run, and the machine resets.
With the stock firmware, stopping QEMU for 5 s rebooted it.

Add a "stall-grace-ms" property, 0 (off) by default so other machines
are unchanged. With it, a timeout does not act at once: the guest gets
that much more time on the virtual clock, and a service in it cancels
the reset. A hung guest is reset that much later. The i.MX21 sets it to
250 ms. The pending grace timer is migrated in a subsection that only
exists when the property is set.

With it, stopping QEMU for 5, 10 and 30 s left the stock firmware
running, and unloading chumby_sense1 (which stops the servicing) still
reset the machine.

Signed-off-by: John Merchant <john@johnmerchant.dev>
Claude-Session: https://claude.ai/code/session_01B1fN5Fc77Z6fVVe4rWJxPT
---
 docs/system/arm/chumby-classic.rst |  8 ++++
 hw/arm/fsl-imx21.c                 |  8 +++-
 hw/watchdog/wdt_imx2.c             | 59 +++++++++++++++++++++++++++---
 include/hw/watchdog/wdt_imx2.h     |  4 ++
 4 files changed, 73 insertions(+), 6 deletions(-)

diff --git a/docs/system/arm/chumby-classic.rst b/docs/system/arm/chumby-classic.rst
index 7a2076337..0224bf034 100644
--- a/docs/system/arm/chumby-classic.rst
+++ b/docs/system/arm/chumby-classic.rst
@@ -164,6 +164,14 @@ CPU time. With ``-icount shift=auto,sleep=off`` the guest's clock instead
 jumps ahead whenever it is idle, which suits scripted tests but makes
 timers fire early for a person watching, and it keeps a host core busy.
 
+The watchdog runs on the emulated clock, which stands still while the
+machine is paused. Without ``-icount`` that clock also runs on while the
+host is not running QEMU at all (the host sleeping, QEMU stopped by a
+signal or starved of CPU), so after the 2.5 second timeout runs out the
+guest gets another quarter of a second of running time to service the
+watchdog before it resets the machine. ``-action watchdog=none`` (or
+``pause``) turns the reset off, for instance while debugging the guest.
+
 Device identity
 ---------------
 
diff --git a/hw/arm/fsl-imx21.c b/hw/arm/fsl-imx21.c
index 72de0d118..eeb1a27b1 100644
--- a/hw/arm/fsl-imx21.c
+++ b/hw/arm/fsl-imx21.c
@@ -144,9 +144,15 @@ static void fsl_imx21_realize(DeviceState *dev, Error **errp)
         return;
     }
 
-    /* WRSR tells the Chumby's kernel why it was reset. */
+    /*
+     * WRSR tells the Chumby's kernel why it was reset. The kernel services
+     * the watchdog every tick, so a quarter second after a host stall is
+     * plenty.
+     */
     if (!object_property_set_bool(OBJECT(&s->wdt), "reset-source", true,
                                   errp) ||
+        !object_property_set_uint(OBJECT(&s->wdt), "stall-grace-ms", 250,
+                                  errp) ||
         !fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->wdt), FSL_IMX21_WDT_ADDR,
                        FSL_IMX21_WDT_IRQ, errp) ||
         !fsl_imx21_map(aitc, SYS_BUS_DEVICE(&s->rtc), FSL_IMX21_RTC_ADDR,
diff --git a/hw/watchdog/wdt_imx2.c b/hw/watchdog/wdt_imx2.c
index 95f5ae53b..5b0243e4b 100644
--- a/hw/watchdog/wdt_imx2.c
+++ b/hw/watchdog/wdt_imx2.c
@@ -29,12 +29,8 @@ static void imx2_wdt_interrupt(void *opaque)
     qemu_set_irq(s->irq, 1);
 }
 
-static void imx2_wdt_expired(void *opaque)
+static void imx2_wdt_timeout(IMX2WdtState *s)
 {
-    IMX2WdtState *s = IMX2_WDT(opaque);
-
-    trace_imx2_wdt_expired();
-
     s->wrsr = IMX2_WDT_WRSR_TOUT;
 
     /* Perform watchdog action if watchdog is enabled */
@@ -44,6 +40,35 @@ static void imx2_wdt_expired(void *opaque)
     }
 }
 
+static void imx2_wdt_expired(void *opaque)
+{
+    IMX2WdtState *s = IMX2_WDT(opaque);
+
+    trace_imx2_wdt_expired();
+
+    /*
+     * Without -icount the virtual clock keeps running while the host
+     * does not run QEMU at all (the host suspended, QEMU stopped by a
+     * signal, a starved process), so the count can run out before the
+     * guest had a chance to service it. With a stall grace, let the guest
+     * run for that long before giving up on it.
+     */
+    if (s->stall_grace_ms && (s->wcr & IMX2_WDT_WCR_WDE)) {
+        timer_mod(&s->grace_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                  s->stall_grace_ms);
+        return;
+    }
+    imx2_wdt_timeout(s);
+}
+
+static void imx2_wdt_grace_expired(void *opaque)
+{
+    IMX2WdtState *s = IMX2_WDT(opaque);
+
+    trace_imx2_wdt_expired();
+    imx2_wdt_timeout(s);
+}
+
 static void imx2_wdt_reset(DeviceState *dev)
 {
     IMX2WdtState *s = IMX2_WDT(dev);
@@ -51,6 +76,7 @@ static void imx2_wdt_reset(DeviceState *dev)
     ptimer_transaction_begin(s->timer);
     ptimer_stop(s->timer);
     ptimer_transaction_commit(s->timer);
+    timer_del(&s->grace_timer);
 
     if (s->pretimeout_support) {
         ptimer_transaction_begin(s->itimer);
@@ -144,6 +170,7 @@ static void imx_wdt2_update_itimer(IMX2WdtState *s, bool start)
 
 static void imx_wdt2_update_timer(IMX2WdtState *s, bool start)
 {
+    timer_del(&s->grace_timer);
     ptimer_transaction_begin(s->timer);
     if (start) {
         ptimer_stop(s->timer);
@@ -270,6 +297,24 @@ static const VMStateDescription vmstate_imx2_wdt_reset_source = {
     }
 };
 
+static bool imx2_wdt_stall_grace_needed(void *opaque)
+{
+    IMX2WdtState *s = IMX2_WDT(opaque);
+
+    return s->stall_grace_ms;
+}
+
+static const VMStateDescription vmstate_imx2_wdt_stall_grace = {
+    .name = "imx2.wdt/stall-grace",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = imx2_wdt_stall_grace_needed,
+    .fields = (const VMStateField[]) {
+        VMSTATE_TIMER(grace_timer, IMX2WdtState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
 static const VMStateDescription vmstate_imx2_wdt = {
     .name = "imx2.wdt",
     .fields = (const VMStateField[]) {
@@ -288,6 +333,7 @@ static const VMStateDescription vmstate_imx2_wdt = {
     },
     .subsections = (const VMStateDescription * const []) {
         &vmstate_imx2_wdt_reset_source,
+        &vmstate_imx2_wdt_stall_grace,
         NULL
     }
 };
@@ -304,6 +350,8 @@ static void imx2_wdt_realize(DeviceState *dev, Error **errp)
     sysbus_init_mmio(sbd, &s->mmio);
     sysbus_init_irq(sbd, &s->irq);
 
+    timer_init_ms(&s->grace_timer, QEMU_CLOCK_VIRTUAL, imx2_wdt_grace_expired,
+                  s);
     s->timer = ptimer_init(imx2_wdt_expired, s,
                            PTIMER_POLICY_NO_IMMEDIATE_TRIGGER |
                            PTIMER_POLICY_NO_IMMEDIATE_RELOAD |
@@ -328,6 +376,7 @@ static const Property imx2_wdt_properties[] = {
     DEFINE_PROP_BOOL("pretimeout-support", IMX2WdtState, pretimeout_support,
                      false),
     DEFINE_PROP_BOOL("reset-source", IMX2WdtState, reset_source, false),
+    DEFINE_PROP_UINT32("stall-grace-ms", IMX2WdtState, stall_grace_ms, 0),
 };
 
 static void imx2_wdt_class_init(ObjectClass *klass, const void *data)
diff --git a/include/hw/watchdog/wdt_imx2.h b/include/hw/watchdog/wdt_imx2.h
index c3e43c407..2eeaa63f1 100644
--- a/include/hw/watchdog/wdt_imx2.h
+++ b/include/hw/watchdog/wdt_imx2.h
@@ -16,6 +16,7 @@
 #include "hw/core/sysbus.h"
 #include "hw/core/irq.h"
 #include "hw/core/ptimer.h"
+#include "qemu/timer.h"
 #include "qom/object.h"
 
 #define TYPE_IMX2_WDT "imx2.wdt"
@@ -92,6 +93,9 @@ struct IMX2WdtState {
     bool reset_source;          /* WRSR reports the last reset's source */
     bool powered_on;
     uint16_t wrsr_next;         /* source of the reset being performed */
+
+    uint32_t stall_grace_ms;    /* time the guest gets after a timeout */
+    QEMUTimer grace_timer;
 };
 
 #endif /* WDT_IMX2_H */
