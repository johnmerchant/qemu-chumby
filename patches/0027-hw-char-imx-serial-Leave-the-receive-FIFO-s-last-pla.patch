diff --git a/hw/char/imx_serial.c b/hw/char/imx_serial.c
--- a/hw/char/imx_serial.c
+++ b/hw/char/imx_serial.c
@@ -387,8 +387,24 @@ static void imx_serial_write(void *opaque, hwaddr offset,
 static int imx_can_receive(void *opaque)
 {
     IMXSerialState *s = (IMXSerialState *)opaque;
+    int room;
 
-    return s->ucr2 & UCR2_RXEN ? fifo32_num_free(&s->rx_fifo) : 0;
+    if (!(s->ucr2 & UCR2_RXEN)) {
+        return 0;
+    }
+    room = fifo32_num_free(&s->rx_fifo);
+    /*
+     * A character stored in the FIFO's last place is flagged as an
+     * overrun (URXD_OVRRUN), as the hardware flags it, and drivers drop
+     * or blank it. A real line brings one character at a time, and the
+     * guest empties the FIFO long before it fills; a chardev brings at
+     * once as many as there is room for. With rx-headroom it is offered
+     * one place fewer, so nothing it brings is flagged.
+     */
+    if (s->rx_headroom && room > 0) {
+        room--;
+    }
+    return room;
 }
 
 static void imx_put_data(void *opaque, uint32_t value)
@@ -466,6 +482,7 @@ static void imx_serial_init(Object *obj)
 
 static const Property imx_serial_properties[] = {
     DEFINE_PROP_CHR("chardev", IMXSerialState, chr),
+    DEFINE_PROP_BOOL("rx-headroom", IMXSerialState, rx_headroom, false),
 };
 
 static void imx_serial_class_init(ObjectClass *klass, const void *data)
