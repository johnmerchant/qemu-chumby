+/*
+ * Chumby Classic
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The Chumby Classic: a Freescale i.MX21 with 64 MiB of SDRAM, 64 MiB of
+ * small-page NAND flash, a 320x240 touchscreen LCD (a TI TSC2100 on
+ * CSPI3, its PINTDAV output on GPIO PE19) and a crypto processor on
+ * UART3. UART1 is the console.
+ *
+ * The board boots Linux directly: -kernel takes a zImage and the kernel
+ * is entered as on an MX21ADS (machine type 851), which is what the
+ * Chumby's own kernel is built for. The NAND image is "-drive if=mtd".
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "hw/arm/fsl-imx21.h"
+#include "hw/arm/boot.h"
+#include "hw/arm/machines-qom.h"
+#include "hw/char/chumby_cp.h"
+#include "hw/core/boards.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/qdev-properties-system.h"
+#include "hw/input/tsc2100.h"
+#include "hw/ssi/ssi.h"
+#include "qemu/cutils.h"
+#include "qemu/units.h"
+#include "system/address-spaces.h"
+#include "qemu/error-report.h"
+#include "system/blockdev.h"
+#include "system/qtest.h"
+
+#define CHUMBY_MACH_TYPE        851     /* MACH_TYPE_MX21ADS */
+
+/* The command line the stock boot loader gives the first root disk. */
+#define CHUMBY_DEFAULT_CMDLINE  "console=ttyS0,38400 root=/dev/mtdblock5 " \
+                                "rootfstype=cramfs init=/linuxrc " \
+                                "chumby_hwversion=3.8"
+
+/* PINTDAV: GPIO port E, pin 19 */
+#define CHUMBY_PINTDAV_GPIO     (4 * IMX21_GPIO_PINS_PER_PORT + 19)
+
+typedef struct ChumbyClassic {
+    FslIMX21State soc;
+} ChumbyClassic;
+
+static struct arm_boot_info chumby_binfo;
+
+static void chumby_classic_init(MachineState *machine)
+{
+    ChumbyClassic *s = g_new0(ChumbyClassic, 1);
+    DriveInfo *nand = drive_get(IF_MTD, 0, 0);
+    DeviceState *tsc;
+    Chardev *cp;
+    SSIBus *spi;
+
+    if (machine->ram_size > FSL_IMX21_SDRAM0_SIZE) {
+        g_autofree char *sz = size_to_str(FSL_IMX21_SDRAM0_SIZE);
+
+        error_report("RAM size more than %s is not supported", sz);
+        exit(EXIT_FAILURE);
+    }
+
+    object_initialize_child(OBJECT(machine), "soc", &s->soc, TYPE_FSL_IMX21);
+
+    if (nand) {
+        qdev_prop_set_drive_err(DEVICE(&s->soc.nfc), "drive",
+                                blk_by_legacy_dinfo(nand), &error_fatal);
+    }
+
+    /* The crypto processor answers on UART3. */
+    cp = qemu_chardev_new("chumby-cp", TYPE_CHARDEV_CHUMBY_CP, NULL, NULL,
+                          &error_fatal);
+    qdev_prop_set_chr(DEVICE(&s->soc.uart[2]), "chardev", cp);
+
+    qdev_realize(DEVICE(&s->soc), NULL, &error_fatal);
+
+    memory_region_add_subregion(get_system_memory(), FSL_IMX21_SDRAM0_ADDR,
+                                machine->ram);
+
+    /* The touchscreen controller on CSPI3's first chip select */
+    spi = (SSIBus *)qdev_get_child_bus(DEVICE(&s->soc.cspi[2]), "spi");
+    tsc = qdev_new(TYPE_TSC2100);
+    ssi_realize_and_unref(tsc, spi, &error_fatal);
+    sysbus_connect_irq(SYS_BUS_DEVICE(&s->soc.cspi[2]), 1,
+                       qdev_get_gpio_in_named(tsc, SSI_GPIO_CS, 0));
+    qdev_connect_gpio_out_named(tsc, TSC2100_PINTDAV, 0,
+                                qdev_get_gpio_in(DEVICE(&s->soc.gpio),
+                                                 CHUMBY_PINTDAV_GPIO));
+
+    if (!machine->kernel_cmdline || !*machine->kernel_cmdline) {
+        g_free(machine->kernel_cmdline);
+        machine->kernel_cmdline = g_strdup(CHUMBY_DEFAULT_CMDLINE);
+    }
+
+    chumby_binfo.ram_size = machine->ram_size;
+    chumby_binfo.loader_start = FSL_IMX21_SDRAM0_ADDR;
+    chumby_binfo.board_id = CHUMBY_MACH_TYPE;
+
+    if (!qtest_enabled()) {
+        arm_load_kernel(&s->soc.cpu, machine, &chumby_binfo);
+    }
+}
+
+static void chumby_classic_machine_init(MachineClass *mc)
+{
+    mc->desc = "Chumby Classic (Freescale i.MX21, ARM926)";
+    mc->init = chumby_classic_init;
+    mc->ignore_memory_transaction_failures = true;
+    mc->default_ram_size = FSL_IMX21_SDRAM0_SIZE;
+    mc->default_ram_id = "chumby.ram";
+}
+
+DEFINE_MACHINE_ARM("chumby-classic", chumby_classic_machine_init)
