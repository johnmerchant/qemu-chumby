From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Fri, 30 Oct 2026 12:43:36 +0000
Subject: [PATCH 48/52] hw/block/imx21_nfc: Read the flash again after a
 restore

The chip's contents are a copy of the drive, read at realize and written
through on every program and erase, and are not in the migration
stream. loadvm and -loadvm restore the drive but kept the copy (with
-loadvm it is read before the snapshot is applied), so pages programmed
or erased after the snapshot was taken stayed that way in the restored
machine, whose filesystem state and drive said otherwise.

After a restore the contents are now read again from a writable drive
when the machine next runs: during the load the drive is drained
(loadvm) or not yet active (an incoming migration). Without a writable
drive the contents are only in memory and are kept as they are.

The load also refuses a page, column, area or address count out of
range; each indexes the chip's contents or its address bytes.

Signed-off-by: John Merchant <john@johnmerchant.dev>
Claude-Session: https://claude.ai/code/session_01B1fN5Fc77Z6fVVe4rWJxPT
---
 hw/block/imx21_nfc.c         | 46 ++++++++++++++++++++++++++++++++++++
 include/hw/block/imx21_nfc.h |  3 +++
 2 files changed, 49 insertions(+)

diff --git a/hw/block/imx21_nfc.c b/hw/block/imx21_nfc.c
index 82186d4f8..f76eb7b6e 100644
--- a/hw/block/imx21_nfc.c
+++ b/hw/block/imx21_nfc.c
@@ -30,6 +30,7 @@
 #include "qemu/bswap.h"
 #include "qemu/module.h"
 #include "system/block-backend.h"
+#include "system/runstate.h"
 
 #define NFC_BUFSIZE         0xe00
 #define NFC_RBA             0xe04
@@ -398,6 +399,34 @@ static void imx21_nfc_reset(DeviceState *dev)
     imx21_nfc_update_irq(s);
 }
 
+/*
+ * The chip's contents are not in the migration stream: a writable drive
+ * holds them, every program and erase written through, and a snapshot
+ * restores the drive with the machine. After a restore they are read
+ * again, so that the chip matches the restored drive rather than what
+ * it held before. That waits until the machine runs: during the load
+ * the drive is drained (loadvm) or not yet active (an incoming
+ * migration). Without a writable drive the contents are only in memory
+ * and are kept as they are.
+ */
+static void imx21_nfc_vm_state_change(void *opaque, bool running,
+                                      RunState state)
+{
+    IMX21NFCState *s = opaque;
+    int ret;
+
+    if (!running || !s->reload) {
+        return;
+    }
+    s->reload = false;
+    ret = blk_pread(s->blk, 0, (uint64_t)s->pages * IMX21_NAND_RECORD,
+                    s->data, 0);
+    if (ret < 0) {
+        error_report("%s: reading the flash after a restore failed: %s",
+                     TYPE_IMX21_NFC, strerror(-ret));
+    }
+}
+
 static void imx21_nfc_realize(DeviceState *dev, Error **errp)
 {
     IMX21NFCState *s = IMX21_NFC(dev);
@@ -429,12 +458,15 @@ static void imx21_nfc_realize(DeviceState *dev, Error **errp)
                           TYPE_IMX21_NFC, 0x1000);
     sysbus_init_mmio(sbd, &s->iomem);
     sysbus_init_irq(sbd, &s->irq);
+    s->vmstate_change = qemu_add_vm_change_state_handler(
+        imx21_nfc_vm_state_change, s);
 }
 
 static void imx21_nfc_unrealize(DeviceState *dev)
 {
     IMX21NFCState *s = IMX21_NFC(dev);
 
+    qemu_del_vm_change_state_handler(s->vmstate_change);
     g_free(s->data);
 }
 
@@ -446,10 +478,24 @@ static const Property imx21_nfc_properties[] = {
     DEFINE_PROP_UINT32("pages-per-block", IMX21NFCState, pages_per_block, 32),
 };
 
+static int imx21_nfc_post_load(void *opaque, int version_id)
+{
+    IMX21NFCState *s = opaque;
+
+    if (s->page >= s->pages || s->col >= IMX21_NAND_RECORD ||
+        s->prog_col > IMX21_NAND_RECORD || s->naddr > sizeof(s->addr) ||
+        (s->area != 0 && s->area != 256 && s->area != IMX21_NAND_PAGE)) {
+        return -EINVAL;
+    }
+    s->reload = s->blk && blk_is_writable(s->blk);
+    return 0;
+}
+
 static const VMStateDescription vmstate_imx21_nfc = {
     .name = TYPE_IMX21_NFC,
     .version_id = 1,
     .minimum_version_id = 1,
+    .post_load = imx21_nfc_post_load,
     .fields = (const VMStateField[]) {
         VMSTATE_UINT8_ARRAY(buf, IMX21NFCState, IMX21_NFC_BUF_SIZE),
         VMSTATE_UINT16(bufsize, IMX21NFCState),
diff --git a/include/hw/block/imx21_nfc.h b/include/hw/block/imx21_nfc.h
index 82d63e95f..8cce3f969 100644
--- a/include/hw/block/imx21_nfc.h
+++ b/include/hw/block/imx21_nfc.h
@@ -27,6 +27,9 @@ struct IMX21NFCState {
     MemoryRegion iomem;
     qemu_irq irq;
     BlockBackend *blk;
+    /* After a restore: read the contents again before the machine runs */
+    struct VMChangeStateEntry *vmstate_change;
+    bool reload;
 
     /* The chip's identity and size. */
     uint8_t manf_id;
