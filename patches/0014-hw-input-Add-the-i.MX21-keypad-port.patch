diff --git a/include/hw/input/imx21_kpp.h b/include/hw/input/imx21_kpp.h
new file mode 100644
--- /dev/null
+++ b/include/hw/input/imx21_kpp.h
@@ -0,0 +1,41 @@
+/*
+ * i.MX21 keypad port (KPP)
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_KPP_H
+#define IMX21_KPP_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_KPP "imx21.kpp"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21KPPState, IMX21_KPP)
+
+/*
+ * GPIO inputs 0-7 are rows 0-7 and 8-15 columns 0-7, driven low or high.
+ * The GPIO outputs, numbered the same, carry the levels on the pins.
+ */
+#define IMX21_KPP_NUM_PINS 16
+
+struct IMX21KPPState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    qemu_irq out[IMX21_KPP_NUM_PINS];
+
+    uint16_t kpcr;
+    uint16_t kpsr;
+    uint16_t kddr;
+    uint16_t kpdr;
+    /* Levels on the pins; they idle high (pulled up). */
+    uint16_t pins;
+    /* Levels last sent on the outputs */
+    uint16_t out_levels;
+};
+
+#endif /* IMX21_KPP_H */
