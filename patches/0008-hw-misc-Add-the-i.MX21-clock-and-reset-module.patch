diff --git a/hw/misc/imx21_crm.c b/hw/misc/imx21_crm.c
new file mode 100644
--- /dev/null
+++ b/hw/misc/imx21_crm.c
@@ -0,0 +1,151 @@
+/*
+ * i.MX21 clock and reset module (CRM) and system control registers
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The CRM at 0x10027000 and the system control block beside it at
+ * 0x10027800. The PLLs are always locked, and the registers start as a
+ * boot loader leaves them: MPLL 266 MHz from the 26 MHz oscillator, HCLK
+ * 133 MHz, PERCLK1-4 44.3 MHz, SPLL 288 MHz. Other registers read back
+ * what was written.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/misc/imx21_crm.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+#define CSCR        0x00
+#define MPCTL0      0x04
+#define MPCTL1      0x08
+#define SPCTL0      0x0c
+#define SPCTL1      0x10
+#define OSC26MCTL   0x14
+#define PCDR0       0x18
+#define PCDR1       0x1c
+#define PCCR0       0x20
+#define PCCR1       0x24
+
+#define PLL_LOCKED  (1 << 15)
+
+#define SYS_OFFSET  0x800
+#define SIDR        0x04
+#define FMCR        0x14
+
+static uint64_t imx21_crm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX21CRMState *s = opaque;
+    unsigned i = (offset & 0x7ff) / 4;
+
+    if (i >= IMX21_CRM_NUM_REGS) {
+        qemu_log_mask(LOG_UNIMP, "%s: unmodelled register 0x%" HWADDR_PRIx
+                      "\n", __func__, offset);
+        return 0;
+    }
+    return offset >= SYS_OFFSET ? s->sys[i] : s->crm[i];
+}
+
+static void imx21_crm_write(void *opaque, hwaddr offset, uint64_t val,
+                            unsigned size)
+{
+    IMX21CRMState *s = opaque;
+    unsigned i = (offset & 0x7ff) / 4;
+
+    if (i >= IMX21_CRM_NUM_REGS) {
+        qemu_log_mask(LOG_UNIMP, "%s: unmodelled register 0x%" HWADDR_PRIx
+                      "\n", __func__, offset);
+        return;
+    }
+    if (offset >= SYS_OFFSET) {
+        if (offset - SYS_OFFSET != SIDR) {
+            s->sys[i] = val;
+        }
+        return;
+    }
+    switch (offset) {
+    case MPCTL1:
+    case SPCTL1:
+        /* The PLLs lock at once. */
+        val |= PLL_LOCKED;
+        break;
+    }
+    s->crm[i] = val;
+}
+
+static const MemoryRegionOps imx21_crm_ops = {
+    .read = imx21_crm_read,
+    .write = imx21_crm_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void imx21_crm_reset(DeviceState *dev)
+{
+    IMX21CRMState *s = IMX21_CRM(dev);
+
+    memset(s->crm, 0, sizeof(s->crm));
+    memset(s->sys, 0, sizeof(s->sys));
+    /* USB_DIV 5, MCU_SEL oscillator, BCLKDIV 1, IPDIV 1, PLLs on */
+    s->crm[CSCR / 4] = 0x14010607;
+    s->crm[MPCTL0 / 4] = 0x00191403;     /* 266 MHz */
+    s->crm[MPCTL1 / 4] = PLL_LOCKED;
+    s->crm[SPCTL0 / 4] = 0x000c1407;     /* 288 MHz */
+    s->crm[SPCTL1 / 4] = PLL_LOCKED;
+    s->crm[OSC26MCTL / 4] = 0x3f00;
+    s->crm[PCDR0 / 4] = 0;
+    s->crm[PCDR1 / 4] = 0x05050505;      /* PERCLKn = MPLL / 6 */
+    s->crm[PCCR0 / 4] = 0xffffffff;      /* every clock on */
+    s->crm[PCCR1 / 4] = 0xffffffff;
+    s->sys[SIDR / 4] = 0x101d101d;       /* an i.MX21 silicon ID */
+    s->sys[FMCR / 4] = 0xffffffcb;
+}
+
+static void imx21_crm_init(Object *obj)
+{
+    IMX21CRMState *s = IMX21_CRM(obj);
+
+    memory_region_init_io(&s->iomem, obj, &imx21_crm_ops, s,
+                          TYPE_IMX21_CRM, 0x1000);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static const VMStateDescription vmstate_imx21_crm = {
+    .name = TYPE_IMX21_CRM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_ARRAY(crm, IMX21CRMState, IMX21_CRM_NUM_REGS),
+        VMSTATE_UINT32_ARRAY(sys, IMX21CRMState, IMX21_CRM_NUM_REGS),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx21_crm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_imx21_crm;
+    device_class_set_legacy_reset(dc, imx21_crm_reset);
+    dc->desc = "i.MX21 clock and reset module";
+}
+
+static const TypeInfo imx21_crm_info = {
+    .name = TYPE_IMX21_CRM,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMX21CRMState),
+    .instance_init = imx21_crm_init,
+    .class_init = imx21_crm_class_init,
+};
+
+static void imx21_crm_register_types(void)
+{
+    type_register_static(&imx21_crm_info);
+}
+
+type_init(imx21_crm_register_types)
