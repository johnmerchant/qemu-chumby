+static void chumby_classic_fill_noise(void *ram, uint64_t size)
+{
+    uint32_t *p = ram;
+    uint32_t x = 0x2545f491;
+    uint64_t i;
+
+    for (i = 0; i < size / 4; i++) {
+        x ^= x << 13;
+        x ^= x >> 17;
+        x ^= x << 5;
+        p[i] = x;
+    }
+}
