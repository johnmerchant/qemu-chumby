 specific_ss.add(when: 'CONFIG_TERMINAL3270', if_true: files('terminal3270.c'))
 specific_ss.add(when: 'CONFIG_PSERIES', if_true: files('spapr_vty.c'))
+system_ss.add(when: 'CONFIG_CHUMBY_CLASSIC', if_true: files('chumby_cp.c'))
diff --git a/include/hw/char/chumby_cp.h b/include/hw/char/chumby_cp.h
new file mode 100644
index 000000000..7a55d7b53
--- /dev/null
+++ b/include/hw/char/chumby_cp.h
@@ -0,0 +1,36 @@
+/*
+ * Chumby crypto processor, a microcontroller on a serial line
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_CHAR_CHUMBY_CP_H
+#define HW_CHAR_CHUMBY_CP_H
+
+#include "chardev/char.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+
+#define TYPE_CHARDEV_CHUMBY_CP "chardev-chumby-cp"
+OBJECT_DECLARE_SIMPLE_TYPE(ChumbyCPChardev, CHARDEV_CHUMBY_CP)
+
+#define CHUMBY_CP_LINE_MAX  256
+#define CHUMBY_CP_OUT_MAX   512
+
+struct ChumbyCPChardev {
+    Chardev parent;
+
+    QEMUTimer timer;
+    /* The request being received. */
+    uint8_t line[CHUMBY_CP_LINE_MAX];
+    int line_len;
+    /* Reply bytes, and the time each is due on the wire. */
+    uint8_t out[CHUMBY_CP_OUT_MAX];
+    int64_t due[CHUMBY_CP_OUT_MAX];
+    int out_head;
+    int out_len;
+};
+
+#endif /* HW_CHAR_CHUMBY_CP_H */
