From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Wed, 28 Oct 2026 13:12:22 +0000
Subject: [PATCH 09/11] hw/char: Add the Chumby crypto processor

The Chumby Classic's crypto processor is a microcontroller on a serial
line that holds the device's identity. Model it as a character device
answering the requests the stock tools make, with a fixed, made-up
identity and no keys.

Signed-off-by: John Merchant <john@johnmerchant.dev>
---
 hw/char/chumby_cp.c         | 205 ++++++++++++++++++++++++++++++++++++
 hw/char/meson.build         |   1 +
 include/hw/char/chumby_cp.h |  36 +++++++
 3 files changed, 242 insertions(+)
 create mode 100644 hw/char/chumby_cp.c
 create mode 100644 include/hw/char/chumby_cp.h

diff --git a/hw/char/chumby_cp.c b/hw/char/chumby_cp.c
new file mode 100644
index 000000000..34b09c9ae
--- /dev/null
+++ b/hw/char/chumby_cp.c
@@ -0,0 +1,205 @@
+/*
+ * Chumby crypto processor, a microcontroller on a serial line
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The Chumby Classic's crypto processor (CP) sits on the i.MX21's UART3
+ * and holds the device's identity and an uptime clock. It is modelled as
+ * a character device for that UART.
+ *
+ * The protocol, as the stock "cpi" tool speaks it: each '!' is answered
+ * with '?' (the wake-up handshake). A request is "!!!!", a four-letter
+ * command, optional base64 argument lines each ending in '\n', then
+ * '\r'. A reply is a four-letter tag, one base64 data line ending in
+ * '\r', and a final '\r'; or "FAIL\r" when refused.
+ *
+ * This CP is hardware version 3.8 with a fixed, made-up identity: GUID
+ * C40BB1E0-0000-4000-8000-0E4000000001, serial number 0000000000000000.
+ * It holds no keys, and refuses key and challenge requests.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/char/chumby_cp.h"
+#include "qemu/bswap.h"
+#include "qemu/module.h"
+
+/* A reply starts this long after its request; 38400 baud. */
+#define CP_LATENCY_NS   (2 * SCALE_MS)
+#define CP_CHAR_NS      (NANOSECONDS_PER_SECOND / 3840)
+
+static const uint8_t cp_guid[16] = {
+    0xc4, 0x0b, 0xb1, 0xe0, 0x00, 0x00, 0x40, 0x00,
+    0x80, 0x00, 0x0e, 0x40, 0x00, 0x00, 0x00, 0x01,
+};
+
+/* Hardware version 3.8: minor then major, at bytes 12-13. */
+static const uint8_t cp_hwver[16] = {
+    [12] = 0x08, [13] = 0x03,
+};
+
+static const uint8_t cp_version[6] = { 1, 0, 0, 0, 0, 0 };
+
+static void chumby_cp_deliver(ChumbyCPChardev *cp)
+{
+    Chardev *chr = CHARDEV(cp);
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    while (cp->out_len && cp->due[cp->out_head] <= now &&
+           qemu_chr_be_can_write(chr) > 0) {
+        qemu_chr_be_write(chr, &cp->out[cp->out_head], 1);
+        cp->out_head = (cp->out_head + 1) % CHUMBY_CP_OUT_MAX;
+        cp->out_len--;
+    }
+    if (!cp->out_len) {
+        timer_del(&cp->timer);
+    } else if (cp->due[cp->out_head] > now) {
+        timer_mod(&cp->timer, cp->due[cp->out_head]);
+    } else {
+        /* No room in the UART yet; it asks again as it drains. */
+        timer_mod(&cp->timer, now + CP_CHAR_NS);
+    }
+}
+
+static void chumby_cp_timer(void *opaque)
+{
+    chumby_cp_deliver(opaque);
+}
+
+static void chumby_cp_accept_input(Chardev *chr)
+{
+    chumby_cp_deliver(CHARDEV_CHUMBY_CP(chr));
+}
+
+/* Queues reply bytes, paced at the line rate after a short delay. */
+static void chumby_cp_send(ChumbyCPChardev *cp, const char *bytes, int n)
+{
+    int64_t t = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + CP_LATENCY_NS;
+    int i;
+
+    if (cp->out_len) {
+        int last = (cp->out_head + cp->out_len - 1) % CHUMBY_CP_OUT_MAX;
+
+        t = MAX(t, cp->due[last]);
+    }
+    for (i = 0; i < n && cp->out_len < CHUMBY_CP_OUT_MAX; i++) {
+        int slot = (cp->out_head + cp->out_len) % CHUMBY_CP_OUT_MAX;
+
+        t += CP_CHAR_NS;
+        cp->out[slot] = bytes[i];
+        cp->due[slot] = t;
+        cp->out_len++;
+    }
+    chumby_cp_deliver(cp);
+}
+
+static void chumby_cp_reply(ChumbyCPChardev *cp, const char *tag,
+                            const uint8_t *data, size_t len)
+{
+    g_autofree char *b64 = data ? g_base64_encode(data, len) : NULL;
+    g_autofree char *s = g_strdup_printf("%s%s%s\r", tag, b64 ? b64 : "",
+                                         b64 ? "\r" : "");
+
+    chumby_cp_send(cp, s, strlen(s));
+}
+
+static void chumby_cp_request(ChumbyCPChardev *cp)
+{
+    const char *req = (const char *)cp->line;
+    char cmd[5] = "";
+    uint32_t uptime;
+    uint8_t t[4];
+
+    /* The wake-up '!' runs straight into the "!!!!" prefix. */
+    if (cp->line_len < 4 || strncmp(req, "!!!!", 4)) {
+        return;
+    }
+    while (*req == '!') {
+        req++;
+    }
+    g_strlcpy(cmd, req, sizeof(cmd));
+
+    if (!strcmp(cmd, "HWVR")) {
+        chumby_cp_reply(cp, "HVRS", cp_hwver, sizeof(cp_hwver));
+    } else if (!strcmp(cmd, "PIDX")) {
+        chumby_cp_reply(cp, "PIDX", cp_guid, sizeof(cp_guid));
+    } else if (!strcmp(cmd, "SNUM")) {
+        chumby_cp_reply(cp, "SNUM", (const uint8_t *)"0000000000000000", 16);
+    } else if (!strcmp(cmd, "VERS")) {
+        chumby_cp_reply(cp, "VRSR", cp_version, sizeof(cp_version));
+    } else if (!strcmp(cmd, "TIME")) {
+        uptime = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) /
+                 NANOSECONDS_PER_SECOND;
+        stl_le_p(t, uptime);
+        chumby_cp_reply(cp, "TIME", t, sizeof(t));
+    } else if (!strcmp(cmd, "CKEY")) {
+        static const uint8_t none[4];
+
+        chumby_cp_reply(cp, "CKEY", none, sizeof(none));
+    } else if (!strcmp(cmd, "ALRM")) {
+        chumby_cp_reply(cp, "ASET", NULL, 0);
+    } else if (!strcmp(cmd, "DOWN") || !strcmp(cmd, "RSET")) {
+        chumby_cp_send(cp, "\r", 1);
+    } else {
+        chumby_cp_send(cp, "FAIL\r", 5);
+    }
+}
+
+static int chumby_cp_write(Chardev *chr, const uint8_t *buf, int len)
+{
+    ChumbyCPChardev *cp = CHARDEV_CHUMBY_CP(chr);
+    int i;
+
+    for (i = 0; i < len; i++) {
+        if (buf[i] == '!') {
+            chumby_cp_send(cp, "?", 1);
+        }
+        if (buf[i] == '\r') {
+            cp->line[cp->line_len] = 0;
+            chumby_cp_request(cp);
+            cp->line_len = 0;
+        } else if (cp->line_len < CHUMBY_CP_LINE_MAX - 1) {
+            cp->line[cp->line_len++] = buf[i];
+        }
+    }
+    return len;
+}
+
+static void chumby_cp_init(Object *obj)
+{
+    ChumbyCPChardev *cp = CHARDEV_CHUMBY_CP(obj);
+
+    timer_init_ns(&cp->timer, QEMU_CLOCK_VIRTUAL, chumby_cp_timer, cp);
+}
+
+static void chumby_cp_finalize(Object *obj)
+{
+    ChumbyCPChardev *cp = CHARDEV_CHUMBY_CP(obj);
+
+    timer_del(&cp->timer);
+}
+
+static void chumby_cp_class_init(ObjectClass *oc, const void *data)
+{
+    ChardevClass *cc = CHARDEV_CLASS(oc);
+
+    cc->chr_write = chumby_cp_write;
+    cc->chr_accept_input = chumby_cp_accept_input;
+}
+
+static const TypeInfo chumby_cp_info = {
+    .name = TYPE_CHARDEV_CHUMBY_CP,
+    .parent = TYPE_CHARDEV,
+    .instance_size = sizeof(ChumbyCPChardev),
+    .instance_init = chumby_cp_init,
+    .instance_finalize = chumby_cp_finalize,
+    .class_init = chumby_cp_class_init,
+};
+
+static void chumby_cp_register_types(void)
+{
+    type_register_static(&chumby_cp_info);
+}
+
+type_init(chumby_cp_register_types)
