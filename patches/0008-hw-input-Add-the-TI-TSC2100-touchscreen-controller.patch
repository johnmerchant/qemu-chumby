From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: John Merchant <john@johnmerchant.dev>
Date: Wed, 28 Oct 2026 13:12:21 +0000
Subject: [PATCH 08/11] hw/input: Add the TI TSC2100 touchscreen controller

The TSC2100's SPI interface: register pages for conversion results,
touch control and audio control, conversions that finish at once, and
the PINTDAV output. The pen is QEMU's absolute pointer. No audio is
produced.

Signed-off-by: John Merchant <john@johnmerchant.dev>
---
 hw/input/Kconfig           |   4 +
 hw/input/meson.build       |   1 +
 hw/input/tsc2100.c         | 315 +++++++++++++++++++++++++++++++++++++
 include/hw/input/tsc2100.h |  47 ++++++
 4 files changed, 367 insertions(+)
 create mode 100644 hw/input/tsc2100.c
 create mode 100644 include/hw/input/tsc2100.h

diff --git a/hw/input/Kconfig b/hw/input/Kconfig
index a116cb82d..89b5db62b 100644
--- a/hw/input/Kconfig
+++ b/hw/input/Kconfig
@@ -33,3 +33,7 @@ config VHOST_USER_INPUT
 
 config LASIPS2
     select PS2
+
+config TSC2100
+    bool
+    select SSI
diff --git a/hw/input/meson.build b/hw/input/meson.build
index 90a214962..ae37f7fd5 100644
--- a/hw/input/meson.build
+++ b/hw/input/meson.build
@@ -10,3 +10,4 @@ system_ss.add(when: 'CONFIG_VIRTIO_INPUT', if_true: files('virtio-input-hid.c'))
 system_ss.add(when: 'CONFIG_VIRTIO_INPUT_HOST', if_true: files('virtio-input-host.c'))
 
 system_ss.add(when: 'CONFIG_LASIPS2', if_true: files('lasips2.c'))
+system_ss.add(when: 'CONFIG_TSC2100', if_true: files('tsc2100.c'))
diff --git a/hw/input/tsc2100.c b/hw/input/tsc2100.c
new file mode 100644
index 000000000..448f8619e
--- /dev/null
+++ b/hw/input/tsc2100.c
@@ -0,0 +1,315 @@
+/*
+ * TI TSC2100 touchscreen controller and audio codec, SPI interface
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * A frame, one chip select, is a 16-bit command word (bit 15 read, bits
+ * 14:11 page, 10:5 register) followed by data words, the register
+ * advancing with each. Page 0 holds the conversion results, page 1 the
+ * touch controls and page 2 the audio controls, which are kept as
+ * written; no audio is produced.
+ *
+ * Conversions finish at once. The pen is QEMU's absolute pointer: its
+ * position maps onto the ADC's full range (X left to right, Y bottom to
+ * top) and the left button presses it.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/input/tsc2100.h"
+#include "hw/core/irq.h"
+#include "migration/vmstate.h"
+#include "qemu/module.h"
+
+#define REG(page, n)    ((page) * 64 + (n))
+
+/* Page 0: conversion results */
+#define REG_X           REG(0, 0)
+#define REG_Y           REG(0, 1)
+#define REG_Z1          REG(0, 2)
+#define REG_Z2          REG(0, 3)
+#define REG_BAT1        REG(0, 5)
+#define REG_TEMP2       REG(0, 10)
+
+/* Page 1: touch controls */
+#define REG_ADC         REG(1, 0)
+#define REG_STATUS      REG(1, 1)
+#define REG_REF         REG(1, 3)
+#define REG_RESET       REG(1, 4)
+
+#define ADC_PSTCM       (1 << 15)
+#define ADC_ADST        (1 << 14)
+#define STATUS_DAVAIL   (1 << 11)
+
+#define RESET_MAGIC     0xbb00
+#define ADC_MAX         0xfff
+
+/* The result registers each scan mode (ADC bits 13:10) converts. */
+static uint16_t tsc2100_scan_mask(unsigned mode)
+{
+    static const uint16_t results[16] = {
+        [1] = 0x003,    /* X, Y */
+        [2] = 0x00f,    /* X, Y, Z1, Z2 */
+        [3] = 0x001,    /* X */
+        [4] = 0x002,    /* Y */
+        [5] = 0x00c,    /* Z1, Z2 */
+        [6] = 0x020,    /* BAT1 */
+        [7] = 0x040,    /* BAT2 */
+        [8] = 0x080,    /* AUX1 */
+        [9] = 0x100,    /* AUX2 */
+        [10] = 0x200,   /* TEMP1 */
+        [11] = 0x1e0,   /* BAT1, BAT2, AUX1, AUX2 */
+        [12] = 0x400,   /* TEMP2 */
+    };
+    return results[mode & 0xf];
+}
+
+/*
+ * A result register's flag in STATUS: bits 10-7 for X, Y, Z1 and Z2,
+ * bits 6-1 for BAT1 to TEMP2.
+ */
+static uint16_t tsc2100_status_bit(int reg)
+{
+    return reg < 4 ? 1 << (10 - reg) : 1 << (11 - reg);
+}
+
+static uint16_t tsc2100_ready_bits(uint16_t mask)
+{
+    uint16_t bits = 0;
+    int reg;
+
+    for (reg = 0; reg < 11; reg++) {
+        if (mask & (1 << reg)) {
+            bits |= tsc2100_status_bit(reg);
+        }
+    }
+    return bits;
+}
+
+/* PINTDAV, active low: pen down, data available, or either (STATUS 15:14) */
+static void tsc2100_update_pintdav(TSC2100State *s)
+{
+    bool active;
+
+    switch (s->regs[REG_STATUS] >> 14) {
+    case 0:
+        active = s->down || s->dav;
+        break;
+    case 2:
+        active = s->down;
+        break;
+    default:
+        active = s->dav;
+        break;
+    }
+    qemu_set_irq(s->pintdav, !active);
+}
+
+static uint16_t tsc2100_read_reg(TSC2100State *s, int reg)
+{
+    uint16_t v;
+
+    switch (reg) {
+    case REG_X:
+        return s->x;
+    case REG_Y:
+        return s->y;
+    case REG_Z1:
+        /* A firm press while down. */
+        return s->down ? 0x400 : 0;
+    case REG_Z2:
+        return s->down ? 0x800 : ADC_MAX;
+    case REG_BAT1 ... REG(0, 8):
+        /* Battery and aux inputs: mid-scale. */
+        return 0x800;
+    case REG(0, 9):
+    case REG_TEMP2:
+        /* Temperature: a room's. */
+        return 0x700;
+    case REG_ADC:
+        v = (s->regs[REG_ADC] & ~ADC_PSTCM) | ADC_ADST;
+        return s->down ? v | ADC_PSTCM : v;
+    case REG_STATUS:
+        v = (s->regs[REG_STATUS] & 0xc000) | s->ready;
+        return s->ready ? v | STATUS_DAVAIL : v;
+    default:
+        return s->regs[reg];
+    }
+}
+
+static void tsc2100_reset_regs(TSC2100State *s)
+{
+    memset(s->regs, 0, sizeof(s->regs));
+    s->ready = 0;
+    s->dav = false;
+    /* ADC: host-controlled, no scan; REF: internal reference. */
+    s->regs[REG_ADC] = 0x4000;
+    s->regs[REG_REF] = 0x0002;
+}
+
+static void tsc2100_write_reg(TSC2100State *s, int reg, uint16_t val)
+{
+    uint16_t mask;
+
+    if (reg == REG_RESET) {
+        if (val == RESET_MAGIC) {
+            tsc2100_reset_regs(s);
+        }
+        return;
+    }
+    s->regs[reg] = val;
+    if (reg == REG_ADC) {
+        /* A scan mode starts a conversion, which finishes at once. */
+        mask = tsc2100_scan_mask(val >> 10);
+        if (mask) {
+            s->ready |= tsc2100_ready_bits(mask);
+            s->dav = true;
+        }
+    }
+}
+
+static uint32_t tsc2100_transfer(SSIPeripheral *dev, uint32_t val)
+{
+    TSC2100State *s = TSC2100(dev);
+    uint32_t ret = 0;
+    int reg;
+
+    if (s->word++ == 0) {
+        s->cmd = val;
+        s->addr = (val >> 5) & 0x3f;
+        return 0;
+    }
+    reg = REG((s->cmd >> 11) & 3, s->addr);
+    if (s->cmd & 0x8000) {
+        ret = tsc2100_read_reg(s, reg);
+        if (reg < 64) {
+            s->ready &= ~tsc2100_status_bit(reg);
+            if (!s->ready) {
+                s->dav = false;
+            }
+        }
+    } else {
+        tsc2100_write_reg(s, reg, val);
+    }
+    s->addr = (s->addr + 1) & 0x3f;
+    tsc2100_update_pintdav(s);
+    return ret;
+}
+
+static int tsc2100_set_cs(SSIPeripheral *dev, bool select)
+{
+    TSC2100State *s = TSC2100(dev);
+
+    if (select) {
+        s->word = 0;
+    }
+    return 0;
+}
+
+static void tsc2100_input_event(DeviceState *dev, QemuConsole *src,
+                                QemuInputEvent *evt)
+{
+    TSC2100State *s = TSC2100(dev);
+
+    switch (evt->type) {
+    case INPUT_EVENT_KIND_ABS:
+        if (evt->abs.axis == INPUT_AXIS_X) {
+            s->abs_x = evt->abs.value;
+        } else if (evt->abs.axis == INPUT_AXIS_Y) {
+            s->abs_y = evt->abs.value;
+        }
+        break;
+    case INPUT_EVENT_KIND_BTN:
+        if (evt->btn.button == INPUT_BUTTON_LEFT) {
+            s->down = evt->btn.down;
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static void tsc2100_input_sync(DeviceState *dev)
+{
+    TSC2100State *s = TSC2100(dev);
+
+    s->x = qemu_input_scale_axis(s->abs_x, INPUT_EVENT_ABS_MIN,
+                                 INPUT_EVENT_ABS_MAX, 0, ADC_MAX);
+    s->y = ADC_MAX - qemu_input_scale_axis(s->abs_y, INPUT_EVENT_ABS_MIN,
+                                           INPUT_EVENT_ABS_MAX, 0, ADC_MAX);
+    tsc2100_update_pintdav(s);
+}
+
+static const QemuInputHandler tsc2100_input_handler = {
+    .name  = "TSC2100 touchscreen",
+    .mask  = INPUT_EVENT_MASK_BTN | INPUT_EVENT_MASK_ABS,
+    .event = tsc2100_input_event,
+    .sync  = tsc2100_input_sync,
+};
+
+static void tsc2100_realize(SSIPeripheral *dev, Error **errp)
+{
+    TSC2100State *s = TSC2100(dev);
+
+    qdev_init_gpio_out_named(DEVICE(dev), &s->pintdav, TSC2100_PINTDAV, 1);
+    s->input = qemu_input_handler_register(DEVICE(dev),
+                                           &tsc2100_input_handler);
+}
+
+static void tsc2100_reset(DeviceState *dev)
+{
+    TSC2100State *s = TSC2100(dev);
+
+    tsc2100_reset_regs(s);
+    s->word = 0;
+    s->down = false;
+    tsc2100_update_pintdav(s);
+}
+
+static const VMStateDescription vmstate_tsc2100 = {
+    .name = TYPE_TSC2100,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_SSI_PERIPHERAL(parent_obj, TSC2100State),
+        VMSTATE_UINT16_ARRAY(regs, TSC2100State, TSC2100_NUM_REGS),
+        VMSTATE_UINT32(word, TSC2100State),
+        VMSTATE_UINT16(cmd, TSC2100State),
+        VMSTATE_UINT32(addr, TSC2100State),
+        VMSTATE_UINT16(ready, TSC2100State),
+        VMSTATE_BOOL(dav, TSC2100State),
+        VMSTATE_BOOL(down, TSC2100State),
+        VMSTATE_UINT16(x, TSC2100State),
+        VMSTATE_UINT16(y, TSC2100State),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void tsc2100_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SSIPeripheralClass *k = SSI_PERIPHERAL_CLASS(klass);
+
+    k->realize = tsc2100_realize;
+    k->transfer = tsc2100_transfer;
+    k->set_cs = tsc2100_set_cs;
+    k->cs_polarity = SSI_CS_LOW;
+    dc->vmsd = &vmstate_tsc2100;
+    device_class_set_legacy_reset(dc, tsc2100_reset);
+    dc->desc = "TI TSC2100 touchscreen controller";
+}
+
+static const TypeInfo tsc2100_info = {
+    .name = TYPE_TSC2100,
+    .parent = TYPE_SSI_PERIPHERAL,
+    .instance_size = sizeof(TSC2100State),
+    .class_init = tsc2100_class_init,
+};
+
+static void tsc2100_register_types(void)
+{
+    type_register_static(&tsc2100_info);
+}
+
+type_init(tsc2100_register_types)
diff --git a/include/hw/input/tsc2100.h b/include/hw/input/tsc2100.h
new file mode 100644
index 000000000..ea467d82f
--- /dev/null
+++ b/include/hw/input/tsc2100.h
@@ -0,0 +1,47 @@
+/*
+ * TI TSC2100 touchscreen controller and audio codec, SPI interface
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef HW_INPUT_TSC2100_H
+#define HW_INPUT_TSC2100_H
+
+#include "hw/ssi/ssi.h"
+#include "ui/input.h"
+#include "qom/object.h"
+
+#define TYPE_TSC2100 "tsc2100"
+OBJECT_DECLARE_SIMPLE_TYPE(TSC2100State, TSC2100)
+
+/* Output GPIO: PINTDAV, active low. */
+#define TSC2100_PINTDAV "pintdav"
+
+#define TSC2100_NUM_REGS (4 * 64)
+
+struct TSC2100State {
+    SSIPeripheral parent_obj;
+
+    qemu_irq pintdav;
+    QemuInputHandlerState *input;
+
+    uint16_t regs[TSC2100_NUM_REGS];
+    /* The frame: words seen since chip select, and its command word. */
+    uint32_t word;
+    uint16_t cmd;
+    uint32_t addr;
+
+    /* Status bits of conversion results not yet read. */
+    uint16_t ready;
+    bool dav;
+
+    /* The pen, in raw ADC units. */
+    bool down;
+    uint16_t x, y;
+    /* The pointer as the input layer last reported it. */
+    int abs_x, abs_y;
+};
+
+#endif /* HW_INPUT_TSC2100_H */
