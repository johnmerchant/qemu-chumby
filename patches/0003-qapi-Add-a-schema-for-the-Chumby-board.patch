+++ b/qapi/chumby.json
@@ -0,0 +1,160 @@
+# -*- Mode: Python -*-
+# vim: filetype=python
+#
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+##
+# ************
+# Chumby board
+# ************
+##
+
+##
+# The board-level controls of the ``chumby-classic`` machine: the
+# lines the guest drives (backlight, LCD power, speaker mute) and the
+# ones a user does (headphones, the top button).
+##
+
+##
+# @ChumbyState:
+#
+# The state of the Chumby's board-level lines, the acceleration its
+# accelerometer senses, and its identity.
+#
+# @backlight: the backlight's duty cycle, 0 (off) to 65535 (fully on),
+#     as the guest's PWM drives it
+#
+# @lcd-on: whether the guest has the LCD panel powered
+#
+# @speaker-mute: whether the guest has the speaker amplifier muted
+#
+# @headphones: whether headphones are plugged in
+#
+# @button: whether the top button is held
+#
+# @accel-x: the acceleration along the accelerometer's X axis, in
+#     milli-g (the machine's ``accel-x`` property)
+#
+# @accel-y: the same along its Y axis (``accel-y``)
+#
+# @accel-z: the same along its Z axis (``accel-z``)
+#
+# @guid: the device GUID the crypto processor reports (``guid``)
+#
+# @serial: the serial number, 16 letters or digits (``serial``)
+#
+# @hwversion: the hardware version, MAJOR.MINOR (``hwversion``)
+#
+# Since: 11.2
+##
+{ 'struct': 'ChumbyState',
+  'data': { 'backlight': 'uint16',
+            'lcd-on': 'bool',
+            'speaker-mute': 'bool',
+            'headphones': 'bool',
+            'button': 'bool',
+            'accel-x': 'int',
+            'accel-y': 'int',
+            'accel-z': 'int',
+            'guid': 'str',
+            'serial': 'str',
+            'hwversion': 'str' } }
+
+##
+# @query-chumby-state:
+#
+# Return the state of the Chumby's board-level lines, its
+# accelerometer's input and its identity.  Only the ``chumby-classic``
+# machine has them; other machines report an error.
+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     -> { "execute": "query-chumby-state" }
+#     <- { "return": { "backlight": 65535, "lcd-on": true,
+#                      "speaker-mute": false, "headphones": false,
+#                      "button": false,
+#                      "accel-x": 0, "accel-y": 0, "accel-z": 1000,
+#                      "guid": "C40BB1E0-0000-4000-8000-0E4000000001",
+#                      "serial": "0000000000000000",
+#                      "hwversion": "3.8" } }
+##
+{ 'command': 'query-chumby-state', 'returns': 'ChumbyState' }
+
+##
+# @CHUMBY_BACKLIGHT:
+#
+# Emitted when the guest changes the backlight's duty cycle.
+#
+# @level: the new duty cycle, 0 (off) to 65535 (fully on)
+#
+# .. note:: This event is rate-limited: a fade sends the first level
+#    at once and then at most one every 100 ms, the last being the
+#    final level.
+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     <- { "event": "CHUMBY_BACKLIGHT",
+#          "data": { "level": 32768 },
+#          "timestamp": { "seconds": 1265044230, "microseconds": 450486 } }
+##
+{ 'event': 'CHUMBY_BACKLIGHT',
+  'data': { 'level': 'uint16' } }
+
+##
+# @CHUMBY_LCD:
+#
+# Emitted when the guest powers the LCD panel on or off.
+#
+# @on: whether the panel is now powered
+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     <- { "event": "CHUMBY_LCD",
+#          "data": { "on": false },
+#          "timestamp": { "seconds": 1265044230, "microseconds": 450486 } }
+##
+{ 'event': 'CHUMBY_LCD',
+  'data': { 'on': 'bool' } }
+
+##
+# @CHUMBY_SPEAKER_MUTE:
+#
+# Emitted when the guest mutes or unmutes the speaker amplifier.
+#
+# @muted: whether the speaker is now muted
+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     <- { "event": "CHUMBY_SPEAKER_MUTE",
+#          "data": { "muted": true },
+#          "timestamp": { "seconds": 1265044230, "microseconds": 450486 } }
+##
+{ 'event': 'CHUMBY_SPEAKER_MUTE',
+  'data': { 'muted': 'bool' } }
+
+##
+# @CHUMBY_HEADPHONES:
+#
+# Emitted when headphones are plugged in or out (the machine's
+# ``headphones`` property).
+#
+# @inserted: whether headphones are now plugged in
+#
+# Since: 11.2
+#
+# .. qmp-example::
+#
+#     <- { "event": "CHUMBY_HEADPHONES",
+#          "data": { "inserted": true },
+#          "timestamp": { "seconds": 1265044230, "microseconds": 450486 } }
+##
+{ 'event': 'CHUMBY_HEADPHONES',
+  'data': { 'inserted': 'bool' } }
