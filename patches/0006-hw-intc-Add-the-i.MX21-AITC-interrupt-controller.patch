+/*
+ * i.MX21 AITC interrupt controller
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * 64 level-sensitive sources, each a normal (IRQ) or fast (FIQ)
+ * interrupt, with 16 priority levels for normal interrupts. The register
+ * layout matches the i.MX31 AVIC, but the vector registers report the
+ * pending source without acknowledging it: a source stays pending until
+ * its device drops the line.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/intc/imx21_aitc.h"
+#include "hw/core/irq.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+#define INTCNTL     0x00
+#define NIMASK      0x04
+#define INTENNUM    0x08
+#define INTDISNUM   0x0c
+#define INTENABLEH  0x10
+#define INTENABLEL  0x14
+#define INTTYPEH    0x18
+#define INTTYPEL    0x1c
+#define NIPRIORITY7 0x20
+#define NIPRIORITY0 0x3c
+#define NIVECSR     0x40
+#define FIVECSR     0x44
+#define INTSRCH     0x48
+#define INTSRCL     0x4c
+#define INTFRCH     0x50
+#define INTFRCL     0x54
+#define NIPNDH      0x58
+#define NIPNDL      0x5c
+#define FIPNDH      0x60
+#define FIPNDL      0x64
+
+#define INTCNTL_FIDIS (1 << 21)
+#define INTCNTL_NIDIS (1 << 22)
+
+static uint64_t imx21_aitc_pending(IMX21AITCState *s)
+{
+    return (s->sources | s->force) & s->enable;
+}
+
+static int imx21_aitc_prio(IMX21AITCState *s, int n)
+{
+    return (s->nipriority[n / 8] >> ((n % 8) * 4)) & 0xf;
+}
+
+/*
+ * The highest-priority pending normal interrupt not masked by NIMASK;
+ * ties go to the higher-numbered source. Returns -1 if there is none.
+ */
+static int imx21_aitc_normal(IMX21AITCState *s, int *prio)
+{
+    uint64_t pend = imx21_aitc_pending(s) & ~s->inttype;
+    int best = -1, best_prio = -1;
+    int n;
+
+    for (n = 0; n < IMX21_AITC_NUM_IRQS; n++) {
+        if (pend & (1ULL << n)) {
+            int p = imx21_aitc_prio(s, n);
+            /* NIMASK masks levels at or below its value; 0x1f none. */
+            if (s->nimask < 16 && p <= s->nimask) {
+                continue;
+            }
+            if (p >= best_prio) {
+                best = n;
+                best_prio = p;
+            }
+        }
+    }
+    if (prio) {
+        *prio = best_prio;
+    }
+    return best;
+}
+
+static void imx21_aitc_update(IMX21AITCState *s)
+{
+    bool irq = !(s->intcntl & INTCNTL_NIDIS) && imx21_aitc_normal(s, NULL) >= 0;
+    bool fiq = !(s->intcntl & INTCNTL_FIDIS) &&
+               (imx21_aitc_pending(s) & s->inttype);
+
+    qemu_set_irq(s->irq, irq);
+    qemu_set_irq(s->fiq, fiq);
+}
+
+static void imx21_aitc_set_irq(void *opaque, int n, int level)
+{
+    IMX21AITCState *s = opaque;
+
+    if (level) {
+        s->sources |= 1ULL << n;
+    } else {
+        s->sources &= ~(1ULL << n);
+    }
+    imx21_aitc_update(s);
+}
+
+static uint64_t imx21_aitc_read(void *opaque, hwaddr offset, unsigned size)
+{
+    IMX21AITCState *s = opaque;
+    uint64_t pend = imx21_aitc_pending(s);
+    int n, prio;
+
+    switch (offset) {
+    case INTCNTL:
+        return s->intcntl;
+    case NIMASK:
+        return s->nimask;
+    case INTENNUM:
+    case INTDISNUM:
+        return 0;
+    case INTENABLEH:
+        return s->enable >> 32;
+    case INTENABLEL:
+        return (uint32_t)s->enable;
+    case INTTYPEH:
+        return s->inttype >> 32;
+    case INTTYPEL:
+        return (uint32_t)s->inttype;
+    case NIPRIORITY7 ... NIPRIORITY0:
+        return s->nipriority[7 - (offset - NIPRIORITY7) / 4];
+    case NIVECSR:
+        n = imx21_aitc_normal(s, &prio);
+        return n < 0 ? 0xffffffff : (n << 16) | prio;
+    case FIVECSR:
+        pend &= s->inttype;
+        return pend ? 63 - clz64(pend) : 0xffffffff;
+    case INTSRCH:
+        return s->sources >> 32;
+    case INTSRCL:
+        return (uint32_t)s->sources;
+    case INTFRCH:
+        return s->force >> 32;
+    case INTFRCL:
+        return (uint32_t)s->force;
+    case NIPNDH:
+        return (pend & ~s->inttype) >> 32;
+    case NIPNDL:
+        return (uint32_t)(pend & ~s->inttype);
+    case FIPNDH:
+        return (pend & s->inttype) >> 32;
+    case FIPNDL:
+        return (uint32_t)(pend & s->inttype);
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad register at 0x%" HWADDR_PRIx
+                      "\n", __func__, offset);
+        return 0;
+    }
+}
+
+static void imx21_aitc_write(void *opaque, hwaddr offset, uint64_t val,
+                             unsigned size)
+{
+    IMX21AITCState *s = opaque;
+
+    switch (offset) {
+    case INTCNTL:
+        s->intcntl = val;
+        break;
+    case NIMASK:
+        s->nimask = val & 0x1f;
+        break;
+    case INTENNUM:
+        s->enable |= 1ULL << (val & 63);
+        break;
+    case INTDISNUM:
+        s->enable &= ~(1ULL << (val & 63));
+        break;
+    case INTENABLEH:
+        s->enable = deposit64(s->enable, 32, 32, val);
+        break;
+    case INTENABLEL:
+        s->enable = deposit64(s->enable, 0, 32, val);
+        break;
+    case INTTYPEH:
+        s->inttype = deposit64(s->inttype, 32, 32, val);
+        break;
+    case INTTYPEL:
+        s->inttype = deposit64(s->inttype, 0, 32, val);
+        break;
+    case NIPRIORITY7 ... NIPRIORITY0:
+        s->nipriority[7 - (offset - NIPRIORITY7) / 4] = val;
+        break;
+    case INTFRCH:
+        s->force = deposit64(s->force, 32, 32, val);
+        break;
+    case INTFRCL:
+        s->force = deposit64(s->force, 0, 32, val);
+        break;
+    case NIVECSR:
+    case FIVECSR:
+    case INTSRCH:
+    case INTSRCL:
+    case NIPNDH ... FIPNDL:
+        /* Read-only */
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR, "%s: bad register at 0x%" HWADDR_PRIx
+                      "\n", __func__, offset);
+        return;
+    }
+    imx21_aitc_update(s);
+}
+
+static const MemoryRegionOps imx21_aitc_ops = {
+    .read = imx21_aitc_read,
+    .write = imx21_aitc_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .impl = {
+        .min_access_size = 4,
+        .max_access_size = 4,
+    },
+};
+
+static void imx21_aitc_reset(DeviceState *dev)
+{
+    IMX21AITCState *s = IMX21_AITC(dev);
+
+    s->force = 0;
+    s->enable = 0;
+    s->inttype = 0;
+    s->intcntl = 0;
+    s->nimask = 0x1f;
+    memset(s->nipriority, 0, sizeof(s->nipriority));
+    imx21_aitc_update(s);
+}
+
+static void imx21_aitc_init(Object *obj)
+{
+    IMX21AITCState *s = IMX21_AITC(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &imx21_aitc_ops, s,
+                          TYPE_IMX21_AITC, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    qdev_init_gpio_in(DEVICE(obj), imx21_aitc_set_irq, IMX21_AITC_NUM_IRQS);
+    sysbus_init_irq(sbd, &s->irq);
+    sysbus_init_irq(sbd, &s->fiq);
+}
+
+static const VMStateDescription vmstate_imx21_aitc = {
+    .name = TYPE_IMX21_AITC,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT64(sources, IMX21AITCState),
+        VMSTATE_UINT64(force, IMX21AITCState),
+        VMSTATE_UINT64(enable, IMX21AITCState),
+        VMSTATE_UINT64(inttype, IMX21AITCState),
+        VMSTATE_UINT32(intcntl, IMX21AITCState),
+        VMSTATE_UINT32(nimask, IMX21AITCState),
+        VMSTATE_UINT32_ARRAY(nipriority, IMX21AITCState, 8),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void imx21_aitc_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_imx21_aitc;
+    device_class_set_legacy_reset(dc, imx21_aitc_reset);
+    dc->desc = "i.MX21 interrupt controller (AITC)";
+}
+
+static const TypeInfo imx21_aitc_info = {
+    .name = TYPE_IMX21_AITC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(IMX21AITCState),
+    .instance_init = imx21_aitc_init,
+    .class_init = imx21_aitc_class_init,
+};
+
+static void imx21_aitc_register_types(void)
+{
+    type_register_static(&imx21_aitc_info);
+}
+
+type_init(imx21_aitc_register_types)
