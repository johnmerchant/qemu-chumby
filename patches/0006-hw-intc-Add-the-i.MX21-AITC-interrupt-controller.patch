--- /dev/null
+++ b/include/hw/intc/imx21_aitc.h
@@ -0,0 +1,36 @@
+/*
+ * i.MX21 AITC interrupt controller
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_AITC_H
+#define IMX21_AITC_H
+
+#include "hw/core/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_AITC "imx21.aitc"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21AITCState, IMX21_AITC)
+
+#define IMX21_AITC_NUM_IRQS 64
+
+struct IMX21AITCState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    qemu_irq fiq;
+
+    uint64_t sources;
+    uint64_t force;
+    uint64_t enable;
+    uint64_t inttype;
+    uint32_t intcntl;
+    uint32_t nimask;
+    uint32_t nipriority[8];
+};
+
+#endif /* IMX21_AITC_H */
