@@ -0,0 +1,43 @@
+/*
+ * i.MX21 real-time clock (RTC)
+ *
+ * Copyright (c) 2026 John Merchant <john@johnmerchant.dev>
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef IMX21_RTC_H
+#define IMX21_RTC_H
+
+#include "hw/core/sysbus.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+
+#define TYPE_IMX21_RTC "imx21.rtc"
+OBJECT_DECLARE_SIMPLE_TYPE(IMX21RTCState, IMX21_RTC)
+
+struct IMX21RTCState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    QEMUTimer *timer;
+    qemu_irq irq;
+
+    uint32_t alrm_hm;
+    uint32_t alrm_sec;
+    uint32_t rtcctl;
+    uint32_t rtcisr;
+    uint32_t rtcienr;
+    uint32_t dayalarm;
+    /* The stopwatch counts down from stpwch_base at minute stpwch_min0. */
+    uint32_t stpwch_base;
+    int64_t stpwch_min0;
+    /* While enabled, the count in ns is rtc_clock + offset_ns. */
+    int64_t offset_ns;
+    /* While disabled, the count in ns. */
+    int64_t frozen_ns;
+    /* The count up to which events have been latched. */
+    int64_t last_ns;
+};
+
+#endif /* IMX21_RTC_H */
