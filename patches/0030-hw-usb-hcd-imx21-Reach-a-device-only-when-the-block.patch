+bool imx21_usbotg_add_board_hub(DeviceState *dev, int port, Error **errp)
+{
+    IMX21USBOTGState *s = IMX21_USBOTG(dev);
+    g_autofree char *path = g_strdup_printf("%d", port);
+    USBDevice *hub = USB_DEVICE(qdev_new("usb-hub"));
+    int i;
+
+    qdev_prop_set_string(DEVICE(hub), "port", path);
+    if (!usb_realize_and_unref(hub, &s->bus, errp)) {
+        return false;
+    }
+    /* The free list is what a device given no port takes the first of. */
+    for (i = 0; i < NUM_PORTS; i++) {
+        if (!s->ports[i].dev) {
+            QTAILQ_REMOVE(&s->bus.free, &s->ports[i], next);
+            QTAILQ_INSERT_TAIL(&s->bus.free, &s->ports[i], next);
+        }
+    }
+    return true;
+}
