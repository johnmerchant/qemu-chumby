#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""dev-series import|export [--base REV] DIR [PATCHES]: the patch series as
git commits.

import: DIR is a QEMU source tree at the pinned release (a git checkout,
or an extracted tarball, which becomes one). Each patch in PATCHES
(default: this checkout's patches/) is applied and committed: the author
from its Author: field, the message from Description: and the trailers
after it, the date the time of the import, in UTC.

export: writes the commits on DIR's current branch since REV (default:
the tag chumby-base, which import sets) to PATCHES as NNNN-slug.patch,
replacing the patches there.

A patch is a DEP-3 header, a line "---" and git's diff without index
lines, which patch -p1 and git apply take:

    Description: hw/foo: Add the bar
     The explanation, each line indented by one space,
     .
     an empty line as " .".
    Author: Name <email>
    Upstream-Status: ...
    Signed-off-by: ...
    ---
    diff --git a/... b/...

Exporting what was imported gives back the same files, byte for byte.
"""
import os
import re
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
BASE = "chumby-base"


def git(cwd, *args, env=None, inp=None):
    e = dict(os.environ, TZ="UTC", **(env or {}))
    return subprocess.run(["git", *args], cwd=cwd, env=e, input=inp,
                          check=True, capture_output=True,
                          text=True).stdout


def parse(text, name):
    """(author name, email, commit message, diff) of a patch."""
    header, sep, diff = text.partition("\n---\n")
    if not sep or not diff.startswith("diff --git "):
        sys.exit(f"{name}: no '---' line before the diff")
    lines = header.split("\n")
    if not lines[0].startswith("Description: "):
        sys.exit(f"{name}: no Description: first")
    subject = lines[0][len("Description: "):]
    body = []
    i = 1
    while i < len(lines) and lines[i].startswith(" "):
        body.append("" if lines[i] == " ." else lines[i][1:])
        i += 1
    if i >= len(lines) or not lines[i].startswith("Author: "):
        sys.exit(f"{name}: no Author: after the Description:")
    m = re.fullmatch(r"Author: (.+?) <([^>]+)>", lines[i])
    if not m:
        sys.exit(f"{name}: Author: is not 'Name <email>'")
    trailers = lines[i + 1:]
    msg = subject + "\n"
    if body:
        msg += "\n" + "\n".join(body) + "\n"
    if trailers:
        msg += "\n" + "\n".join(trailers) + "\n"
    return m.group(1), m.group(2), msg, diff


def import_(tree, patches):
    if not os.path.isdir(os.path.join(tree, ".git")):
        git(tree, "init", "-q")
        git(tree, "add", "-A")
        git(tree, "commit", "-q", "-m", "QEMU release")
    git(tree, "update-ref", "refs/tags/" + BASE, "HEAD")
    for p in sorted(f for f in os.listdir(patches) if f.endswith(".patch")):
        with open(os.path.join(patches, p)) as f:
            name, email, msg, diff = parse(f.read(), p)
        git(tree, "apply", "--index", "-", inp=diff)
        who = {"GIT_AUTHOR_NAME": name, "GIT_AUTHOR_EMAIL": email,
               "GIT_COMMITTER_NAME": name, "GIT_COMMITTER_EMAIL": email}
        git(tree, "commit", "-q", "--cleanup=verbatim", "-F", "-",
            env=who, inp=msg)
        print(f"imported {p}")


def slug(subject):
    s = re.sub(r"[^A-Za-z0-9.]+", "-", subject).strip("-.")
    return s[:52].rstrip("-.")


def drop_index(diff):
    """git's diff without the index lines of each file's header."""
    out = []
    in_header = False
    for line in diff.splitlines(keepends=True):
        if line.startswith("diff --git "):
            in_header = True
        elif line.startswith(("--- ", "+++ ", "@@ ", "Binary files ")):
            in_header = False
        elif in_header and line.startswith("index "):
            continue
        out.append(line)
    return "".join(out)


def export(tree, patches, base):
    commits = git(tree, "rev-list", "--reverse", f"{base}..HEAD").split()
    for f in os.listdir(patches):
        if f.endswith(".patch"):
            os.remove(os.path.join(patches, f))
    for n, c in enumerate(commits, 1):
        author = git(tree, "show", "-s", "--format=%an <%ae>", c).strip()
        msg = git(tree, "show", "-s", "--format=%B", c).rstrip("\n")
        paras = msg.split("\n\n")
        subject = paras[0]
        if "\n" in subject:
            sys.exit(f"{c}: the subject is more than one line")
        trailers = []
        last = paras[-1].split("\n")
        if len(paras) > 1 and all(re.match(r"[A-Za-z-]+: ", t)
                                  for t in last):
            trailers = last
            paras = paras[:-1]
        body = "\n\n".join(paras[1:]).split("\n") if len(paras) > 1 else []
        head = [f"Description: {subject}"]
        head += [" ." if b == "" else " " + b for b in body]
        head += [f"Author: {author}"] + trailers
        diff = git(tree, "diff-tree", "-p", "--no-renames", "--no-color",
                   "--no-ext-diff", "--no-textconv", "--src-prefix=a/",
                   "--dst-prefix=b/", "--diff-algorithm=myers", c + "^", c)
        name = f"{n:04d}-{slug(subject)}.patch"
        with open(os.path.join(patches, name), "w") as f:
            f.write("\n".join(head) + "\n---\n" + drop_index(diff))
        print(f"exported {name}")


def main():
    args = sys.argv[1:]
    base = BASE
    if len(args) > 2 and args[1] == "--base":
        base = args[2]
        del args[1:3]
    if len(args) not in (2, 3) or args[0] not in ("import", "export"):
        sys.exit(__doc__.split("\n\n")[0])
    tree = os.path.abspath(args[1])
    patches = os.path.abspath(args[2] if len(args) == 3
                              else os.path.join(HERE, "patches"))
    if args[0] == "import":
        import_(tree, patches)
    else:
        export(tree, patches, base)


main()
