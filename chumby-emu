#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""chumby-emu: run a Chumby Classic as a desktop app, on macOS and Linux.

    chumby-emu IMAGES                     a directory with zImage and nand.img
    chumby-emu --kernel zImage --nand nand.img

Starts qemu-system-arm -M chumby-classic with a window (Cocoa on macOS,
GTK or SDL on Linux) and sound (CoreAudio; PipeWire, PulseAudio or ALSA),
and opens a control panel beside it for what the window can't do: the top
button, tilting and shaking, headphones, the outputs the Chumby drives
(backlight, speaker mute, LCD), screenshots, snapshots and the console.
The mouse in the window is the pen.

On macOS, once Chumby.app is built (frontend/mac/build-app), this runs
it instead: one native window with the screen, the controls and the
console. --display, --no-panel or CHUMBY_EMU_QT=1 keep QEMU's window and
the Qt panel.

On Linux, once the native app is built (frontend/linux: cargo build
--release, or chumby-desktop on $PATH), chumby-emu runs that instead:
one window with the screen and the controls, the same options. --display,
--no-panel or CHUMBY_EMU_QT=1 keep QEMU's window and the Qt panel.

The emulated Chumby never has a network: QEMU runs with -nic none.

Options:
  --qemu PATH         qemu-system-arm with the machine (default: beside
                      this script, then build/obj/, then $PATH)
  --display NAME      cocoa, gtk, sdl or none (default: the platform's)
  --audio NAME        coreaudio, pipewire, pa, alsa, wav:FILE or none
                      (default: the platform's, found at startup)
  --write             write the NAND image (default: snapshot=on, so the
                      image is never changed)
  --state DIR         keep this Chumby's flash writes and saved state in
                      DIR (a qcow2 overlay of the NAND image, which stays
                      unchanged); "Save state" in the panel saves there,
                      and the next start resumes from it in a second.
                      Needs qemu-img.
  --fast              -icount shift=auto,sleep=off: boot in seconds,
                      but emulated time runs ahead while idle, so sound
                      comes in bursts: for scripts and tests, not for use
  --scale N           the window's size, in points (logical pixels) per
                      Chumby pixel (default: the size of a real Chumby's
                      screen, 71 x 53 mm, on your display); the window
                      can be resized, keeping its shape
  --title TEXT        the window's title and QEMU's -name (default:
                      "Chumby —" and the images folder's name, or the
                      kernel's folder's)
  --no-panel          no control panel (the window only)
  --link SOCK         UART2 to the unix socket SOCK, which a program on
                      this machine listens on (no network)
  -- ARGS             passed to QEMU as they are
"""
import argparse
import json
import os
import platform
import queue
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time

HERE = os.path.dirname(os.path.abspath(__file__))
IS_MAC = platform.system() == "Darwin"


def mac_app():
    """Chumby.app's executable, if it is built: $CHUMBY_APP (the .app), or
    frontend/mac/build/Chumby.app beside this script."""
    for app in (os.environ.get("CHUMBY_APP"),
                os.path.join(HERE, "frontend", "mac", "build", "Chumby.app")):
        if app:
            exe = os.path.join(app, "Contents", "MacOS", "Chumby")
            if os.access(exe, os.X_OK):
                return exe
    return None


def exec_mac_app(exe, a, qemu, extra):
    """Runs Chumby.app with these options, in place of this process: it
    starts QEMU and draws its screen itself."""
    args = [exe]
    if a.images:
        args.append(a.images)
    for opt in ("kernel", "nand", "audio", "state", "link", "title"):
        v = getattr(a, opt)
        if v:
            args += ["--" + opt, v]
    args += ["--qemu", qemu]
    if a.write:
        args.append("--write")
    if a.fast:
        args.append("--fast")
    if a.scale:
        args += ["--scale", "%g" % a.scale]
    if extra:
        args += ["--"] + extra
    sys.stdout.flush()
    os.execv(exe, args)


def find_qemu(given):
    if given:
        return given
    for p in (os.path.join(HERE, "qemu-system-arm"),
              os.path.join(HERE, "build", "obj", "qemu-system-arm")):
        if os.access(p, os.X_OK):
            return p
    p = shutil.which("qemu-system-arm")
    if p:
        return p
    sys.exit("chumby-emu: no qemu-system-arm with the chumby-classic machine (--qemu)")


def backends(qemu, what):
    """The display or audio backends QEMU was built with."""
    r = subprocess.run([qemu, what, "help"], capture_output=True, text=True)
    words = r.stdout.replace(",", " ").split()
    return set(words)


def pick_display(qemu, asked):
    if asked:
        return asked
    have = backends(qemu, "-display")
    for d in (["cocoa"] if IS_MAC else ["gtk", "sdl"]):
        if d in have:
            return d
    sys.exit("chumby-emu: this QEMU has no window (" + " ".join(sorted(have)) +
             "); build it with GTK or SDL, or use --display none")


def pick_audio(qemu, asked):
    if asked:
        return asked
    have = backends(qemu, "-audiodev")
    if IS_MAC:
        order = ["coreaudio"]
    else:
        run = os.environ.get("XDG_RUNTIME_DIR", "")
        order = []
        if run and os.path.exists(os.path.join(run, "pipewire-0")):
            order.append("pipewire")
        if os.environ.get("PULSE_SERVER") or (run and os.path.exists(os.path.join(run, "pulse", "native"))):
            order.append("pa")
        order += ["pipewire", "pa", "alsa", "sdl"]
    for a in order:
        if a in have:
            return a
    return "none"


# The saved state's name says which clock it was saved with: a state saved
# with -icount can't be loaded without it, nor the other way round.
SNAPSHOT = {False: "chumby", True: "chumby-fast"}


def find_qemu_img(qemu):
    for p in (os.path.join(os.path.dirname(qemu), "qemu-img"), shutil.which("qemu-img")):
        if p and os.access(p, os.X_OK):
            return p
    sys.exit("chumby-emu: --state needs qemu-img (from your QEMU, or a qemu-utils package)")


def state_overlay(qemu, nand, state):
    """The state directory's qcow2 overlay of NAND, made on first use, and
    whether it holds a saved state to resume from."""
    qimg = find_qemu_img(qemu)
    os.makedirs(state, exist_ok=True)
    overlay = os.path.join(state, "nand.qcow2")
    if not os.path.exists(overlay):
        subprocess.run([qimg, "create", "-q", "-f", "qcow2", "-b", os.path.abspath(nand),
                        "-F", "raw", overlay], check=True)
    snaps = subprocess.run([qimg, "snapshot", "-l", "-U", overlay],
                           capture_output=True, text=True).stdout.split()
    for fast, name in SNAPSHOT.items():
        if name in snaps:
            return overlay, fast
    return overlay, None


# The Chumby Classic's screen: 3.5 inches across, 4:3, so 71.1 mm wide.
CHUMBY_SCREEN_MM = 71.12
CHUMBY_SCREEN_PX = 320


def display_opts(display, scale, have_qt):
    """The -display option: the cursor shown over the window, which can be
    resized keeping its shape, at the given scale or a real Chumby's size."""
    if display not in ("cocoa", "gtk", "sdl"):
        return display
    opts = [display, "show-cursor=on"]
    if display in ("cocoa", "gtk"):
        if scale is None:
            scale = real_size_scale() if have_qt else 2.0
        opts += ["zoom-to-fit=on", "scale=%g" % scale]
    if display == "gtk":
        opts.append("keep-aspect-ratio=on")
    return ",".join(opts)


def real_size_scale():
    """Points per Chumby pixel that make the window a real Chumby's
    screen size, from the desktop's idea of the primary screen; 2 when it
    has none worth believing (a virtual display, a missing EDID)."""
    try:
        import panel_qt
        ppmm = panel_qt.points_per_mm()
    except Exception:
        ppmm = None
    if not ppmm:
        return 2.0
    return round(max(1.0, min(6.0, CHUMBY_SCREEN_MM * ppmm / CHUMBY_SCREEN_PX)), 2)


class QMP:
    """A QMP connection: commands from any thread, events to a queue."""

    def __init__(self, path, events):
        self.s = socket.socket(socket.AF_UNIX)
        for _ in range(200):
            try:
                self.s.connect(path)
                break
            except OSError:
                time.sleep(0.05)
        else:
            raise RuntimeError("QEMU's QMP socket didn't open")
        self.f = self.s.makefile("rw")
        self.f.readline()
        self.lock = threading.Lock()
        self.closed = False
        self.replies = queue.Queue()
        self.events = events
        threading.Thread(target=self._read, daemon=True).start()
        self.cmd("qmp_capabilities")

    def _read(self):
        for line in self.f:
            try:
                msg = json.loads(line)
            except ValueError:
                continue
            if "event" in msg:
                self.events.put(msg)
            else:
                self.replies.put(msg)
        self.closed = True
        self.replies.put(None)
        self.events.put({"event": "QMP_CLOSED"})

    def cmd(self, name, **args):
        with self.lock:
            if self.closed:
                raise RuntimeError("the machine has quit")
            msg = {"execute": name}
            if args:
                msg["arguments"] = args
            self.f.write(json.dumps(msg) + "\n")
            self.f.flush()
            r = self.replies.get(timeout=30)
        if r is None:
            raise RuntimeError("the machine has quit")
        if "error" in r:
            raise RuntimeError(r["error"].get("desc", str(r["error"])))
        return r.get("return")

    def qom_get(self, path, prop):
        return self.cmd("qom-get", path=path, property=prop)

    def qom_set(self, path, prop, value):
        return self.cmd("qom-set", path=path, property=prop, value=value)


def linux_app(a, argv):
    """On Linux, the native app (frontend/linux, built with cargo, or
    chumby-desktop on $PATH) takes over when it is built: one window with
    the screen and the controls. --display, --no-panel or CHUMBY_EMU_QT=1
    keep QEMU's own window and the Qt panel."""
    app = os.path.join(HERE, "frontend", "linux", "target", "release", "chumby-desktop")
    if not os.access(app, os.X_OK):
        app = shutil.which("chumby-desktop")
    if not app:
        return
    if not a.qemu:
        argv = ["--qemu", find_qemu(None)] + argv
    os.execv(app, [app] + argv)


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("images", nargs="?")
    ap.add_argument("--kernel")
    ap.add_argument("--nand")
    ap.add_argument("--qemu")
    ap.add_argument("--display")
    ap.add_argument("--audio")
    ap.add_argument("--write", action="store_true")
    ap.add_argument("--fast", action="store_true")
    ap.add_argument("--state")
    ap.add_argument("--link")
    ap.add_argument("--title")
    ap.add_argument("--no-panel", action="store_true")
    ap.add_argument("--scale", type=float)
    ap.add_argument("-h", "--help", action="store_true")
    argv = sys.argv[1:]
    extra = []
    if "--" in argv:
        i = argv.index("--")
        argv, extra = argv[:i], argv[i + 1:]
    a = ap.parse_args(argv)
    if a.help:
        print(__doc__.strip())
        return 0
    for bad in ("-netdev", "-nic", "-net"):
        if bad in extra or "-" + bad in extra:
            sys.exit(f"chumby-emu: {bad} isn't allowed: the emulated Chumby has no network")
    if (not IS_MAC and not a.no_panel and not a.display
            and not os.environ.get("CHUMBY_EMU_QT")):
        linux_app(a, sys.argv[1:])
    kernel = a.kernel or (a.images and os.path.join(a.images, "zImage"))
    nand = a.nand or (a.images and os.path.join(a.images, "nand.img"))
    if not kernel:
        print(__doc__.strip(), file=sys.stderr)
        return 2

    qemu = find_qemu(a.qemu)
    if (IS_MAC and not a.no_panel and not a.display
            and not os.environ.get("CHUMBY_EMU_QT")):
        exe = mac_app()
        if exe:
            exec_mac_app(exe, a, os.path.abspath(qemu) if os.sep in qemu else qemu, extra)
    display = pick_display(qemu, a.display)
    audio = pick_audio(qemu, a.audio)

    tmp = tempfile.mkdtemp(prefix="chumby-")
    qmp_path = os.path.join(tmp, "qmp")
    con_path = os.path.join(tmp, "con")
    machine = "chumby-classic"
    import chumby_machine  # beside this script
    title = a.title or chumby_machine.title(kernel, a.images, linked=bool(a.link))
    args = [qemu, "-name", chumby_machine.qemu_name(title), "-kernel", kernel,
            "-qmp", f"unix:{qmp_path},server=on,wait=off",
            "-serial", f"unix:{con_path},server=on,wait=off",
            "-monitor", "none", "-nic", "none",
            "-display", display_opts(display, a.scale, not a.no_panel)]
    if nand and a.state:
        overlay, saved_fast = state_overlay(qemu, nand, a.state)
        args += ["-drive", f"if=mtd,file={overlay},format=qcow2"]
        if saved_fast is not None:
            if saved_fast != a.fast:
                print("chumby-emu: resuming the saved state " +
                      ("with" if saved_fast else "without") +
                      " --fast, as it was saved", file=sys.stderr)
                a.fast = saved_fast
            args += ["-loadvm", SNAPSHOT[a.fast]]
    elif nand:
        args += ["-drive", f"if=mtd,file={nand},format=raw" + ("" if a.write else ",snapshot=on")]
    if audio != "none":
        if audio.startswith("wav:"):
            args += ["-audiodev", f"wav,id=snd0,path={audio[4:]}"]
        else:
            args += ["-audiodev", f"{audio},id=snd0"]
        if "audiodev" in subprocess.run([qemu, "-M", f"{machine},help"],
                                        capture_output=True, text=True).stdout:
            machine += ",audiodev=snd0"
    if a.fast:
        args += ["-icount", "shift=auto,sleep=off"]
    if a.link:
        if "," in a.link:
            sys.exit("chumby-emu: --link: a path without commas")
        # The second -serial, after the console: UART2.
        args += ["-chardev", f"socket,id=link,path={os.path.abspath(a.link)},server=off,reconnect-ms=1000",
                 "-serial", "chardev:link"]
    args = args[:1] + ["-M", machine] + args[1:] + extra

    print("chumby-emu:", " ".join(args), flush=True)
    proc = subprocess.Popen(args)
    try:
        if a.no_panel:
            return proc.wait()
        events = queue.Queue()
        try:
            qmp = QMP(qmp_path, events)
        except RuntimeError as e:
            print("chumby-emu:", e, file=sys.stderr)
            return proc.wait() or 1
        import panel_qt  # frontend/, beside this script
        panel_qt.run(qmp, events, con_path, proc, display=display, audio=audio,
                     snapshot=SNAPSHOT[a.fast], other=SNAPSHOT[not a.fast], title=title)
        return proc.wait()
    finally:
        if proc.poll() is None:
            proc.terminate()
            try:
                proc.wait(5)
            except subprocess.TimeoutExpired:
                proc.kill()
        shutil.rmtree(tmp, ignore_errors=True)


if __name__ == "__main__":
    sys.path.insert(0, os.path.join(HERE, "frontend"))
    sys.exit(main())
